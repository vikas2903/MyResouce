        .suddati-home-timer .timer-label {
            font-size: 9px;
            letter-spacing: 0.08em;
        }
    }
</style>

<div class="suddati-home-timer" data-ist-countdown>
    <div class="timer-bar">
        <p class="timer-text">Unlocking in:</p>
        <div class="timer-values" aria-label="Countdown timer">
            <span class="timer-unit">
                <span class="timer-box" data-hour>00</span>
                <span class="timer-label">HRS</span>
            </span>
            <span class="timer-separator">:</span>
            <span class="timer-unit">
                <span class="timer-box" data-minute>00</span>
                <span class="timer-label">MIN</span>
            </span>
            <span class="timer-separator">:</span>
            <span class="timer-unit">
                <span class="timer-box" data-second>00</span>
                <span class="timer-label">SEC</span>
            </span>
        </div>
    </div>
</div>
{% endif %}

<script>
    (function () {
        function updateCountdown(widget) {
            const hourEl = widget.querySelector('[data-hour]');
            const minuteEl = widget.querySelector('[data-minute]');
            const secondEl = widget.querySelector('[data-second]');

            if (!hourEl || !minuteEl || !secondEl) {
                return;
            }

            const now = new Date();
            const nowIST = new Date(now.toLocaleString('en-US', { timeZone: 'Asia/Kolkata' }));
            const nextMidnightIST = new Date(nowIST);
            nextMidnightIST.setHours(24, 0, 0, 0);

            const diff = nextMidnightIST.getTime() - nowIST.getTime();

            if (diff <= 0) {
                hourEl.textContent = '00';
                minuteEl.textContent = '00';
                secondEl.textContent = '00';
                return;
            }

            const hours = Math.floor(diff / (1000 * 60 * 60));
            const minutes = Math.floor((diff / (1000 * 60)) % 60);
            const seconds = Math.floor((diff / 1000) % 60);

            hourEl.textContent = String(hours).padStart(2, '0');
            minuteEl.textContent = String(minutes).padStart(2, '0');
            secondEl.textContent = String(seconds).padStart(2, '0');
        }

        function initCountdown(widget) {
            if (!widget || widget.dataset.countdownReady === 'true') {
                return;
            }

            widget.dataset.countdownReady = 'true';
            updateCountdown(widget);

            const timerId = window.setInterval(function () {
                if (!document.body.contains(widget)) {
                    window.clearInterval(timerId);
                    return;
                }

                updateCountdown(widget);
            }, 1000);

            widget._countdownTimerId = timerId;
        }

        function initAllCountdowns(root) {
            const scope = root && root.querySelectorAll ? root : document;
            scope.querySelectorAll('[data-ist-countdown]').forEach(initCountdown);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
                initAllCountdowns(document);
            });
        } else {
            initAllCountdowns(document);
        }

        const observer = new MutationObserver(function (mutations) {
            mutations.forEach(function (mutation) {
                mutation.addedNodes.forEach(function (node) {
                    if (node.nodeType !== 1) {
                        return;
                    }

                    if (node.matches && node.matches('[data-ist-countdown]')) {
                        initCountdown(node);
                    } else {
                        initAllCountdowns(node);
                    }
                });
            });
        });

        observer.observe(document.documentElement, { childList: true, subtree: true });
    })();
</script>
