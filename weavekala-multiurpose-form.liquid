<script>
  (function () {
    const root = document.getElementById('{{ cs_id }}');

    if (!root || root.dataset.initialized === 'true') {
      return;
    }

    root.dataset.initialized = 'true';

    const stepButtons = root.querySelectorAll(
      '[data-step-target]'
    );

    const panels = root.querySelectorAll(
      '[data-step-panel]'
    );

    const sizeButtons = root.querySelectorAll(
      '[data-size]'
    );

    const heightButtons = root.querySelectorAll(
      '[data-height]'
    );

    const goStepButtons = root.querySelectorAll(
      '[data-go-step]'
    );

    const sizeSummaryElements = root.querySelectorAll(
      '[data-size-summary]'
    );

    const reviewSize = root.querySelector(
      '[data-review-size]'
    );

    const reviewHeight = root.querySelector(
      '[data-review-height]'
    );

    const checkoutButton = root.querySelector(
      '[data-stitching-checkout]'
    );

    const checkoutButtonText = root.querySelector(
      '.cs-checkout-button__text'
    );

    const errorBox = root.querySelector(
      '[data-stitching-error]'
    );

    let selectedSize = '';
    let selectedHeight = '';
    let activeStep = 1;

    function findProductForm() {
      const closestForm = root.closest(
        'form[action*="/cart/add"]'
      );

      if (closestForm) {
        return closestForm;
      }

      const productContainer = root.closest(
        'product-info, product-form, .product, .product__info-container, .shopify-section'
      );

      if (productContainer) {
        const containerForm = productContainer.querySelector(
          'form[action*="/cart/add"]'
        );

        if (containerForm) {
          return containerForm;
        }
      }

      return (
        document.querySelector(
          'product-form form[action*="/cart/add"]'
        ) ||
        document.querySelector(
          'form[action*="/cart/add"]'
        )
      );
    }

    function getOrCreatePropertyInput(propertyName) {
      const productForm = findProductForm();

      if (!productForm) {
        return null;
      }

      let input = Array.from(
        productForm.elements
      ).find(function (element) {
        return element.name === propertyName;
      });

      if (!input) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = propertyName;
        productForm.appendChild(input);
      }

      return input;
    }

    function saveProperty(propertyName, value) {
      const input = getOrCreatePropertyInput(
        propertyName
      );

      if (input) {
        input.value = value;
      }
    }

    function getMaximumAllowedStep() {
      if (selectedSize && selectedHeight) {
        return 3;
      }

      if (selectedSize) {
        return 2;
      }

      return 1;
    }

    function updateStepUI() {
      const maximumStep = getMaximumAllowedStep();

      stepButtons.forEach(function (button) {
        const buttonStep = Number(
          button.dataset.stepTarget
        );

        button.classList.remove(
          'is-active',
          'is-complete'
        );

        if (buttonStep === activeStep) {
          button.classList.add('is-active');
        }

        if (buttonStep < activeStep) {
          button.classList.add('is-complete');
        }

        button.disabled = buttonStep > maximumStep;
      });

      panels.forEach(function (panel) {
        const panelStep = Number(
          panel.dataset.stepPanel
        );

        const isCurrentPanel =
          panelStep === activeStep;

        panel.hidden = !isCurrentPanel;

        panel.classList.toggle(
          'is-active',
          isCurrentPanel
        );
      });

      sizeSummaryElements.forEach(function (element) {
        element.textContent =
          selectedSize || 'Not selected';
      });

      if (reviewSize) {
        reviewSize.textContent =
          selectedSize || '-';
      }

      if (reviewHeight) {
        reviewHeight.textContent =
          selectedHeight || '-';
      }
    }

    function goToStep(step) {
      const maximumStep = getMaximumAllowedStep();

      if (step < 1 || step > maximumStep) {
        return;
      }

      activeStep = step;
      updateStepUI();

      const activePanel = root.querySelector(
        '[data-step-panel="' + step + '"]'
      );

      if (activePanel) {
        activePanel.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest'
        });
      }
    }

    function clearError() {
      if (!errorBox) {
        return;
      }

      errorBox.textContent = '';
      errorBox.hidden = true;
    }

    function showError(message) {
      if (!errorBox) {
        return;
      }

      errorBox.textContent = message;
      errorBox.hidden = false;
    }

    function resetCheckoutButton() {
      if (checkoutButton) {
        checkoutButton.disabled = false;
      }

      if (checkoutButtonText) {
        checkoutButtonText.textContent =
          'Add Stitching Details & Checkout';
      }
    }

    sizeButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        clearError();

        selectedSize =
          button.dataset.size || '';

        sizeButtons.forEach(function (item) {
          const isSelected = item === button;

          item.classList.toggle(
            'is-selected',
            isSelected
          );

          item.setAttribute(
            'aria-pressed',
            isSelected ? 'true' : 'false'
          );
        });

        saveProperty(
          'properties[Stitching Size]',
          selectedSize
        );

        activeStep = 2;
        updateStepUI();
      });
    });

    heightButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        clearError();

        selectedHeight =
          button.dataset.height || '';

        heightButtons.forEach(function (item) {
          const isSelected = item === button;

          item.classList.toggle(
            'is-selected',
            isSelected
          );

          item.setAttribute(
            'aria-pressed',
            isSelected ? 'true' : 'false'
          );
        });

        saveProperty(
          'properties[Stitching Height]',
          selectedHeight
        );

        activeStep = 3;
        updateStepUI();
      });
    });

    stepButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        goToStep(
          Number(button.dataset.stepTarget)
        );
      });
    });

    goStepButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        goToStep(
          Number(button.dataset.goStep)
        );
      });
    });

    if (checkoutButton) {
      checkoutButton.addEventListener(
        'click',
        async function () {
          clearError();

          if (!selectedSize) {
            activeStep = 1;
            updateStepUI();

            showError(
              'Please select your stitching size.'
            );

            return;
          }

          if (!selectedHeight) {
            activeStep = 2;
            updateStepUI();

            showError(
              'Please select your height.'
            );

            return;
          }

          const productForm = findProductForm();

          if (!productForm) {
            showError(
              'Product form was not found. Please place this code inside the product section.'
            );

            return;
          }

          const variantField = productForm.querySelector(
            '[name="id"]'
          );

          if (
            !variantField ||
            !variantField.value
          ) {
            showError(
              'Please select an available product variant before checkout.'
            );

            return;
          }

          checkoutButton.disabled = true;

          if (checkoutButtonText) {
            checkoutButtonText.textContent =
              'Adding details...';
          }

          try {
            const formData = new FormData(
              productForm
            );

            formData.set(
              'id',
              variantField.value
            );

            formData.set(
              'quantity',
              formData.get('quantity') || '1'
            );

            formData.set(
              'properties[Stitching Size]',
              selectedSize
            );

            formData.set(
              'properties[Stitching Height]',
              selectedHeight
            );

            const rootUrl =
              root.dataset.rootUrl || '/';

            const normalizedRootUrl =
              rootUrl.endsWith('/')
                ? rootUrl
                : rootUrl + '/';

            const response = await fetch(
              normalizedRootUrl + 'cart/add.js',
              {
                method: 'POST',
                headers: {
                  Accept: 'application/json',
                  'X-Requested-With':
                    'XMLHttpRequest'
                },
                body: formData
              }
            );

            let result = {};

            try {
              result = await response.json();
            } catch (jsonError) {
              result = {};
            }

            if (!response.ok) {
              throw new Error(
                result.description ||
                result.message ||
                'Unable to add the product to cart.'
              );
            }

            window.location.href =
              normalizedRootUrl + 'checkout';
          } catch (error) {
            showError(
              error.message ||
              'Something went wrong. Please try again.'
            );

            resetCheckoutButton();
          }
        }
      );
    }

    updateStepUI();
  })();
</script>
