{% comment %}
  Weavekala Custom Stitching Flow

  Step 1: Select Size
  Step 2: Select Height
  Step 3: Review Stitching Services and Checkout

  Place this code inside the product section.
  It can be added below the Buy Now button.
{% endcomment %}

{% assign cs_heights = "5'0|5'1|5'2|5'3|5'4|5'5|5'6|5'7|5'8|5'9|5'10|5'11|6'0" | split: "|" %}
{% assign cs_sizes = "XS,S,M,L,XL,XXL" | split: "," %}
{% assign cs_id = 'custom-stitching-' | append: section.id | append: '-' | append: product.id %}

<div
  id="{{ cs_id }}"
  class="cs-stitching"
  data-custom-stitching
  data-root-url="{{ routes.root_url }}"
>
  <div class="cs-stitching__header">
    <div class="cs-stitching__title-row">
      <h3 class="cs-stitching__title">
        Custom Stitching
      </h3>

      <span class="cs-stitching__badge">
        ✦ Easy 3-Step Process
      </span>
    </div>

    <p class="cs-stitching__subtitle">
      Select your size and height for a comfortable, well-tailored fit.
    </p>
  </div>

  <div
    class="cs-stepper"
    aria-label="Custom stitching steps"
  >
    <button
      type="button"
      class="cs-step is-active"
      data-step-target="1"
    >
      <span class="cs-step__number">1</span>
      <span class="cs-step__label">Select Your Size</span>
    </button>

    <span class="cs-stepper__line"></span>

    <button
      type="button"
      class="cs-step"
      data-step-target="2"
      disabled
    >
      <span class="cs-step__number">2</span>
      <span class="cs-step__label">Select Your Height</span>
    </button>

    <span class="cs-stepper__line"></span>

    <button
      type="button"
      class="cs-step"
      data-step-target="3"
      disabled
    >
      <span class="cs-step__number">3</span>
      <span class="cs-step__label">Review &amp; Checkout</span>
    </button>
  </div>

  <div class="cs-stitching__content">

    {% comment %}
      STEP 1: SIZE
    {% endcomment %}

    <div
      class="cs-panel is-active"
      data-step-panel="1"
    >
      <div class="cs-panel__top">
        <div class="cs-panel__icon">
          S
        </div>

        <div class="cs-panel__heading">
          <span class="cs-panel__step">
            Step 1
          </span>

          <h4>Select Your Size</h4>

          <p>
            Choose your regular clothing size.
          </p>
        </div>
      </div>

      <div class="cs-options cs-options--size">
        {% for size in cs_sizes %}
          <button
            type="button"
            class="cs-option"
            data-size="{{ size | escape }}"
            aria-pressed="false"
          >
            {{ size }}
          </button>
        {% endfor %}
      </div>

      <p class="cs-panel__help">
        Your selected size will be saved with this product.
      </p>
    </div>

    {% comment %}
      STEP 2: HEIGHT
    {% endcomment %}

    <div
      class="cs-panel"
      data-step-panel="2"
      hidden
    >
      <div class="cs-panel__top">
        <div class="cs-panel__icon">
          ↕
        </div>

        <div class="cs-panel__heading">
          <span class="cs-panel__step">
            Step 2
          </span>

          <h4>Select Your Height</h4>

          <p>
            Selected size:
            <strong data-size-summary>
              Not selected
            </strong>
          </p>
        </div>

        <button
          type="button"
          class="cs-change-button"
          data-go-step="1"
        >
          Change
        </button>
      </div>

      <div class="cs-options cs-options--height">
        {% for height in cs_heights %}
          <button
            type="button"
            class="cs-option"
            data-height="{{ height | escape }}&quot;"
            aria-pressed="false"
          >
            {{ height }}&quot;
          </button>
        {% endfor %}
      </div>

      <div class="cs-info-box">
        <span class="cs-info-box__icon">
          i
        </span>

        <p>
          Your size and height will be added to the product as stitching details.
        </p>
      </div>
    </div>

    {% comment %}
      STEP 3: REVIEW AND SERVICES
    {% endcomment %}

    <div
      class="cs-panel"
      data-step-panel="3"
      hidden
    >
      <div class="cs-panel__top">
        <div class="cs-panel__icon">
          ✓
        </div>

        <div class="cs-panel__heading">
          <span class="cs-panel__step">
            Step 3
          </span>

          <h4>Review Your Stitching Details</h4>

          <p>
            Confirm your selections and review our stitching services.
          </p>
        </div>
      </div>

      <div class="cs-summary">
        <div class="cs-summary__item">
          <span>
            Selected Size
          </span>

          <strong data-review-size>
            -
          </strong>

          <button
            type="button"
            data-go-step="1"
          >
            Change
          </button>
        </div>

        <div class="cs-summary__item">
          <span>
            Selected Height
          </span>

          <strong data-review-height>
            -
          </strong>

          <button
            type="button"
            data-go-step="2"
          >
            Change
          </button>
        </div>
      </div>

      <div class="cs-services">
        <div class="cs-services__header">
          <span class="cs-services__eyebrow">
            Stitching Information
          </span>

          <h5>
            Weavekala Stitching Services
          </h5>

          <p>
            The prices below are applicable for basic stitching.
          </p>
        </div>

        <div class="cs-services__pricing">
          <div class="cs-service-card">
            <div class="cs-service-card__heading">
              <span class="cs-service-card__icon">
                ✨
              </span>

              <h6>
                Kurta Stitching
              </h6>
            </div>

            <div class="cs-service-card__rows">
              <div class="cs-service-price">
                <div class="cs-service-price__details">
                  <strong>
                    Plain Kurta
                  </strong>

                  <span>
                    Without lining
                  </span>
                </div>

                <b>
                  ₹799
                </b>
              </div>

              <div class="cs-service-price">
                <div class="cs-service-price__details">
                  <strong>
                    Plain Kurta
                  </strong>

                  <span>
                    With lining
                  </span>
                </div>

                <b>
                  ₹999
                </b>
              </div>
            </div>
          </div>

          <div class="cs-service-card">
            <div class="cs-service-card__heading">
              <span class="cs-service-card__icon">
                ✨
              </span>

              <h6>
                Suit Stitching
              </h6>
            </div>

            <div class="cs-service-card__rows">
              <div class="cs-service-price">
                <div class="cs-service-price__details">
                  <strong>
                    Plain Suit
                  </strong>

                  <span>
                    Top and bottom without lining
                  </span>
                </div>

                <b>
                  ₹1,199
                </b>
              </div>

              <div class="cs-service-price">
                <div class="cs-service-price__details">
                  <strong>
                    Partial Lining Suit
                  </strong>

                  <span>
                    Top lined, bottom without lining
                  </span>
                </div>

                <b>
                  ₹1,599
                </b>
              </div>

              <div class="cs-service-price">
                <div class="cs-service-price__details">
                  <strong>
                    Full Lining Plain Suit
                  </strong>

                  <span>
                    Top and bottom with lining
                  </span>
                </div>

                <b>
                  ₹1,999
                </b>
              </div>
            </div>
          </div>
        </div>

        <div class="cs-services__additional">
          <div class="cs-services__section-title">
            <span>
              +
            </span>

            <h6>
              Additional Charges
            </h6>
          </div>

          <p>
            Extra detailing or customization such as designer necklines,
            buttons, piping, tassels, lace work, pockets, special sleeves,
            or custom design requests will be charged additionally.
          </p>
        </div>

        <div class="cs-promise">
          <div class="cs-services__section-title">
            <span>
              ✓
            </span>

            <h6>
              Our Stitching Promise
            </h6>
          </div>

          <div class="cs-promise__grid">
            <div class="cs-promise__item">
              <span>✓</span>

              <p>
                Double stitching for durability
              </p>
            </div>

            <div class="cs-promise__item">
              <span>✓</span>

              <p>
                Interlock finishing for a neat look
              </p>
            </div>

            <div class="cs-promise__item">
              <span>✓</span>

              <p>
                2-inch margin on both sides for future alterations
              </p>
            </div>

            <div class="cs-promise__item">
              <span>✓</span>

              <p>
                Clean and premium finishing
              </p>
            </div>

            <div class="cs-promise__item">
              <span>✓</span>

              <p>
                Comfortable and well-tailored fit
              </p>
            </div>
          </div>
        </div>

        <div class="cs-services__notice">
          <span class="cs-services__notice-icon">
            i
          </span>

          <p>
            Prices are for basic stitching. Any customization charges will
            be discussed with you before starting the work.
          </p>
        </div>
      </div>

      <button
        type="button"
        class="cs-checkout-button"
        data-stitching-checkout
      >
        <span class="cs-checkout-button__text">
          Add Stitching Details &amp; Checkout
        </span>

        <span class="cs-checkout-button__arrow">
          →
        </span>
      </button>

      <div class="cs-confirmation-row">
        <span>
          ✓ Size saved
        </span>

        <span>
          ✓ Height saved
        </span>

        <span>
          ✓ Added with main product
        </span>
      </div>

      <div
        class="cs-error-message"
        data-stitching-error
        hidden
      ></div>
    </div>
  </div>

  <div class="cs-size-guide">
    <span>
      Need help choosing?
    </span>

    <a href="/pages/size-guide">
      View size guide →
    </a>
  </div>
</div>

<style>
  .cs-stitching {
    --cs-primary: #9b0d15;
    --cs-primary-light: #fff3f4;
    --cs-border: #ead8da;
    --cs-text: #202020;
    --cs-muted: #6d6d6d;
    --cs-success: #27763b;

    margin-top: 22px;
    padding: 22px;
    border: 1px solid var(--cs-border);
    border-radius: 16px;
    background: #fff6f5;
    box-shadow: 0 8px 30px rgba(40, 10, 12, 0.06);
  }

  .cs-stitching *,
  .cs-stitching *::before,
  .cs-stitching *::after {
    box-sizing: border-box;
  }

  .cs-stitching button,
  .cs-stitching input,
  .cs-stitching a {
    font-family: inherit;
  }

  .cs-stitching__title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .cs-stitching__title {
    margin: 0;
    color: var(--cs-text);
    font-size: 27px;
    font-weight: 700;
    line-height: 1.15;
  }

  .cs-stitching__badge {
    display: inline-flex;
    align-items: center;
    padding: 7px 11px;
    border-radius: 999px;
    background: var(--cs-primary-light);
    color: var(--cs-primary);
    font-size: 12px;
    font-weight: 700;
  }

  .cs-stitching__subtitle {
    margin: 9px 0 0;
    color: var(--cs-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .cs-stepper {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 25px 0 22px;
  }

  .cs-step {
    appearance: none;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #9b9b9b;
    cursor: pointer;
    text-align: left;
  }

  .cs-step:disabled {
    cursor: not-allowed;
  }

  .cs-step__number {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 32px;
    border: 1px solid #d7d7d7;
    border-radius: 50%;
    font-size: 14px;
    font-weight: 700;
  }

  .cs-step__label {
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .cs-step.is-active,
  .cs-step.is-complete {
    color: var(--cs-primary);
  }

  .cs-step.is-active .cs-step__number,
  .cs-step.is-complete .cs-step__number {
    border-color: var(--cs-primary);
    background: var(--cs-primary);
    color: #fff;
  }

  .cs-step.is-complete .cs-step__number {
    font-size: 0;
  }

  .cs-step.is-complete .cs-step__number::before {
    content: "✓";
    font-size: 15px;
  }

  .cs-stepper__line {
    width: 28px;
    height: 2px;
    flex-shrink: 0;
    background: #dedede;
  }

  .cs-panel {
    padding: 22px;
    border: 1px solid var(--cs-border);
    border-radius: 14px;
    background: #fff;
  }

  .cs-panel[hidden] {
    display: none !important;
  }

  .cs-panel.is-active {
    border-color: rgba(155, 13, 21, 0.35);
    background: linear-gradient(
      180deg,
      #fff 0%,
      #fffafa 100%
    );
  }

  .cs-panel__top {
    display: flex;
    align-items: flex-start;
    gap: 13px;
  }

  .cs-panel__heading {
    flex: 1;
    min-width: 0;
  }

  .cs-panel__icon {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 42px;
    border-radius: 50%;
    background: var(--cs-primary-light);
    color: var(--cs-primary);
    font-size: 18px;
    font-weight: 800;
  }

  .cs-panel__step {
    display: block;
    margin-bottom: 3px;
    color: var(--cs-primary);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cs-panel h4 {
    margin: 0;
    color: var(--cs-text);
    font-size: 20px;
    line-height: 1.2;
  }

  .cs-panel p {
    margin: 5px 0 0;
    color: var(--cs-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .cs-change-button {
    margin-left: auto;
    padding: 7px 0;
    border: 0;
    background: transparent;
    color: var(--cs-primary);
    font-size: 13px;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }

  .cs-options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .cs-option {
    position: relative;
    min-width: 74px;
    min-height: 46px;
    padding: 10px 14px;
    border: 1px solid #d8d8d8;
    border-radius: 9px;
    background: #fff;
    color: var(--cs-text);
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .cs-option:hover {
    border-color: var(--cs-primary);
    color: var(--cs-primary);
    transform: translateY(-1px);
  }

  .cs-option.is-selected {
    border-color: var(--cs-primary);
    background: var(--cs-primary);
    color: #fff;
  }

  .cs-option.is-selected::after {
    content: "✓";
    position: absolute;
    top: -7px;
    right: -7px;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--cs-primary);
    color: #fff;
    font-size: 11px;
  }

  .cs-panel__help {
    margin-top: 17px !important;
    font-size: 12px !important;
  }

  .cs-info-box {
    display: flex;
    gap: 10px;
    margin-top: 20px;
    padding: 14px;
    border: 1px solid #ebebeb;
    border-radius: 10px;
    background: #fff;
  }

  .cs-info-box__icon {
    width: 21px;
    height: 21px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 21px;
    border: 1px solid var(--cs-primary);
    border-radius: 50%;
    color: var(--cs-primary);
    font-size: 12px;
    font-weight: 700;
  }

  .cs-info-box p {
    margin: 0;
    font-size: 13px;
  }

  .cs-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 22px 0;
  }

  .cs-summary__item {
    position: relative;
    padding: 15px;
    border: 1px solid #ead8da;
    border-radius: 10px;
    background: #fff;
  }

  .cs-summary__item > span {
    display: block;
    color: var(--cs-muted);
    font-size: 12px;
  }

  .cs-summary__item strong {
    display: block;
    margin-top: 5px;
    padding-right: 55px;
    color: var(--cs-text);
    font-size: 18px;
  }

  .cs-summary__item button {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--cs-primary);
    font-size: 12px;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }

  .cs-services {
    margin-bottom: 22px;
    overflow: hidden;
    border: 1px solid var(--cs-border);
    border-radius: 14px;
    background: #fff;
  }

  .cs-services__header {
    padding: 20px;
    border-bottom: 1px solid var(--cs-border);
    background: linear-gradient(
      135deg,
      var(--cs-primary-light) 0%,
      #fff 100%
    );
  }

  .cs-services__eyebrow {
    display: block;
    margin-bottom: 5px;
    color: var(--cs-primary);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cs-services__header h5 {
    margin: 0;
    color: var(--cs-text);
    font-size: 21px;
    font-weight: 750;
    line-height: 1.25;
  }

  .cs-services__header p {
    margin: 7px 0 0;
    color: var(--cs-muted);
    font-size: 13px;
    line-height: 1.55;
  }

  .cs-services__pricing {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    padding: 18px;
  }

  .cs-service-card {
    padding: 17px;
    border: 1px solid #ead8da;
    border-radius: 12px;
    background: #fffafa;
  }

  .cs-service-card__heading {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f0dfe1;
  }

  .cs-service-card__icon {
    font-size: 16px;
    line-height: 1;
  }

  .cs-service-card h6,
  .cs-services__section-title h6 {
    margin: 0;
    color: var(--cs-text);
    font-size: 16px;
    font-weight: 750;
    line-height: 1.3;
  }

  .cs-service-card__rows {
    display: grid;
  }

  .cs-service-price {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 13px 0;
    border-bottom: 1px solid #f0e5e6;
  }

  .cs-service-price:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .cs-service-price__details {
    min-width: 0;
  }

  .cs-service-price strong {
    display: block;
    color: var(--cs-text);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.35;
  }

  .cs-service-price span {
    display: block;
    margin-top: 3px;
    color: var(--cs-muted);
    font-size: 12px;
    line-height: 1.4;
  }

  .cs-service-price b {
    flex-shrink: 0;
    color: var(--cs-primary);
    font-size: 16px;
    font-weight: 800;
    white-space: nowrap;
  }

  .cs-services__additional,
  .cs-promise {
    margin: 0 18px 18px;
    padding: 17px;
    border-radius: 12px;
  }

  .cs-services__additional {
    border: 1px solid #f1dfc1;
    background: #fffaf0;
  }

  .cs-promise {
    border: 1px solid #dce9df;
    background: #f7fcf8;
  }

  .cs-services__section-title {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cs-services__section-title > span {
    width: 25px;
    height: 25px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 25px;
    border-radius: 50%;
    background: var(--cs-primary);
    color: #fff;
    font-size: 13px;
    font-weight: 800;
  }

  .cs-services__additional p {
    margin: 10px 0 0;
    color: var(--cs-muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .cs-promise__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 18px;
    margin-top: 14px;
  }

  .cs-promise__item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .cs-promise__item > span {
    margin-top: 1px;
    color: var(--cs-success);
    font-size: 13px;
    font-weight: 800;
  }

  .cs-promise__item p {
    margin: 0;
    color: var(--cs-text);
    font-size: 13px;
    line-height: 1.5;
  }

  .cs-services__notice {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0 18px 18px;
    padding: 13px 14px;
    border: 1px solid var(--cs-border);
    border-radius: 10px;
    background: var(--cs-primary-light);
  }

  .cs-services__notice-icon {
    width: 21px;
    height: 21px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 21px;
    border: 1px solid var(--cs-primary);
    border-radius: 50%;
    color: var(--cs-primary);
    font-size: 12px;
    font-weight: 800;
  }

  .cs-services__notice p {
    margin: 0;
