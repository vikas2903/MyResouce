{%- comment -%}
  Frequently Bought Together Bundle

  Fixes included:
  - Initial product images display correctly
  - Uses modern image_url syntax
  - Variant images update when dropdown changes
  - Falls back to product featured image
  - Selects first available variant
  - Fixes bundlePrice JavaScript conflict
  - Hides optional rows and connectors correctly
  - Supports Dawn cart drawer and cart notification
{%- endcomment -%}

{%- assign foundation_product = nil -%}

{%- if product.handle == 'cmc-skin-tint' -%}
  {%- assign foundation_product = product -%}
{%- endif -%}

{%- comment -%} Compact two-option FBT picker for the current product page. {%- endcomment -%}
{%- if product.handle == 'cmc-skin-tint' or product.handle == 'p-skin-tint' -%}
  {%- assign atplp_main = product -%}
  {%- assign atplp_one = all_products['cmc-kiss-drip-lip-gloss'] -%}
  {%- assign atplp_two = all_products['cmc-flattering-nude-lipstick'] -%}
  {%- if atplp_one != blank and atplp_two != blank -%}
    {%- assign atplp_id = 'atplp-fbt-' | append: section.id | append: '-' | append: product.id -%}
    {%- assign atplp_palette = '#f3d9be,#efc99f,#dda66f,#b88350,#9d6a36,#70461f,#3e2816' | split: ',' -%}
    <style>
      #{{ atplp_id }} { max-width:526px; margin:20px auto; border:1px solid #e5e2df; border-radius:0 0 22px 22px; overflow:hidden; background:#fff; color:#222; font-family:inherit; }
      #{{ atplp_id }} * { box-sizing:border-box; }
      #{{ atplp_id }} .atplp-choice { position:relative; display:block; min-height:86px; margin:18px 24px 0; padding:17px 76px 16px 55px; border:1px solid #d5d5d5; border-radius:14px; cursor:pointer; }
      #{{ atplp_id }} .atplp-choice.is-active { border-color:#a66b38; background:#fffdfa; }
      #{{ atplp_id }} .atplp-choice input { position:absolute; opacity:0; pointer-events:none; }
      #{{ atplp_id }} .atplp-choice:before { position:absolute; top:31px; left:18px; width:18px; height:18px; border:2px solid #b4b4b4; border-radius:50%; content:''; }
      #{{ atplp_id }} .atplp-choice.is-active:after { position:absolute; top:36px; left:23px; width:9px; height:9px; border-radius:50%; background:#a66b38; content:''; }
      #{{ atplp_id }} .atplp-choice strong { display:block; font-size:16px; line-height:20px; }
      #{{ atplp_id }} .atplp-choice small { display:block; margin-top:3px; color:#858585; font-size:14px; }
      #{{ atplp_id }} .atplp-badge { display:inline-block; margin-left:7px; padding:2px 9px; border-radius:12px; background:#a66b38; color:#fff; font-size:11px; letter-spacing:.04em; vertical-align:2px; }
      #{{ atplp_id }} .atplp-discount { position:absolute; top:31px; right:17px; color:#a66b38; font-size:18px; font-weight:700; }
      #{{ atplp_id }} .atplp-picker { margin:14px 24px 0; padding:20px 16px; border:1px dashed #dfbd9e; border-radius:14px; }
      #{{ atplp_id }} .atplp-picker[hidden] { display:none; }
      #{{ atplp_id }} .atplp-picker h4 { margin:0 0 12px; font-size:16px; }
      #{{ atplp_id }} .atplp-product-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
      #{{ atplp_id }} .atplp-product { position:relative; padding:10px; border:1px solid #dfdfdf; border-radius:13px; background:#fff; }
      #{{ atplp_id }} .atplp-product.is-picked { border-color:#a66b38; box-shadow:0 0 0 1px #a66b38 inset; }
      #{{ atplp_id }} .atplp-product img { display:block; width:100%; aspect-ratio:1; object-fit:contain; border-radius:8px; background:#f7f4f1; }
      #{{ atplp_id }} .atplp-product b { display:block; min-height:36px; margin-top:8px; font-size:13px; line-height:17px; }
      #{{ atplp_id }} .atplp-product span { display:block; margin-top:3px; color:#777; font-size:13px; }
      #{{ atplp_id }} .atplp-product select { display:none; }
      #{{ atplp_id }} .atplp-shade-title { display:block; margin-top:10px; color:#7c6f66; font-size:11px; font-weight:700; letter-spacing:.12em; }
      #{{ atplp_id }} .atplp-swatches { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
      #{{ atplp_id }} .atplp-swatch { width:32px; height:32px; padding:0; border:1px solid #ddd; border-radius:50%; background:var(--atplp-swatch); cursor:pointer; text-indent:-9999px; overflow:hidden; }
      #{{ atplp_id }} .atplp-swatch.is-selected { outline:2px solid #a66b38; outline-offset:2px; }
      #{{ atplp_id }} .atplp-swatch:disabled { opacity:.35; cursor:not-allowed; }
      #{{ atplp_id }} .atplp-summary { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:22px; padding:17px 24px; border-top:1px solid #e7e7e7; }
      #{{ atplp_id }} .atplp-price strong { display:block; font-size:24px; }
      #{{ atplp_id }} .atplp-price small { display:block; margin-top:3px; color:#177246; font-weight:700; }
      #{{ atplp_id }} .atplp-add { min-width:190px; border:0; border-radius:13px; padding:17px 14px; background:#c8c7c5; color:#fff; font:inherit; font-size:16px; font-weight:700; cursor:pointer; }
      #{{ atplp_id }} .atplp-add:disabled { cursor:wait; opacity:.7; }
      #{{ atplp_id }} .atplp-status { min-height:20px; padding:0 24px 16px; color:#a33; font-size:13px; }
      @media(max-width:540px) { #{{ atplp_id }} .atplp-choice, #{{ atplp_id }} .atplp-picker { margin-left:14px; margin-right:14px; } #{{ atplp_id }} .atplp-summary { padding:15px 14px; } #{{ atplp_id }} .atplp-add { min-width:150px; } }
    </style>
    <div id="{{ atplp_id }}" data-atplp-fbt data-main-variant="{{ atplp_main.selected_or_first_available_variant.id }}" data-main-price="{{ atplp_main.selected_or_first_available_variant.price }}">
      <script type="application/json" data-atplp-main-variants>{{ atplp_main.variants | json }}</script>
      <label class="atplp-choice is-active" data-atplp-choice="one"><input type="radio" name="{{ atplp_id }}-mode" value="one" checked><strong>Pair it with any 2nd product <em class="atplp-badge">BEST VALUE</em></strong><small>Extra 5% off everything</small><span class="atplp-discount">-5%</span></label>
      <div class="atplp-picker" data-atplp-picker="one">
        <h4>Pick your pair</h4>
        {%- assign add_product = atplp_one -%}
        {%- assign av = add_product.selected_or_first_available_variant -%}
        <article class="atplp-product is-picked" data-atplp-product data-product-key="1" data-selected-variant-id="{{ av.id }}" data-selected-price="{{ av.price }}">
          <img src="{{ add_product.featured_image | image_url: width: 260 }}" alt="{{ add_product.title | escape }}">
          <b>{{ add_product.title }}</b>
          <span data-atplp-product-price>{{ av.price | money }}</span>
          <span class="atplp-shade-title">SHADE</span>
          <div class="atplp-swatches" role="group" aria-label="Select shade for {{ add_product.title | escape }}">
            {%- for v in add_product.variants -%}
              {%- assign palette_index = forloop.index0 | modulo: atplp_palette.size -%}
              {%- assign swatch_color = atplp_palette[palette_index] -%}
              <button type="button" class="atplp-swatch{% if v.id == av.id %} is-selected{% endif %}" data-atplp-variant data-variant-id="{{ v.id }}" data-price="{{ v.price }}" data-title="{{ v.title }}" style="--atplp-swatch: {{ swatch_color }};" aria-pressed="{% if v.id == av.id %}true{% else %}false{% endif %}" title="{{ v.title | escape }}"{% unless v.available %} disabled{% endunless %}>{{ v.title }}</button>
            {%- endfor -%}
          </div>
        </article>
      </div>
      <label class="atplp-choice" data-atplp-choice="two"><input type="radio" name="{{ atplp_id }}-mode" value="two"><strong>Complete trio - add any 2</strong><small>Extra 10% off everything</small><span class="atplp-discount">-10%</span></label>
      <div class="atplp-picker" data-atplp-picker="two" hidden>
        <h4>Pick 2</h4>
        <div class="atplp-product-grid">
          {%- assign trio_products = 'cmc-kiss-drip-lip-gloss,cmc-flattering-nude-lipstick' | split: ',' -%}
          {%- for product_handle in trio_products -%}
            {%- if product_handle == 'cmc-kiss-drip-lip-gloss' -%}
              {%- assign add_product = atplp_one -%}
            {%- else -%}
              {%- assign add_product = atplp_two -%}
            {%- endif -%}
            {%- assign av = add_product.selected_or_first_available_variant -%}
            <article class="atplp-product is-picked" data-atplp-product data-product-key="{{ forloop.index }}" data-selected-variant-id="{{ av.id }}" data-selected-price="{{ av.price }}">
              <img src="{{ add_product.featured_image | image_url: width: 260 }}" alt="{{ add_product.title | escape }}">
              <b>{{ add_product.title }}</b>
              <span data-atplp-product-price>{{ av.price | money }}</span>
              <span class="atplp-shade-title">SHADE</span>
              <div class="atplp-swatches" role="group" aria-label="Select shade for {{ add_product.title | escape }}">
                {%- for v in add_product.variants -%}
                  {%- assign palette_index = forloop.index0 | modulo: atplp_palette.size -%}
                  {%- assign swatch_color = atplp_palette[palette_index] -%}
                  <button type="button" class="atplp-swatch{% if v.id == av.id %} is-selected{% endif %}" data-atplp-variant data-variant-id="{{ v.id }}" data-price="{{ v.price }}" data-title="{{ v.title }}" style="--atplp-swatch: {{ swatch_color }};" aria-pressed="{% if v.id == av.id %}true{% else %}false{% endif %}" title="{{ v.title | escape }}"{% unless v.available %} disabled{% endunless %}>{{ v.title }}</button>
                {%- endfor -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
      <div class="atplp-summary"><div class="atplp-price"><strong data-atplp-total>-</strong><small data-atplp-saving></small></div><button type="button" class="atplp-add" data-atplp-add>Add to cart</button></div><div class="atplp-status" data-atplp-status aria-live="polite"></div>
    </div>
    <script>
      (() => {
        document.querySelectorAll('[data-atplp-fbt]').forEach((box) => {
          if (box.dataset.ready) return;
          box.dataset.ready = '1';

          const money = (n) => new Intl.NumberFormat(undefined, {
            style: 'currency',
            currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'INR',
            maximumFractionDigits: 0,
          }).format(n / 100);

          const choices = box.querySelectorAll('[data-atplp-choice]');
          const pickers = box.querySelectorAll('[data-atplp-picker]');
          const add = box.querySelector('[data-atplp-add]');
          const status = box.querySelector('[data-atplp-status]');
          const mainVariantsEl = box.querySelector('[data-atplp-main-variants]');
          const mainVariants = mainVariantsEl ? JSON.parse(mainVariantsEl.textContent || '[]') : [];

          const mode = () => box.querySelector('[data-atplp-choice].is-active input').value;
          const visible = () => box.querySelector('[data-atplp-picker="' + mode() + '"]');

          const readMainVariantId = () => {
            const form = document.querySelector('form[action*="/cart/add"]');
            const input = form && form.querySelector('select[name="id"], input[name="id"]:checked, input[name="id"]');
            return (input && input.value) || box.dataset.mainVariant;
          };

          const syncMainVariant = () => {
            const currentId = String(readMainVariantId() || '');
            const currentVariant = mainVariants.find((variant) => String(variant.id) === currentId);

            if (currentVariant) {
              box.dataset.mainVariant = currentVariant.id;
              box.dataset.mainPrice = currentVariant.price;
            }

            return currentVariant || null;
          };

          const setVariant = (card, button) => {
            card.dataset.selectedVariantId = button.dataset.variantId;
            card.dataset.selectedPrice = button.dataset.price;
            card.querySelector('[data-atplp-product-price]').textContent = money(Number(button.dataset.price || 0));
            card.querySelectorAll('[data-atplp-variant]').forEach((item) => {
              item.classList.toggle('is-selected', item === button);
              item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
            });
          };

          const selected = () => Array.from(visible().querySelectorAll('[data-atplp-product]'))
            .map((card) => ({
              variantId: card.dataset.selectedVariantId,
              price: Number(card.dataset.selectedPrice || 0),
            }))
            .filter((item) => item.variantId);

          const refresh = () => {
            syncMainVariant();
            const variants = selected();
            const total = Number(box.dataset.mainPrice || 0) + variants.reduce((sum, item) => sum + item.price, 0);
            const rate = mode() === 'one' ? 5 : 10;
            const discounted = Math.round(total * (100 - rate) / 100);

            box.querySelector('[data-atplp-total]').textContent = money(discounted);
            box.querySelector('[data-atplp-saving]').textContent = 'You save ' + money(total - discounted) + ' (' + rate + '% off)';
          };

          choices.forEach((choice) => {
            choice.addEventListener('click', () => {
              choices.forEach((item) => item.classList.toggle('is-active', item === choice));
              pickers.forEach((picker) => {
                picker.hidden = picker.dataset.atplpPicker !== choice.querySelector('input').value;
              });
              refresh();
            });
          });

          box.querySelectorAll('[data-atplp-product]').forEach((card) => {
            card.querySelectorAll('[data-atplp-variant]').forEach((button) => {
              button.addEventListener('click', () => {
                setVariant(card, button);
                refresh();
              });
            });
          });

          add.addEventListener('click', async () => {
            const variants = selected();
            if (!readMainVariantId() || variants.length === 0) {
              status.textContent = 'Please select available variants.';
              return;
            }

            add.disabled = true;
            add.textContent = 'Adding...';
            status.textContent = '';

            try {
              const items = [{ id: Number(readMainVariantId()), quantity: 1 }].concat(
                variants.map((item) => ({ id: Number(item.variantId), quantity: 1 }))
              );
              const res = await fetch(((window.Shopify && Shopify.routes && Shopify.routes.root) || '/') + 'cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ items }),
              });
              const data = await res.json();
              if (!res.ok) throw new Error(data.description || 'Unable to add products.');

              ['cart:refresh', 'cart:updated', 'cart:build', 'cart-drawer:updated', 'cart:open'].forEach((name) => {
                document.dispatchEvent(new CustomEvent(name, { detail: data }));
              });

              const trigger = document.querySelector('.js-drawer-open-cart,#cart-icon-bubble,.header__icon--cart,[data-cart-drawer-trigger],[data-fastrr-cart]');
              if (trigger) trigger.click();

              status.style.color = '#177246';
              status.textContent = 'Added to cart.';
            } catch (e) {
              status.style.color = '#a33';
              status.textContent = e.message;
            } finally {
              add.disabled = false;
              add.textContent = 'Add to cart';
            }
          });

          box.querySelectorAll('[data-atplp-product]').forEach((card) => {
            const initial = card.querySelector('[data-atplp-variant].is-selected') || card.querySelector('[data-atplp-variant]');
            if (initial) setVariant(card, initial);
          });

          document.addEventListener('change', (event) => {
            if (event.target.closest('form[action*="/cart/add"]')) {
              refresh();
            }
          });

          document.addEventListener('variant:change', refresh);

          refresh();
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}



