{%- if product.handle == '__legacy-fbt-disabled__' and foundation_product != nil -%}
{%- endif -%}


  {%- assign foundation_selected_variant = foundation_product.selected_or_first_available_variant -%}

  {%- assign foundation_product_image = foundation_product.featured_media.preview_image
    | default: foundation_product.featured_image
