  <script>
    (function () {
      var widgets = document.querySelectorAll('[data-fbt-widget]');

      if (!widgets.length) return;

      widgets.forEach(function (widget) {
        if (widget.getAttribute('data-fbt-initialized') === 'true') return;

        widget.setAttribute('data-fbt-initialized', 'true');

        var optionCards = Array.from(
          widget.querySelectorAll('[data-fbt-option-card]')
        );

        var optionInputs = Array.from(
          widget.querySelectorAll('[data-fbt-option-input]')
        );

        var addButton = widget.querySelector('[data-fbt-add-button]');
        var statusElement = widget.querySelector('[data-fbt-status]');
        var summaryPriceElement = widget.querySelector('[data-fbt-summary-price]');
        var summaryCopyElement = widget.querySelector('[data-fbt-summary-copy]');
        var originalPriceElement = widget.querySelector('[data-fbt-original-price]');
        var bundlePriceElement = widget.querySelector('[data-fbt-bundle-price]');
        var freeGiftElement = widget.querySelector('[data-fbt-free-gift]');

        var shopCurrency =
          widget.getAttribute('data-currency') ||
          (
            window.Shopify &&
            window.Shopify.currency &&
            window.Shopify.currency.active
          ) ||
          'USD';

        var isAdding = false;

        function formatMoney(cents) {
          var value = Number(cents || 0) / 100;

          try {
            return new Intl.NumberFormat(undefined, {
              style: 'currency',
              currency: shopCurrency
            }).format(value);
          } catch (error) {
            return value.toFixed(2);
          }
        }

        function setStatus(message, state) {
          if (!statusElement) return;

          statusElement.textContent = message || '';
          statusElement.className = 'fbt-status';

          if (state) {
            statusElement.classList.add('is-' + state);
          }
        }

        function setHidden(element, shouldHide) {
          if (!element) return;

          element.classList.toggle('fbt-is-hidden', shouldHide);
        }

        function getSelectedOption() {
          var selectedInput = widget.querySelector(
            '[data-fbt-option-input]:checked'
          );

          return selectedInput ? selectedInput.value : 'option-1';
        }

        function getVariantInfo(selectElement) {
          if (!selectElement) return null;

          var selectedOption = selectElement.options[
            selectElement.selectedIndex
          ];

          if (!selectedOption) return null;

          var variantId = Number(selectedOption.value);

          return {
            id: Number.isFinite(variantId) && variantId > 0
              ? variantId
              : null,

            price: Number(
              selectedOption.getAttribute('data-price') || 0
            ),

            available:
              selectedOption.getAttribute('data-available') === 'true',

            image:
              selectedOption.getAttribute('data-image') || ''
          };
        }

        function getProductSelect(productKey) {
          return widget.querySelector(
            '[data-fbt-product-key="' + productKey + '"]'
          );
        }

        function getProductVariant(productKey) {
          return getVariantInfo(getProductSelect(productKey));
        }

        function updateProductImage(selectElement) {
          if (!selectElement) return;

          var productRow = selectElement.closest(
            '[data-fbt-product-row]'
          );

          if (!productRow) return;

          var imageElement = productRow.querySelector(
            '[data-fbt-product-image]'
          );

          var selectedVariant = getVariantInfo(selectElement);

          if (!imageElement || !selectedVariant) return;

          var newImage =
            selectedVariant.image ||
            imageElement.getAttribute('data-fbt-fallback-image');

          if (!newImage) return;

          imageElement.classList.add('is-loading');
          imageElement.removeAttribute('srcset');
          imageElement.removeAttribute('sizes');
          imageElement.removeAttribute('data-fallback-applied');

          imageElement.onload = function () {
            imageElement.classList.remove('is-loading');
          };

          imageElement.onerror = function () {
            var fallbackImage = imageElement.getAttribute(
              'data-fbt-fallback-image'
            );

            var fallbackApplied = imageElement.getAttribute(
              'data-fallback-applied'
            );

            if (fallbackImage && fallbackApplied !== 'true') {
              imageElement.setAttribute(
                'data-fallback-applied',
                'true'
              );

              imageElement.src = fallbackImage;
              return;
            }

            imageElement.classList.remove('is-loading');
          };

          imageElement.loading = 'eager';
          imageElement.src = newImage;
        }

        function updateRowPrice(selectElement) {
          if (!selectElement) return;

          var productKey = selectElement.getAttribute(
            'data-fbt-product-key'
          );

          if (!productKey) return;

          var priceElement = widget.querySelector(
            '[data-fbt-price="' + productKey + '"]'
          );

          var selectedVariant = getVariantInfo(selectElement);

          if (!priceElement || !selectedVariant) return;

          if (!selectedVariant.id) {
            priceElement.textContent = 'â€”';
            return;
          }

          priceElement.textContent = formatMoney(
            selectedVariant.price
          );
        }

        function updateAllRowPrices() {
          widget.querySelectorAll('[data-fbt-select]').forEach(
            function (selectElement) {
              updateRowPrice(selectElement);
            }
          );
        }

        function toggleOptionalProducts() {
          var selectedOption = getSelectedOption();

          var showHydrating =
            selectedOption === 'option-1' ||
            selectedOption === 'option-2';

          var showSpray = selectedOption === 'option-2';

          var hydratingRow = widget.querySelector(
            '[data-fbt-product-row="hydrating"]'
          );

          var sprayRow = widget.querySelector(
            '[data-fbt-product-row="spray"]'
          );

          var hydratingConnector = widget.querySelector(
            '[data-fbt-connector="hydrating"]'
          );

          var sprayConnector = widget.querySelector(
            '[data-fbt-connector="spray"]'
          );

          setHidden(hydratingRow, !showHydrating);
          setHidden(hydratingConnector, !showHydrating);

          setHidden(sprayRow, !showSpray);
          setHidden(sprayConnector, !showSpray);

          setHidden(freeGiftElement, true);
        }

        function validateSelection() {
          var selectedOption = getSelectedOption();

          var foundationVariant = getProductVariant('foundation');
          var hydratingVariant = getProductVariant('hydrating');
          var sprayVariant = getProductVariant('spray');

          var needsHydrating =
            selectedOption === 'option-1' ||
            selectedOption === 'option-2';

          var needsSpray = selectedOption === 'option-2';

          if (
            !foundationVariant ||
            !foundationVariant.id ||
            !foundationVariant.available
          ) {
            return {
              valid: false,
              message: 'Please select an available CMC Skin Tint variant.'
            };
          }

          if (
            needsHydrating &&
            (
              !hydratingVariant ||
              !hydratingVariant.id ||
              !hydratingVariant.available
            )
          ) {
            return {
              valid: false,
              message: 'Please select an available CMC Kiss Drip Lip Gloss variant.'
            };
          }

          if (
            needsSpray &&
            (
              !sprayVariant ||
              !sprayVariant.id ||
              !sprayVariant.available
            )
          ) {
            return {
              valid: false,
              message: 'Please select an available Bestseller Liquid Lipstick Trio Mood Mix variant.'
            };
          }

          return {
            valid: true,
            message: ''
          };
        }

        function updateSummary() {
          var selectedOption = getSelectedOption();

          var foundationVariant =
            getProductVariant('foundation') || {
              price: 0,
              available: false
            };

          var hydratingVariant =
            getProductVariant('hydrating') || {
              price: 0,
              available: false
            };

          var sprayVariant =
            getProductVariant('spray') || {
              price: 0,
              available: false
            };

          var subtotal = foundationVariant.price;

          if (
            selectedOption === 'option-1' ||
            selectedOption === 'option-2'
          ) {
            subtotal += hydratingVariant.price;
          }

          if (selectedOption === 'option-2') {
            subtotal += sprayVariant.price;
          }

          var discountRate = 0;

          if (selectedOption === 'option-1') {
            discountRate = 5;
          }

          if (selectedOption === 'option-2') {
            discountRate = 10;
          }

          var discountAmount = Math.round(
            subtotal * discountRate / 100
          );

          var calculatedBundlePrice =
            subtotal - discountAmount;

          if (summaryPriceElement) {
            summaryPriceElement.textContent = formatMoney(
              calculatedBundlePrice
            );
          }

          if (originalPriceElement) {
            originalPriceElement.textContent = formatMoney(
              subtotal
            );
          }

          if (bundlePriceElement) {
            bundlePriceElement.textContent = formatMoney(
              calculatedBundlePrice
            );
          }

          if (summaryCopyElement) {
            if (discountRate > 0) {
              summaryCopyElement.textContent =
                'Save ' +
                formatMoney(discountAmount) +
                ' with this bundle.';
            } else {
              summaryCopyElement.textContent =
                'Choose a frequently bought together option.';
            }
          }

          var validation = validateSelection();

          if (addButton) {
            addButton.disabled =
              isAdding || !validation.valid;
          }

          if (!validation.valid) {
            setStatus(validation.message, 'error');
          } else if (!isAdding) {
            setStatus(
              'Ready to add your selected bundle.',
              ''
            );
          }
        }

        function updateSelectionUI() {
          var selectedOption = getSelectedOption();

          optionCards.forEach(function (card) {
            var isSelected =
              card.getAttribute('data-fbt-option') ===
              selectedOption;

            card.classList.toggle(
              'is-selected',
              isSelected
            );
          });

          toggleOptionalProducts();
          updateAllRowPrices();
          updateSummary();
        }

        function getCartComponent() {
          return (
            document.querySelector('cart-drawer') ||
            document.querySelector('cart-notification')
          );
        }

        function getCartSections(cartComponent) {
          if (
            !cartComponent ||
            typeof cartComponent.getSectionsToRender !==
              'function'
          ) {
            return [];
          }

          return cartComponent
            .getSectionsToRender()
            .map(function (section) {
              return section.id;
            })
            .filter(Boolean);
        }

        widget.querySelectorAll('[data-fbt-select]').forEach(
          function (selectElement) {
            selectElement.addEventListener(
              'change',
              function () {
                updateProductImage(selectElement);
                updateRowPrice(selectElement);
                updateSummary();
              }
            );

            updateProductImage(selectElement);
            updateRowPrice(selectElement);
          }
        );

        optionInputs.forEach(function (inputElement) {
          inputElement.addEventListener(
            'change',
            updateSelectionUI
          );
        });

        if (addButton) {
          addButton.addEventListener(
            'click',
            async function () {
              var validation = validateSelection();

              if (!validation.valid) {
                setStatus(validation.message, 'error');
                return;
              }

              var selectedOption = getSelectedOption();

              var foundationVariant =
                getProductVariant('foundation');

              var hydratingVariant =
                getProductVariant('hydrating');

              var sprayVariant =
                getProductVariant('spray');

              var bundleToken =
                'fbt-' +
                Date.now() +
                '-' +
                Math.random()
                  .toString(36)
                  .slice(2, 8);

              var sharedProperties = {
                _fbt_bundle: bundleToken,
                _fbt_bundle_option: selectedOption
              };

              var items = [
                {
                  id: foundationVariant.id,
                  quantity: 1,
                  properties: Object.assign(
                    {},
                    sharedProperties,
                    {
                      _fbt_product_role: 'main-product'
                    }
                  )
                }
              ];

              if (
                selectedOption === 'option-1' ||
                selectedOption === 'option-2'
              ) {
                items.push({
                  id: hydratingVariant.id,
                  quantity: 1,
                  properties: Object.assign(
                    {},
                    sharedProperties,
                    {
                      _fbt_product_role: 'cmc-kiss-drip-lip-gloss'
                    }
                  )
                });
              }

              if (selectedOption === 'option-2') {
                items.push({
                  id: sprayVariant.id,
                  quantity: 1,
                  properties: Object.assign(
                    {},
                    sharedProperties,
                    {
                      _fbt_product_role: 'cmc-bestseller-liquid-lipstick-trio-mood-mix'
                    }
                  )
                });

              }

              isAdding = true;
              addButton.disabled = true;
              addButton.textContent = 'Adding...';

              setStatus(
                'Adding your bundle...',
                'loading'
              );

              try {
                var cartComponent = getCartComponent();
                var cartSections =
                  getCartSections(cartComponent);

                var requestBody = {
                  items: items
                };

                if (cartSections.length) {
                  requestBody.sections =
                    cartSections.join(',');

                  requestBody.sections_url =
                    window.location.pathname;
                }

                var shopRoot =
                  window.Shopify &&
                  window.Shopify.routes &&
                  window.Shopify.routes.root
                    ? window.Shopify.routes.root
                    : '/';

                var response = await fetch(
                  shopRoot + 'cart/add.js',
                  {
                    method: 'POST',
                    headers: {
                      'Content-Type':
                        'application/json',

                      Accept:
                        'application/json'
                    },
                    body: JSON.stringify(requestBody)
                  }
                );

                var responseData =
                  await response.json();

                if (!response.ok) {
                  throw new Error(
                    responseData.description ||
                    responseData.message ||
                    'Unable to add bundle.'
                  );
                }

                addButton.textContent =
                  'Added to Cart';

                setStatus(
                  'Bundle added successfully.',
                  'success'
                );

                if (
                  cartComponent &&
                  responseData.sections &&
                  typeof cartComponent.renderContents ===
                    'function'
                ) {
                  cartComponent.renderContents(
                    responseData
                  );
                } else {
                  document.dispatchEvent(
                    new CustomEvent(
                      'ajaxProduct:added',
                      {
                        detail: responseData
                      }
                    )
                  );

                  document.dispatchEvent(
                    new CustomEvent(
                      'cart:updated',
                      {
                        detail: responseData
                      }
                    )
                  );

                  document.dispatchEvent(
                    new CustomEvent('cart:open')
                  );

                  var cartTrigger =
                    document.querySelector(
                      '.js-drawer-open-cart, [data-cart-drawer-trigger], #cart-icon-bubble, .js-drawer-open-cart'
                    );

                  if (cartTrigger) {
                    cartTrigger.click();
                  }
                }

                // This theme's cart drawer listens for these events rather
                // than the standard Dawn section response alone.
                document.dispatchEvent(new CustomEvent('cart:refresh', {
                  detail: responseData
                }));
                document.dispatchEvent(new CustomEvent('cart:updated', {
                  detail: responseData
                }));
                document.dispatchEvent(new CustomEvent('cart:build', {
                  detail: responseData
                }));
                document.dispatchEvent(new CustomEvent('cart-drawer:updated', {
                  detail: responseData
                }));

                window.setTimeout(function () {
                  var drawerTrigger = document.querySelector(
                    '.js-drawer-open-cart, #cart-icon-bubble, .header__icon--cart, [data-cart-drawer-trigger], [data-cart-drawer-toggle], [data-fastrr-cart], .fastrr-cart-toggle'
                  );

                  if (drawerTrigger) {
                    drawerTrigger.click();
                  } else {
                    document.dispatchEvent(new CustomEvent('cart:open'));
                    document.dispatchEvent(new CustomEvent('fastrr:open-cart', {
                      bubbles: true
                    }));
                  }
                }, 150);
              } catch (error) {
                console.error(
                  'FBT bundle error:',
                  error
                );

                setStatus(
                  error.message ||
                  'Something went wrong. Please try again.',
                  'error'
                );

                addButton.textContent =
                  'Add Selected Bundle to Cart';
              } finally {
                window.setTimeout(function () {
                  isAdding = false;

                  addButton.textContent =
                    'Add Selected Bundle to Cart';

                  updateSummary();
                }, 1200);
              }
            }
          );
        }

        updateSelectionUI();
      });
    })();
  </script>
{%- endcomment -%}

