  {%- assign fbt_widget_id = 'fbt-' | append: section.id | append: '-' | append: product.id -%} 

  <style>
    .fbt-bundle-widget {
      margin: 2.25rem 0 2.5rem;
      padding: 1.5rem;
      border: 1px solid rgba(126, 93, 75, 0.16);
      border-radius: 24px;
      background: linear-gradient(135deg, #fffaf7 0%, #ffffff 100%);
      box-shadow: 0 18px 40px rgba(60, 38, 24, 0.08);
      font-family: inherit;
    }

    .fbt-is-hidden {
      display: none !important;
    }

    .fbt-bundle-widget__header h3 {
      margin: 0 0 0.35rem;
      font-size: clamp(1.2rem, 2vw, 1.55rem);
      line-height: 1.3;
      color: #2f241e;
    }

    .fbt-bundle-widget__header p {
      margin: 0;
      color: #6e5f55;
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .fbt-bundle-options {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 1.2rem;
    }

    .fbt-option-card {
      position: relative;
      display: block;
      border: 1px solid rgba(126, 93, 75, 0.16);
      border-radius: 20px;
      padding: 1rem;
      background: #ffffff;
      cursor: pointer;
      overflow: hidden;
      transition:
        transform 180ms ease,
        box-shadow 180ms ease,
        border-color 180ms ease,
        background 180ms ease;
    }

    .fbt-option-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(60, 38, 24, 0.08);
    }

    .fbt-option-card.is-selected {
      border-color: #c89572;
      box-shadow: 0 16px 30px rgba(200, 149, 114, 0.18);
      background: linear-gradient(135deg, #fffaf5 0%, #ffffff 100%);
    }

    .fbt-option-card.is-disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .fbt-option-card.is-disabled:hover {
      transform: none;
      box-shadow: none;
    }

    .fbt-option-card__radio {
      position: absolute;
      inset: 0;
      z-index: 2;
      width: 100%;
      height: 100%;
      margin: 0;
      opacity: 0;
      cursor: pointer;
    }

    .fbt-option-card__radio:disabled {
      cursor: not-allowed;
    }

    .fbt-option-card__top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.75rem;
      margin-bottom: 0.7rem;
    }

    .fbt-option-card__title {
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.35;
      color: #2f241e;
    }

    .fbt-option-card__badge {
         display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 999px;
    padding: 0.28rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.2;
    background: #f6ece4;
    color: #8d4d2e;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
}
    

    .fbt-option-card__badge--popular {
      background: #2d6a4f;
      color: #ffffff;
    }

    .fbt-option-card__summary {
      min-height: 2.7rem;
      margin-bottom: 0.8rem;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #5e4b3f;
    }

    .fbt-option-card__price-row {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .fbt-option-card__price {
      font-size: 1.05rem;
      font-weight: 700;
      color: #2f241e;
    }

    .fbt-option-card__price--strike {
      color: #9f8a7e;
      text-decoration: line-through;
      font-weight: 500;
    }

    .fbt-option-card__savings {
      font-size: 0.82rem;
      font-weight: 700;
      color: #2d6a4f;
    }

    .fbt-product-panel {
      margin-top: 1.2rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(126, 93, 75, 0.16);
    }

    .fbt-product-row {
      display: grid;
      grid-template-columns: 68px minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.9rem;
      padding: 0.8rem 0;
      border-bottom: 1px solid rgba(126, 93, 75, 0.1);
    }

    .fbt-product-row__connector {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      margin: 0.35rem auto;
      border-radius: 999px;
      background: #f6ece4;
      color: #8d4d2e;
      font-size: 1.05rem;
      font-weight: 700;
    }

    .fbt-product-row__image {
      display: block;
      width: 64px;
      height: 64px;
      max-width: 64px;
      border-radius: 14px;
      object-fit: cover;
      object-position: center;
      background: #f7efe9;
      transition: opacity 150ms ease;
    }

    .fbt-product-row__image.is-loading {
      opacity: 0.55;
    }

    .fbt-product-row__title {
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.4;
      color: #2f241e;
    }

    .fbt-product-row__meta {
      display: block;
      margin-top: 0.2rem;
      font-size: 0.82rem;
      line-height: 1.45;
      color: #6e5f55;
    }

    .fbt-product-row__select {
      width: 100%;
      min-width: 9rem;
      margin-top: 0.45rem;
      border: 1px solid rgba(126, 93, 75, 0.22);
      border-radius: 999px;
      padding: 0.65rem 2.3rem 0.65rem 0.8rem;
      font-family: inherit;
      font-size: 0.9rem;
      line-height: 1.3;
      background-color: #ffffff;
      color: #2f241e;
      cursor: pointer;
    }

    .fbt-product-row__select:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

