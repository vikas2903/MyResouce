</style>

<script>
(function() {
  'use strict';

  document.addEventListener('DOMContentLoaded', function() {
    const bundleSections = document.querySelectorAll('.bundle-builder-section');
    bundleSections.forEach(function(section) {
      new BundleBuilder(section);
    });
  });

  function BundleBuilder(sectionElement) {
    this.section = sectionElement;
    this.sectionId = sectionElement.id.replace('bundle-builder-', '');
    this.selectedProducts = [];
    this.bundlePrice = parseInt(sectionElement.dataset.bundlePrice) || 59900;
    this.requiredProducts = parseInt(sectionElement.dataset.requiredProducts) || 2;
    this.confettiTriggered = false;
    this.init();
  }

  BundleBuilder.prototype.init = function() {
    var self = this;
    
    this.selectedProductsContainer = this.section.querySelector('.bundle-selected-items-list');
    this.emptySlots = this.section.querySelector('.bundle-empty-slots');
    this.originalTotal = this.section.querySelector('#bundle-original-total-' + this.sectionId);
    this.offerTotal = this.section.querySelector('#bundle-offer-total-' + this.sectionId);
    this.saveAmount = this.section.querySelector('#bundle-save-amount-' + this.sectionId);
    this.checkoutBtn = this.section.querySelector('#bundle-checkout-btn-' + this.sectionId);
    this.confettiCanvas = document.getElementById('bundle-confetti-' + this.sectionId);
    this.progressCurrent = this.section.querySelector('#bundle-progress-current-' + this.sectionId);
    this.progressFill = this.section.querySelector('#bundle-progress-fill-' + this.sectionId);
    
    if (!this.checkoutBtn) {
      console.error('Checkout button not found');
      return;
    }

    // Clear non-bundle products from cart and load only bundle products
    this.initializeFromCart();

    // Handle window resize for confetti canvas
    var resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(function() {
        if (self.confettiCanvas && self.confettiCanvas.classList.contains('active')) {
          // Update canvas size to full screen
          self.confettiCanvas.width = window.innerWidth;
          self.confettiCanvas.height = window.innerHeight;
        }
      }, 250);
    });

    // Event delegation for button clicks
    this.section.addEventListener('click', function(e) {
      var btn = e.target.closest('.bundle-add-btn');
      if (btn && !btn.disabled) {
        e.preventDefault();
        e.stopPropagation();
        self.handleAddButtonClick(btn);
      }
    });

    // Event delegation for variant selector changes
    this.section.addEventListener('change', function(e) {
      if (e.target.classList.contains('bundle-variant-select')) {
        e.preventDefault();
        e.stopPropagation();
        self.handleVariantChange(e.target);
      }
    });

    // Event delegation for remove buttons
    this.section.addEventListener('click', function(e) {
      if (e.target.classList.contains('bundle-selected-item-remove')) {
        e.preventDefault();
        e.stopPropagation();
        var index = parseInt(e.target.dataset.index);
        self.removeProduct(index);
      }
    });

    this.checkoutBtn.addEventListener('click', function() {
      self.handleCheckout();
    });
    
    this.setupCollectionLoaders();
    this.updateUI();
  };

  BundleBuilder.prototype.initializeFromCart = function() {
    var self = this;
    
    // Get current cart
    fetch('/cart.js')
      .then(function(response) {
        return response.json();
      })
      .then(function(cart) {
        // Get all product IDs from the bundle section
        var bundleProductIds = [];
        var productCards = self.section.querySelectorAll('.bundle-product-card');
        productCards.forEach(function(card) {
          var productId = card.dataset.productId;
          if (productId) {
            bundleProductIds.push(String(productId));
          }
        });
        
        // Also check products loaded via AJAX
        var addButtons = self.section.querySelectorAll('.bundle-add-btn');
        addButtons.forEach(function(btn) {
          var productId = btn.dataset.productId;
          if (productId && bundleProductIds.indexOf(String(productId)) === -1) {
            bundleProductIds.push(String(productId));
          }
        });
        
        // Filter cart items to only include bundle products
        var bundleCartItems = [];
        var nonBundleItems = [];
        
        cart.items.forEach(function(item) {
          var itemProductId = String(item.product_id);
          if (bundleProductIds.indexOf(itemProductId) !== -1) {
            // This is a bundle product
            bundleCartItems.push(item);
          } else {
            // This is not a bundle product - mark for removal
            nonBundleItems.push(item);
          }
        });
        
        // Remove non-bundle products from cart
        if (nonBundleItems.length > 0) {
          var removePromises = [];
          nonBundleItems.forEach(function(item) {
            removePromises.push(
              fetch('/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  id: item.key,
                  quantity: 0
                })
              })
            );
          });
          
          Promise.all(removePromises)
            .then(function() {
              // After removing non-bundle items, load bundle products
              self.loadBundleProductsFromCart(bundleCartItems);
            })
            .catch(function(error) {
              console.error('Error removing non-bundle products:', error);
              // Still try to load bundle products even if removal failed
              self.loadBundleProductsFromCart(bundleCartItems);
            });
        } else {
          // No non-bundle items, just load bundle products
          self.loadBundleProductsFromCart(bundleCartItems);
        }
      })
      .catch(function(error) {
        console.error('Error loading cart:', error);
      });
  };

  BundleBuilder.prototype.loadBundleProductsFromCart = function(bundleCartItems) {
    var self = this;
    
    // Clear current selections
    this.selectedProducts = [];
    
    // Load bundle products from cart
    bundleCartItems.forEach(function(cartItem) {
      var productId = String(cartItem.product_id);
      var variantId = String(cartItem.variant_id);
      
      // Find product card by product ID
      var productCard = self.section.querySelector('[data-product-id="' + productId + '"]');
      if (productCard) {
        // Check if variant selector exists and update it
        var variantSelect = productCard.querySelector('.bundle-variant-select');
        if (variantSelect) {
          // Set the correct variant in selector
          variantSelect.value = variantId;
          // Trigger variant change to update data attributes
          var event = new Event('change', { bubbles: true });
          variantSelect.dispatchEvent(event);
        }
        
        // Get variant info from the product card (after variant selector update)
        var button = productCard.querySelector('.bundle-add-btn');
        var checkbox = productCard.querySelector('.bundle-checkbox-input');
        
        if (button || checkbox) {
          var source = button || checkbox;
          var price = parseInt(source.dataset.price) || cartItem.price;
          var title = source.dataset.title || cartItem.product_title;
          var image = source.dataset.image || (cartItem.image || '');
          
          // Check if this product is already in selectedProducts (avoid duplicates)
          var isDuplicate = self.selectedProducts.some(function(product) {
            return String(product.id) === productId && String(product.variantId) === variantId;
          });
          
          if (!isDuplicate) {
            // Add to selected products
            self.selectedProducts.push({
              id: productId,
              variantId: variantId,
              price: price,
              title: title,
              image: image
            });
            
            // Update UI state
            if (checkbox) {
              checkbox.checked = true;
            }
            productCard.classList.add('selected');
            if (button) {
              button.textContent = 'REMOVE FROM BOX';
              button.classList.add('selected');
            }
          }
        }
      }
    });
    
    // Update UI
    this.updateUI();
  };

  BundleBuilder.prototype.setupCollectionLoaders = function() {
    var self = this;
    var loaders = this.section.querySelectorAll('.bundle-collection-loader');
    
    loaders.forEach(function(loader) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting && loader.dataset.loading !== 'true') {
            self.loadMoreCollectionProducts(loader);
          }
        });
      }, {
        rootMargin: '100px'
      });
      
      observer.observe(loader);
    });
  };

  BundleBuilder.prototype.loadMoreCollectionProducts = function(loader) {
    var self = this;
    
    if (loader.dataset.loading === 'true') return;
    
    loader.dataset.loading = 'true';
    loader.style.display = 'flex';
    
    var collectionHandle = loader.dataset.collectionHandle;
    var currentPage = parseInt(loader.dataset.page) || 1;
    var totalProducts = parseInt(loader.dataset.totalProducts) || 0;
    var productsLoaded = parseInt(loader.dataset.productsLoaded) || 20;
    var productsPerPage = 20;
    var nextPage = currentPage + 1;
    
    if (productsLoaded >= totalProducts) {
      loader.style.display = 'none';
      loader.dataset.loading = 'false';
      return;
    }
    
    fetch('/collections/' + collectionHandle + '/products.json?page=' + nextPage + '&limit=' + productsPerPage)
      .then(function(response) {
        return response.json();
      })
      .then(function(data) {
        var products = data.products || [];
        
        if (products.length > 0) {
          var sectionId = loader.dataset.sectionId || self.sectionId;
          var collectionWrapper = self.section.querySelector('.bundle-products-grid');
          
          products.forEach(function(product) {
            var productCard = self.createProductCard(product, sectionId);
            if (productCard) {
              collectionWrapper.insertBefore(productCard, loader);
            }
          });
          
          var newProductsLoaded = productsLoaded + products.length;
          loader.dataset.page = nextPage;
          loader.dataset.productsLoaded = newProductsLoaded;
          loader.dataset.loading = 'false';
          loader.style.display = 'none';
          
          if (newProductsLoaded >= totalProducts) {
            loader.style.display = 'none';
          }
          
          self.updateUI();
        } else {
          loader.style.display = 'none';
          loader.dataset.loading = 'false';
        }
      })
      .catch(function(error) {
        console.error('Error loading more products:', error);
        loader.dataset.loading = 'false';
        loader.style.display = 'none';
      });
  };

  BundleBuilder.prototype.handleVariantChange = function(selectElement) {
    var self = this;
    var productId = selectElement.dataset.productId;
    var selectedOption = selectElement.options[selectElement.selectedIndex];
    var variantId = selectedOption.value;
    var variantPrice = parseInt(selectedOption.dataset.price) || 0;
    var variantImage = selectedOption.dataset.image || '';
    
    // Find the product card
    var productCard = selectElement.closest('.bundle-product-card');
    if (!productCard) return;
    
    // Get old variant ID from card
    var oldVariantId = productCard.dataset.variantId;
    
    // Update product card data attributes
    productCard.dataset.variantId = variantId;
    
    // Update checkbox
    var checkbox = productCard.querySelector('.bundle-checkbox-input');
    if (checkbox) {
      checkbox.dataset.variantId = variantId;
      checkbox.dataset.price = variantPrice;
      checkbox.dataset.image = variantImage;
    }
    
    // Update button
    var button = productCard.querySelector('.bundle-add-btn');
    if (button) {
      button.dataset.variantId = variantId;
      button.dataset.price = variantPrice;
      button.dataset.image = variantImage;
      
      // Check if this product was selected with a different variant
      var oldSelection = self.selectedProducts.find(function(product) {
        return String(product.id) === String(productId) && String(product.variantId) === String(oldVariantId);
      });
      
      if (oldSelection && String(oldSelection.variantId) !== String(variantId)) {
        // Remove old variant from cart
        fetch('/cart.js')
          .then(function(response) {
            return response.json();
          })
          .then(function(cart) {
            // Find the cart item with old variant ID
            var cartItem = null;
            for (var j = 0; j < cart.items.length; j++) {
              if (String(cart.items[j].variant_id) === String(oldVariantId)) {
                cartItem = cart.items[j];
                break;
              }
            }
            
            if (cartItem) {
              // Remove old variant from cart
              return fetch('/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  id: cartItem.key,
                  quantity: 0
                })
              });
            }
            return Promise.resolve();
          })
          .then(function() {
            // Remove old variant from selected products
            self.selectedProducts = self.selectedProducts.filter(function(product) {
              return !(String(product.id) === String(productId) && String(product.variantId) === String(oldVariantId));
            });
            
            // Update UI
            checkbox.checked = false;
            productCard.classList.remove('selected');
            button.textContent = 'ADD TO BOX';
            button.classList.remove('selected');
            self.updateUI();
            self.updateCartAttributes();
          })
          .catch(function(error) {
            console.error('Error removing old variant from cart:', error);
          });
      }
    }
  };

  BundleBuilder.prototype.createProductCard = function(product, sectionId) {
    // Find 60ML variant, or fallback to first available variant
    var variant = null;
    var fallbackVariant = null;
    if (product.variants && product.variants.length > 0) {
      for (var i = 0; i < product.variants.length; i++) {
        var v = product.variants[i];
        if (v.available) {
          // Store first available variant as fallback
          if (!fallbackVariant) {
            fallbackVariant = v;
          }
          // Check if variant title contains 60ML in various formats
          var variantTitle = (v.title || '').toUpperCase();
          if (variantTitle.indexOf('60ML') !== -1 || 
              variantTitle.indexOf('60 ML') !== -1 || 
              variantTitle.indexOf('60ml') !== -1 || 
              variantTitle.indexOf('60 ml') !== -1) {
            variant = v;
            break;
          }
        }
      }
    }
    
    // Use 60ML variant if found, otherwise use first available variant
    if (!variant) {
      variant = fallbackVariant;
    }
    
    // Only create card if any available variant exists
    if (!variant) return null;
    
    var card = document.createElement('div');
    card.className = 'bundle-product-card';
    card.dataset.productId = product.id;
    card.dataset.variantId = variant.id;
    
    var imageUrl = '';
    if (product.featured_image) {
      imageUrl = typeof product.featured_image === 'string' ? product.featured_image : product.featured_image.src;
    } else if (product.images && product.images.length > 0) {
      imageUrl = typeof product.images[0] === 'string' ? product.images[0] : product.images[0].src;
    }
    
    // Handle price format from JSON API
    // Shopify JSON API returns prices as strings in decimal format (e.g., "99.00" for ₹99)
    // We need to convert to cents (9900) for consistency with the rest of the code
    var price = 0;
    var comparePrice = null;
    
    if (variant.price) {
      if (typeof variant.price === 'string') {
        // Price is a string like "99.00" or "1999.00" - convert to cents
        price = Math.round(parseFloat(variant.price) * 100);
      } else {
        // Price is a number - check if it looks like cents or decimal
        // If it's a very large number (> 10000), likely already in cents
        // Otherwise, assume it's decimal format and convert
        if (variant.price > 10000) {
          price = Math.round(variant.price);
        } else {
          price = Math.round(variant.price * 100);
        }
      }
    }
    
    if (variant.compare_at_price) {
      if (typeof variant.compare_at_price === 'string') {
        // Compare at price is a string - convert to cents
        comparePrice = Math.round(parseFloat(variant.compare_at_price) * 100);
      } else {
        // Compare at price is a number
        if (variant.compare_at_price > 10000) {
          comparePrice = Math.round(variant.compare_at_price);
        } else {
          comparePrice = Math.round(variant.compare_at_price * 100);
        }
      }
    }
    
    // Format prices for display (divide by 100 to get rupees)
    var displayPrice = (price / 100).toFixed(0);
    var displayComparePrice = comparePrice ? (comparePrice / 100).toFixed(0) : null;
    
    // Build variant selector if product has multiple variants
    var variantSelector = '';
    if (product.variants && product.variants.length > 1) {
      var variantOptions = '';
      for (var k = 0; k < product.variants.length; k++) {
        var v = product.variants[k];
        if (v.available) {
          var vPrice = 0;
          if (typeof v.price === 'string') {
            vPrice = Math.round(parseFloat(v.price) * 100);
          } else {
            vPrice = v.price > 10000 ? Math.round(v.price) : Math.round(v.price * 100);
          }
          var vDisplayPrice = (vPrice / 100).toFixed(0);
          var vImage = '';
          if (v.featured_image) {
            vImage = typeof v.featured_image === 'string' ? v.featured_image : v.featured_image.src;
          } else {
            vImage = imageUrl;
          }
          var isSelected = v.id === variant.id ? 'selected' : '';
          variantOptions += '<option value="' + v.id + '" data-price="' + vPrice + '" data-image="' + vImage + '" ' + isSelected + '>' + (v.title || 'Default') + ' - ₹' + vDisplayPrice + '</option>';
        }
      }
      variantSelector = '<div class="bundle-variant-selector" data-product-id="' + product.id + '">' +
        '<select class="bundle-variant-select" data-product-id="' + product.id + '" data-section-id="' + sectionId + '">' +
        variantOptions +
        '</select>' +
        '</div>';
    }
    
    card.innerHTML = 
      '<div class="bundle-product-image-wrapper">' +
        '<img src="' + imageUrl + '" alt="' + product.title + '" loading="lazy" class="bundle-product-image">' +
        '<input type="checkbox" id="product-' + product.id + '-' + sectionId + '" class="bundle-checkbox-input" data-product-id="' + product.id + '" data-variant-id="' + variant.id + '" data-price="' + price + '" data-title="' + product.title + '" data-image="' + imageUrl + '" style="display: none;">' +
      '</div>' +
      '<div class="bundle-product-info">' +
        '<h3 class="bundle-product-title">' + product.title + '</h3>' +
        variantSelector +
        '<div class="bundle-product-price-wrapper">' +
          (comparePrice && comparePrice > price ? '<span class="bundle-product-original-price">₹' + displayComparePrice + '</span>' : '') +
          '<span class="bundle-product-price">₹' + displayPrice + '</span>' +
        '</div>' +
        '<button class="bundle-add-btn" data-product-id="' + product.id + '" data-variant-id="' + variant.id + '" data-price="' + price + '" data-title="' + product.title + '" data-image="' + imageUrl + '">ADD TO BOX</button>' +
      '</div>';
    
    return card;
  };

  BundleBuilder.prototype.handleAddButtonClick = function(btn) {
    var self = this;
    
    // Check if button is disabled (but allow if it's a selected product being removed)
    if (!btn) {
      console.log('Button not found');
      return;
    }
    
    var productCard = btn.closest('.bundle-product-card');
    if (!productCard) {
      console.log('Product card not found');
      return;
    }
    
    var checkbox = productCard.querySelector('.bundle-checkbox-input');
    if (!checkbox) {
      console.log('Checkbox not found');
      return;
    }
    
    var productId = btn.dataset.productId || checkbox.dataset.productId;
    var variantId = btn.dataset.variantId || checkbox.dataset.variantId;
    var price = parseInt(btn.dataset.price || checkbox.dataset.price || 0);
    var title = btn.dataset.title || checkbox.dataset.title || '';
    var image = btn.dataset.image || checkbox.dataset.image || '';
    
    if (!productId || !variantId || productId === 'undefined' || variantId === 'undefined') {
      console.error('Product data missing:', { productId: productId, variantId: variantId, btn: btn });
      return;
    }
    
    var productData = {
      id: String(productId),
      variantId: String(variantId),
      price: price,
      title: title,
      image: image
    };

    // Check if product is already selected
    var isAlreadySelected = false;
    var selectedIndex = -1;
    for (var i = 0; i < this.selectedProducts.length; i++) {
      if (String(this.selectedProducts[i].id) === String(productData.id) && 
          String(this.selectedProducts[i].variantId) === String(productData.variantId)) {
        isAlreadySelected = true;
        selectedIndex = i;
        break;
      }
    }
    
    // If product is already selected, allow removal even if button is disabled
    if (isAlreadySelected && btn.disabled && btn.dataset.limitDisabled === 'true') {
      btn.disabled = false;
      btn.classList.remove('disabled');
      delete btn.dataset.limitDisabled;
    }
    
    // If button is disabled and product is not selected, prevent action
    if (btn.disabled && !isAlreadySelected) {
      console.log('Button disabled and product not selected');
      return;
    }
    
    // If product is already selected, remove it
    if (isAlreadySelected) {
      // Remove product from cart
      fetch('/cart.js')
        .then(function(response) {
          return response.json();
        })
        .then(function(cart) {
          // Find the cart item with this variant ID
          var cartItem = null;
          for (var j = 0; j < cart.items.length; j++) {
            if (String(cart.items[j].variant_id) === String(productData.variantId)) {
              cartItem = cart.items[j];
              break;
            }
          }
          
          if (cartItem) {
            // Remove from cart
            return fetch('/cart/change.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                id: cartItem.key,
                quantity: 0
              })
            });
          }
          return Promise.resolve();
        })
        .then(function() {
          // Product removed from cart, update UI
          self.selectedProducts = self.selectedProducts.filter(function(p) {
            return !(String(p.id) === String(productData.id) && String(p.variantId) === String(productData.variantId));
          });
          checkbox.checked = false;
          productCard.classList.remove('selected');
          btn.textContent = 'ADD TO BOX';
          btn.classList.remove('selected');
          self.updateUI();
          self.updateCartAttributes();
        })
        .catch(function(error) {
          console.error('Error removing product from cart:', error);
          alert('Error removing product from cart. Please try again.');
        });
      return;
    }
    
    // Check maximum limit (required bundle quantity) - only for new products
    if (this.selectedProducts.length >= this.requiredProducts) {
      alert('You can only add ' + this.requiredProducts + ' products to this bundle.');
      return;
    }
    
    // Add new product to cart with bundle attribute
    console.log('Adding product to cart:', productData);
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: productData.variantId,
        quantity: 1,
        properties: {
          '_bundle_product': 'true',
          '_bundle_section_id': this.sectionId
        }
      })
    })
    .then(function(response) {
      if (!response.ok) {
        throw new Error('Network response was not ok');
      }
      return response.json();
    })
    .then(function(data) {
      console.log('Product added to cart:', data);
      // Product added to cart, update UI
      // Add to beginning of array (left side)
      self.selectedProducts.unshift(productData);
      checkbox.checked = true;
      productCard.classList.add('selected');
      btn.textContent = 'REMOVE FROM BOX';
      btn.classList.add('selected');
      self.updateUI();
      self.updateCartAttributes();
    })
    .catch(function(error) {
      console.error('Error adding product to cart:', error);
      alert('Error adding product to cart. Please try again.');
    });
  };

  BundleBuilder.prototype.updateUI = function() {
    var self = this;
    this.updateSelectedProductsDisplay();
    this.updateTotals();
    this.updateProgressBar();
    
    // Update button states - disable buttons when the bundle is full (unless it's a selected product)
    var addButtons = this.section.querySelectorAll('.bundle-add-btn');
    var maxSelected = this.selectedProducts.length >= this.requiredProducts;
    addButtons.forEach(function(button) {
      if (!button) return;
      
      var buttonProductId = button.dataset.productId;
      var buttonVariantId = button.dataset.variantId;
      var isSelected = self.selectedProducts.some(function(product) {
        return String(product.id) === String(buttonProductId) && String(product.variantId) === String(buttonVariantId);
      });
      
      // If max products selected and this button's product is not selected, disable it
      if (maxSelected && !isSelected) {
        button.disabled = true;
        button.classList.add('disabled');
        button.dataset.limitDisabled = 'true';
      } else if (button.dataset.limitDisabled === 'true') {
        // Re-enable button if limit is no longer reached
        button.disabled = false;
        button.classList.remove('disabled');
        delete button.dataset.limitDisabled;
      }
      
      // Update button text based on selection state
      if (isSelected) {
        button.textContent = 'REMOVE FROM BOX';
        button.classList.add('selected');
      } else {
        // Only change text if it's not already "ADD TO BOX" (to avoid unnecessary DOM updates)
        if (button.textContent !== 'ADD TO BOX') {
          button.textContent = 'ADD TO BOX';
        }
        button.classList.remove('selected');
      }
    });

    // Enable checkout when minimum 2 products are selected
    if (this.selectedProducts.length >= this.requiredProducts) {
      if (this.selectedProducts.length === this.requiredProducts && !this.confettiTriggered) {
        this.triggerConfetti();
        this.confettiTriggered = true;
      }
      this.checkoutBtn.disabled = false;
      this.checkoutBtn.classList.remove('disabled');
    } else {
      this.checkoutBtn.disabled = true;
      this.checkoutBtn.classList.add('disabled');
      this.confettiTriggered = false;
    }
  };

  BundleBuilder.prototype.updateProgressBar = function() {
    var current = this.selectedProducts.length;
    var total = this.requiredProducts;
    // Progress bar shows minimum requirement, but can exceed 100%
    var percentage = Math.min((current / total) * 100, 100);
    
    // Update current count
    if (this.progressCurrent) {
      this.progressCurrent.textContent = current;
    }
    
    // Update progress bar fill (max 100%)
    if (this.progressFill) {
      this.progressFill.style.width = percentage + '%';
    }
  };

  BundleBuilder.prototype.updateSelectedProductsDisplay = function() {
    var self = this;
    
    if (!this.selectedProductsContainer) {
      this.selectedProductsContainer = this.section.querySelector('.bundle-selected-items-list');
    }
    if (!this.emptySlots) {
      this.emptySlots = this.section.querySelector('.bundle-empty-slots');
    }
    
    if (!this.selectedProductsContainer || !this.emptySlots) return;
    
    this.selectedProductsContainer.innerHTML = '';

    // Display products (newest first, on the left)
    // Since we use unshift, array is already in correct order (newest at index 0)
    this.selectedProducts.forEach(function(product, index) {
      var item = document.createElement('div');
      item.className = 'bundle-selected-item';
      
      var img = document.createElement('img');
      img.src = product.image || '';
      img.alt = product.title || '';
      item.appendChild(img);
      
      var removeBtn = document.createElement('span');
      removeBtn.className = 'bundle-selected-item-remove';
      removeBtn.textContent = '×';
      removeBtn.setAttribute('data-index', index);
      removeBtn.dataset.index = index;
      item.appendChild(removeBtn);
      
      self.selectedProductsContainer.appendChild(item);
    });

    // Show empty slots only if less than the required bundle quantity
    var remainingSlots = Math.max(0, this.requiredProducts - this.selectedProducts.length);
    this.emptySlots.innerHTML = '';
    for (var i = 0; i < remainingSlots; i++) {
      var slot = document.createElement('div');
      slot.className = 'bundle-empty-slot';
      slot.innerHTML = '<span class="bundle-plus-icon">+</span>';
      this.emptySlots.appendChild(slot);
    }
  };

  BundleBuilder.prototype.removeProduct = function(index) {
    var self = this;
    var product = this.selectedProducts[index];
    if (!product) return;
    
    // Remove from cart
    fetch('/cart.js')
      .then(function(response) {
        return response.json();
      })
      .then(function(cart) {
        // Find the cart item with this variant ID
        var cartItem = null;
        for (var j = 0; j < cart.items.length; j++) {
          if (String(cart.items[j].variant_id) === String(product.variantId)) {
            cartItem = cart.items[j];
            break;
          }
        }
        
        if (cartItem) {
          // Remove from cart
          return fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              id: cartItem.key,
              quantity: 0
            })
          });
        }
        return Promise.resolve();
      })
      .then(function() {
        // Remove from selected products array
        self.selectedProducts.splice(index, 1);

        // Find and update the product card button state
        var checkboxes = self.section.querySelectorAll('[data-product-id="' + String(product.id) + '"]');
        checkboxes.forEach(function(checkbox) {
          if (String(checkbox.dataset.variantId) === String(product.variantId)) {
            checkbox.checked = false;
            var productCard = checkbox.closest('.bundle-product-card');
            if (productCard) {
              productCard.classList.remove('selected');
              var btn = productCard.querySelector('.bundle-add-btn');
              if (btn) {
                btn.textContent = 'ADD TO BOX';
                btn.classList.remove('selected');
              }
            }
          }
        });

        self.updateUI();
        self.updateCartAttributes();
      })
      .catch(function(error) {
        console.error('Error removing product from cart:', error);
        alert('Error removing product from cart. Please try again.');
      });
  };

  BundleBuilder.prototype.updateTotals = function() {
    var productCount = this.selectedProducts.length;
    var bundlePrice = this.bundlePrice;
    var requiredProducts = this.requiredProducts;
    
    // Calculate original total (sum of all individual prices)
    var originalTotal = 0;
    for (var i = 0; i < productCount; i++) {
      originalTotal += this.selectedProducts[i].price;
    }
    
    // Calculate bundle pricing:
    // - Every complete bundle uses the configured offer price
    // - Remaining products = actual individual prices
    var bundleCount = Math.floor(productCount / requiredProducts);
    var remainingProducts = productCount % requiredProducts;
    
    var bundleTotal = bundleCount * bundlePrice;
    var remainingTotal = 0;
    
    // Calculate price for remaining products (actual individual prices)
    for (var j = bundleCount * requiredProducts; j < productCount; j++) {
      remainingTotal += this.selectedProducts[j].price;
    }
    
    var finalTotal = bundleTotal + remainingTotal;
    var savings = originalTotal - finalTotal;
    
    // Display pricing
    if (productCount >= requiredProducts) {
      // Show savings amount
      if (this.saveAmount && savings > 0) {
        this.saveAmount.textContent = 'Save: ' + this.formatPrice(savings);
        this.saveAmount.style.display = 'block';
      } else if (this.saveAmount) {
        this.saveAmount.style.display = 'none';
      }
      
      // Show final total (bundle price) - current price
      this.offerTotal.textContent = this.formatPrice(finalTotal);
      
      // Show original total (strikethrough) - sum of all product prices
      this.originalTotal.textContent = this.formatPrice(originalTotal);
      this.originalTotal.style.display = 'inline';
    } else {
      // Less than minimum, show actual individual total
      if (this.saveAmount) {
        this.saveAmount.style.display = 'none';
      }
      this.originalTotal.style.display = 'none';
      this.offerTotal.textContent = this.formatPrice(originalTotal);
    }
  };

  BundleBuilder.prototype.formatPrice = function(cents) {
    return '₹' + (cents / 100).toFixed(0);
  };

  BundleBuilder.prototype.triggerConfetti = function() {
    if (!this.confettiCanvas || !this.checkoutBtn) return;

    // Get checkout button position
    var buttonRect = this.checkoutBtn.getBoundingClientRect();
    var buttonCenterX = buttonRect.left + buttonRect.width / 2;
    var buttonCenterY = buttonRect.top + buttonRect.height / 2;

    this.confettiCanvas.classList.add('active');
    var ctx = this.confettiCanvas.getContext('2d');
    
    // Set canvas to full screen
    this.confettiCanvas.width = window.innerWidth;
    this.confettiCanvas.height = window.innerHeight;
    this.confettiCanvas.style.left = '0';
    this.confettiCanvas.style.right = '0';
    this.confettiCanvas.style.top = '0';
    this.confettiCanvas.style.bottom = '0';

    var confetti = [];
    var confettiCount = 100;
    var colors = ['#ff6b35', '#ffd700', '#4ecdc4', '#45b7d1', '#f9ca24', '#f0932b'];
    
    // Start confetti from checkout button center, blasting upward
    for (var i = 0; i < confettiCount; i++) {
      // Create particles that spread out from button center
      var angle = (Math.PI * 2 * i) / confettiCount + Math.random() * 0.5;
      var speed = Math.random() * 4 + 3;
      var spread = Math.random() * 30 - 15; // Random spread around button
      
      // Calculate velocity - particles go upward and outward
      var vx = Math.cos(angle) * speed * 0.5; // Horizontal spread
      var vy = -Math.abs(Math.sin(angle)) * speed - 3; // Upward velocity (negative Y)
      
      confetti.push({
        x: buttonCenterX + spread,
        y: buttonCenterY + spread,
        r: Math.random() * 6 + 4,
        d: Math.random() * confettiCount,
        color: colors[Math.floor(Math.random() * colors.length)],
        tilt: Math.floor(Math.random() * 10) - 10,
        tiltAngleIncrement: Math.random() * 0.07 + 0.05,
        tiltAngle: 0,
        vx: vx,
        vy: vy
      });
    }

    var self = this;
    var animationId;
    var animate = function() {
      ctx.clearRect(0, 0, self.confettiCanvas.width, self.confettiCanvas.height);

      confetti.forEach(function(c, i) {
        ctx.beginPath();
        ctx.lineWidth = c.r / 2;
        ctx.strokeStyle = c.color;
        ctx.moveTo(c.x + c.tilt + c.r, c.y);
        ctx.lineTo(c.x + c.tilt, c.y + c.tilt + c.r);
        ctx.stroke();

        c.tiltAngle += c.tiltAngleIncrement;
        // Update position with velocity
        c.y += c.vy + (Math.cos(c.d) + 3 + c.r / 2) / 2;
        c.x += c.vx + Math.sin(c.d);
        c.vy += 0.3; // Gravity (positive = downward)
        c.tilt = Math.sin(c.tiltAngle - i / 3) * 15;

        // Reset if particle goes off screen (below or above)
        if (c.y > self.confettiCanvas.height || c.y < -50 || c.x < -50 || c.x > self.confettiCanvas.width + 50) {
          // Don't reset - just let particles disappear naturally
          c.y = self.confettiCanvas.height + 100; // Move off screen
        }
      });

      animationId = requestAnimationFrame(animate);

      setTimeout(function() {
        cancelAnimationFrame(animationId);
        self.confettiCanvas.classList.remove('active');
        ctx.clearRect(0, 0, self.confettiCanvas.width, self.confettiCanvas.height);
      }, 3000);
    };

    animate();
  };

  BundleBuilder.prototype.updateCartAttributes = function() {
    var self = this;
    
    // Only update attributes if minimum products are selected
    if (this.selectedProducts.length < this.requiredProducts) {
      return;
    }
    
    // First, ensure only bundle products are in cart
    this.ensureOnlyBundleProductsInCart();
    
    // Calculate totals using bundle pricing
    var productCount = this.selectedProducts.length;
    var bundlePrice = this.bundlePrice;
    var requiredProducts = this.requiredProducts;
    
    var originalTotal = 0;
    this.selectedProducts.forEach(function(product) {
      originalTotal += product.price;
    });
    
    // Calculate bundle pricing
    var bundleCount = Math.floor(productCount / requiredProducts);
    var remainingProducts = productCount % requiredProducts;
    var bundleTotal = bundleCount * bundlePrice;
    var remainingTotal = 0;
    
    // Calculate price for remaining products (actual individual prices)
    for (var j = bundleCount * requiredProducts; j < productCount; j++) {
      remainingTotal += this.selectedProducts[j].price;
    }
    
    var finalTotal = bundleTotal + remainingTotal;
    var discountNeeded = originalTotal - finalTotal;
    
    var discountCode = this.section.dataset.discountCode;
    
    // Prepare cart update data
    var cartUpdateData = {
      note: 'Bundle Offer: ' + bundleCount + ' bundle(s) of ' + requiredProducts + ' products for ₹' + (bundlePrice / 100).toFixed(0) + (remainingProducts > 0 ? ' + ' + remainingProducts + ' individual product(s)' : ''),
      attributes: {
        '_bundle': 'true',
        '_bundle_section_id': this.sectionId,
        '_bundle_price': bundlePrice.toString(),
        '_bundle_count': bundleCount.toString(),
        '_remaining_products': remainingProducts.toString(),
        '_original_total': originalTotal.toString(),
        '_final_total': finalTotal.toString(),
        '_discount_needed': discountNeeded.toString()
      }
    };
    
    if (discountCode && discountCode.trim() !== '') {
      cartUpdateData.discount = discountCode.trim();
    }
    
    // Update cart attributes in background (non-blocking)
    fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(cartUpdateData)
    }).catch(function(err) {
      // Silently fail - not critical
    });
  };

  BundleBuilder.prototype.ensureOnlyBundleProductsInCart = function() {
    var self = this;
    
    // Get current cart
    fetch('/cart.js')
      .then(function(response) {
        return response.json();
      })
      .then(function(cart) {
        // Get all bundle product IDs
        var bundleProductIds = [];
        self.selectedProducts.forEach(function(product) {
          bundleProductIds.push(String(product.id));
        });
        
        // Find and remove non-bundle products
        var nonBundleItems = [];
        cart.items.forEach(function(item) {
          var itemProductId = String(item.product_id);
          var isBundleProduct = bundleProductIds.indexOf(itemProductId) !== -1;
          var hasBundleProperty = false;
          
          // Check if item has bundle property
          if (item.properties && item.properties._bundle_product === 'true') {
            hasBundleProperty = true;
          }
          
          if (!isBundleProduct && !hasBundleProperty) {
            nonBundleItems.push(item);
          }
        });
        
        // Remove non-bundle items
        if (nonBundleItems.length > 0) {
          var removePromises = [];
          nonBundleItems.forEach(function(item) {
            removePromises.push(
              fetch('/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  id: item.key,
                  quantity: 0
                })
              })
            );
          });
          
          Promise.all(removePromises).catch(function(error) {
            console.error('Error removing non-bundle products:', error);
          });
        }
      })
      .catch(function(error) {
        console.error('Error checking cart:', error);
      });
  };

  BundleBuilder.prototype.handleCheckout = function() {
    var self = this;
    
    if (this.selectedProducts.length < this.requiredProducts) {
      alert('Please select at least ' + this.requiredProducts + ' products to proceed.');
      return;
    }

    // Ensure cart attributes are up to date
    this.updateCartAttributes();
    
    // Show loader
    var loader = document.getElementById('btn-loader-' + this.sectionId);
    if (loader) {
      loader.style.display = 'block';
    }
    this.checkoutBtn.disabled = true;
    this.checkoutBtn.classList.add('disabled');
    
    // Small delay to ensure cart attributes are updated
    setTimeout(function() {
      // Hide loader
      if (loader) {
        loader.style.display = 'none';
      }
      
      // Trigger Gokwik checkout - cart already has products
      if (typeof onCheckoutClick === 'function') {
        onCheckoutClick(self.checkoutBtn);
      } else {
        window.location.href = '/checkout';
      }
    }, 200);
  };
})();
</script>

