}

.cart-upsell-title {
     font-weight: 600;
    font-size: 11px;
    color: rgb(0, 0, 0);
    margin-bottom: 6px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
    transition: color 0.2s 
ease;

display: -webkit-box; max-width: 200px; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
}

