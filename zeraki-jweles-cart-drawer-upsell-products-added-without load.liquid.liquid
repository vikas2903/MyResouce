  color: #000;
}

.cart-upsell-price-container {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-bottom: 6px;
}

.cart-upsell-price-wrapper {
  display: flex;
  align-items: baseline;
  gap: 6px;
  flex-wrap: wrap;
}

.cart-upsell-original-price {
  font-size: 11px;
  color: #aaa;
  text-decoration: line-through;
}

.cart-upsell-price {
  font-size: 14px;
