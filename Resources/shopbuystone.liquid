{%- comment -%}
  Section: Shop by stone (icons with labels)
  - Each block: image + label + URL
  - Desktop: items centered vertically
  - Mobile: items aligned flex-start
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <section class="shop-stone" data-section-id="{{ section.id }}">
    <div class="shop-stone__inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'stone' -%}
            {%- assign img = block.settings.image -%}
            {%- assign label = block.settings.label | strip -%}
            {%- assign url = block.settings.url -%}
            {%- if img != blank or label != blank -%}
              <a
                class="shop-stone__item"
                {% if url != blank %}href="{{ url }}"{% else %}role="link" aria-disabled="true"{% endif %}
                {{ block.shopify_attributes }}
              >
                <div class="shop-stone__imageWrap">
                  {%- if img != blank -%}
                    {{
                      img
                      | image_url: width: 260
                      | image_tag:
                        loading: 'lazy',
                        class: 'shop-stone__image',
                        alt: label
                    }}
                  {%- else -%}
                    <div class="shop-stone__image shop-stone__image--placeholder"></div>
                  {%- endif -%}
                </div>
                {%- if label != blank -%}
                  <div class="shop-stone__label">
                    {{ label | escape }}
                  </div>
                {%- endif -%}
              </a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </section>

  <style>
    .shop-stone {
      padding: {{ section.settings.padding_y }}px 0;
      background: {{ section.settings.bg }};
    }

    .shop-stone__inner {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      padding: 0 16px;
      display: flex;
      gap: 32px;
      justify-content: space-between;
      align-items: center; /* desktop: center vertically */
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .shop-stone__item {
      flex: 0 0 auto;
      text-align: center;
      text-decoration: none;
      color: {{ section.settings.text }};
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 8px 4px;
    }

    .shop-stone__item[aria-disabled="true"] {
      cursor: default;
      opacity: 0.7;
    }

    .shop-stone__imageWrap {
      width: {{ section.settings.image_size }}px;
      height: {{ section.settings.image_size }}px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .shop-stone__image {
      max-width: 100%;
      max-height: 100%;
      height: auto;
      width: auto;
      display: block;
      object-fit: contain;
    }

    .shop-stone__image--placeholder {
      border-radius: 999px;
      background: #f3f3f3;
    }

    .shop-stone__label {
      font: 500 14px/1.3 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      white-space: nowrap;
    }

    /* Mobile: align items flex-start vertically and allow more spacing */
    @media (max-width: 749px) {
      .shop-stone__inner {
        align-items: flex-start; /* mobile: flex-start */
        gap: 20px;
      }

      .shop-stone__label {
        font-size: 13px;
      }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Shop by stone",
  "settings": [
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 480,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text color",
      "default": "#333333"
    }
  ],
  "blocks": [
    {
      "type": "stone",
      "name": "Stone item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Coffin"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by stone",
      "blocks": [
        { "type": "stone" },
        { "type": "stone" },
        { "type": "stone" },
        { "type": "stone" }
      ]
    }
  ]
}
{% endschema %}
