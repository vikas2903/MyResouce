{% comment %}
  Bottom Navigation Bar - Mobile Only
  Include this in your theme.liquid file before </body> tag
  
  Usage: {% render 'bottom-navigation' %}
  
  Make sure to also include:
  - bottom-navigation.css (in assets folder or inline)
  - bottom-navigation.js (in assets folder or inline)
{% endcomment %}

<link rel="stylesheet" href="{{ 'bottom-navigation.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'bottom-navigation.css' | asset_url }}"></noscript>

<div class="bottom-navigation" id="bottomNavigation">
  <nav class="bottom-nav">
    <a href="/" class="nav-item" data-page="home">
      <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span class="nav-label">Home</span>
    </a>
    
    <a href="/collections/all" class="nav-item {% if template.name == 'collection' %}active{% endif %}" data-page="collection">
      <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
      </svg>
      <span class="nav-label">All Collection</span>
    </a>
    
    <a href="/search" class="nav-item {% if template.name == 'search' %}active{% endif %}" data-page="search">
      <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <span class="nav-label">Search</span>
    </a>
    
    <a href="/cart" class="nav-item {% if template.name == 'cart' %}active{% endif %}" data-page="cart">
      <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
      <span class="cart-plus-badge">+</span>
      <span class="cart-badge" id="cartBadge">{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
      <span class="nav-label">My Cart</span>
    </a>
    
    <a href="/account" class="nav-item {% if template.name == 'customers/account' or template.name == 'customers/login' or template.name == 'customers/register' %}active{% endif %}" data-page="profile">
      <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span class="nav-label">My Profile</span>
    </a>
  </nav>
</div>

<script src="{{ 'bottom-navigation.js' | asset_url }}" defer></script>
