{%- comment -%}
  Deal of the Day
  Renders only if a product in the "all" collection has the tag: deal_of_the_day
{%- endcomment -%}

<style>
/* Deal of the Day */
.dotd {
  padding: 18px 14px;
}

.dotd__wrap {
  max-width: 720px;
  margin: 0 auto;
}

.dotd__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.dotd__kicker {
  font: 600 12px/1.2 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #8a7a6d;
}

.dotd__sub {
  font: 600 12px/1.2 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  color: #3a332e;
}

.dotd__card {
  display: flex;
  gap: 14px;
  padding: 12px;
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.08);
}

.dotd__media {
  flex: 0 0 92px;
  width: 92px;
  height: 92px;
  border-radius: 14px;
  overflow: hidden;
  display: block;
  background: #f3f1ef;
}

.dotd__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.dotd__img--placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #ece7e2, #f7f5f3);
}

.dotd__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dotd__title {
  font: 700 14px/1.2 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  color: #1f1b17;
  text-decoration: none;
  margin-top: 2px;
  margin-bottom: 6px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dotd__priceRow {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 6px;
}

.dotd__price {
  font: 800 14px/1.2 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  color: #1f1b17;
}

.dotd__compare {
  font: 700 12px/1.2 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  color: #9b9187;
  text-decoration: line-through;
}

.dotd__badge {
  align-self: flex-start;
  font: 800 11px/1 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  color: #fff;
  background: #1f1b17;
  border-radius: 999px;
  padding: 6px 9px;
  margin-bottom: 10px;
}

.dotd__cta {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 36px;
  border-radius: 999px;
  background: #1f1b17;
  color: #fff;
  text-decoration: none;
  font: 800 13px/1 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
}

.dotd__cta:active {
  transform: translateY(1px);
}

@media (max-width: 420px) {
  .dotd__card {
    border-radius: 16px;
  }

  .dotd__media {
    flex-basis: 86px;
    width: 86px;
    height: 86px;
  }
}
</style>

{%- assign deal_tag = 'deal_of_the_day' -%}
{%- assign deal_product = blank -%}

{%- if collection and collection.products_count > 0 -%}
  {%- for product in collection.products -%}
    {%- if product.tags contains deal_tag -%}
      {%- assign deal_product = product -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if deal_product != blank -%}
  {%- assign price = deal_product.price -%}
  {%- assign compare = deal_product.compare_at_price -%}
  {%- assign off_pct = 0 -%}

  {%- if compare > price and compare > 0 -%}
    {%- assign off_pct = compare | minus: price | times: 100.0 | divided_by: compare | round -%}
  {%- endif -%}

  <section class="dotd" aria-label="Deal of the day">
    <div class="dotd__wrap">
      <div class="dotd__top">
        <div class="dotd__kicker">DEAL OF THE DAY</div>
        <div class="dotd__sub">Today Only</div>
      </div>

      <div class="dotd__card">
        <a
          class="dotd__media"
          href="{{ deal_product.url }}"
          aria-label="{{ deal_product.title | escape }}"
        >
          {%- if deal_product.featured_image != blank -%}
            {{
              deal_product.featured_image
              | image_url: width: 240
              | image_tag:
                class: 'dotd__img',
                loading: 'lazy',
                alt: deal_product.title
            }}
          {%- else -%}
            <div class="dotd__img dotd__img--placeholder"></div>
          {%- endif -%}
        </a>

        <div class="dotd__body">
          <a class="dotd__title" href="{{ deal_product.url }}">
            {{ deal_product.title | escape }}
          </a>

          <div class="dotd__priceRow">
            <div class="dotd__price">{{ price | money }}</div>
            {%- if compare > price -%}
              <div class="dotd__compare">{{ compare | money }}</div>
            {%- endif -%}
          </div>

          {%- if off_pct > 0 -%}
            <div class="dotd__badge">{{ off_pct }}% OFF</div>
          {%- endif -%}

          <a class="dotd__cta" href="{{ deal_product.url }}" data-dotd-cta>
            Grab Deal
          </a>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}
