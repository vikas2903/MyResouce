{% liquid
  assign selected_collection = section.settings.collection
  assign products = selected_collection.products
  assign products_count = selected_collection.products_count
%}

<section class="baariki-collection" data-section-id="{{ section.id }}">
  <div class="baariki-collection__inner">
    <header class="baariki-collection__header">
      <h2 class="baariki-collection__heading">{{ section.settings.heading }}</h2>

      {% if selected_collection != blank %}
        <a class="baariki-collection__link" href="{{ selected_collection.url }}">
          {{ section.settings.link_label }}
          <span aria-hidden="true">&#8594;</span>
        </a>
      {% endif %}
    </header>

    {% if selected_collection != blank and products_count > 0 %}
      <div class="baariki-collection__grid">
        {% for product in products limit: 2 %}
          {% assign product_alt = product.featured_image.alt | default: product.title %}
          <article class="baariki-product-card">
            <a class="baariki-product-card__image-link" href="{{ product.url }}">
              {% if product.featured_image != blank %}
                {{ product.featured_image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    widths: '540, 720, 980, 1200, 1400',
                    sizes: '(min-width: 750px) 50vw, 100vw',
                    class: 'baariki-product-card__image',
                    alt: product_alt
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'baariki-product-card__image baariki-product-card__image--placeholder' }}
              {% endif %}
            </a>

            <div class="baariki-product-card__details">
              <a class="baariki-product-card__title" href="{{ product.url }}">
                {{ product.title }}
              </a>
              <span class="baariki-product-card__price">
                {{ product.price | money }}
              </span>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p class="baariki-collection__empty">Select a collection to display products.</p>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    background: #101612;
  }

  #shopify-section-{{ section.id }} .baariki-collection {
    padding: 34px 24px 30px;
    background: #101612;
    color: #eee8da;
  }

  #shopify-section-{{ section.id }} .baariki-collection__inner {
    width: min(100%, 1088px);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .baariki-collection__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: 45px;
    border-top: 1px solid rgba(143, 164, 148, 0.18);
  }

  #shopify-section-{{ section.id }} .baariki-collection__heading {
    margin: -6px 0 0;
    color: #eee8da;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(32px, 3vw, 40px);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .baariki-collection__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    margin-top: 20px;
    padding-bottom: 9px;
    border-bottom: 1px solid rgba(194, 146, 74, 0.7);
    color: #eee8da;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .baariki-collection__link:hover {
    color: #d69a4d;
  }

  #shopify-section-{{ section.id }} .baariki-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 33px;
  }

  #shopify-section-{{ section.id }} .baariki-product-card__image-link {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #262b27;
  }

  #shopify-section-{{ section.id }} .baariki-product-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  #shopify-section-{{ section.id }} .baariki-product-card__image-link:hover .baariki-product-card__image {
    transform: scale(1.025);
  }

  #shopify-section-{{ section.id }} .baariki-product-card__details {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    padding-top: 17px;
  }

  #shopify-section-{{ section.id }} .baariki-product-card__title,
  #shopify-section-{{ section.id }} .baariki-product-card__price {
    color: #eee8da;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 16px;
    line-height: 1.25;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .baariki-product-card__title {
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .baariki-product-card__price {
    flex-shrink: 0;
    color: #b8b7a8;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .baariki-collection__empty {
    margin: 0;
    color: #b2b8ae;
    font: 16px/1.6 Arial, Helvetica, sans-serif;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .baariki-collection {
      padding: 24px 20px 38px;
    }

    #shopify-section-{{ section.id }} .baariki-collection__header {
      display: block;
      padding-bottom: 30px;
    }

    #shopify-section-{{ section.id }} .baariki-collection__heading {
      margin-top: 0;
      font-size: 32px;
    }

    #shopify-section-{{ section.id }} .baariki-collection__link {
      margin-top: 22px;
    }

    #shopify-section-{{ section.id }} .baariki-collection__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    #shopify-section-{{ section.id }} .baariki-product-card__details {
      padding-top: 13px;
    }
  }
</style>

{% schema %}
{
  "name": "Baariki collection products",
  "tag": "section",
  "class": "section-baariki-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The rest of Baariki"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Collection link label",
      "default": "View the collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Baariki collection products"
    }
  ]
}
{% endschema %}
