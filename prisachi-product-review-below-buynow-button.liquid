{% assign prisachi_reviews = product.metafields.custom.prisachi_product_review.value %}

{% if prisachi_reviews != blank %}
  <div class="prisachi-product-reviews" data-prisachi-product-reviews>
    <h3 class="head">Trusted by 31,000+ Happy Customers</h3>
    <div class="testimonial-slider">
      <div class="testimonial-track">
        {% for review in prisachi_reviews %}
          {% assign review_title = review.title.value | default: review.title %}
          {% assign review_rating = review.rating.value | default: review.rating %}
          {% assign review_description = review.description.value | default: review.description %}
          {% assign reviewer_name = review.reviewer_name.value | default: review.reviewer_name %}
          {% assign reviewer_image = review.reviewer_image.value | default: review.reviewer_image %}
          {% assign numeric_rating = review_rating | plus: 0 %}
          {% assign full_stars = numeric_rating | round: 0 %}

          <div class="testimonial-card">
            {% if reviewer_image != blank %}
              <img
                class="user-img"
                src="{{ reviewer_image | image_url: width: 160 }}"
                alt="{{ reviewer_name | default: review_title | escape }}"
                width="72"
                height="72"
              >
            {% endif %}

            <div class="testimonial-content">
              {% if review_title != blank %}
                <div class="testimonial-header">
                  <h3>{{ review_title }}</h3>
                </div>
              {% endif %}

              {% if review_rating != blank %}
                <div class="testimonial-rating">
                  <span class="testimonial-rating__value">{{ review_rating }}/5</span>
                  <div class="testimonial-rating__stars" aria-hidden="true">
                    {% for i in (1..5) %}
                      <svg
                        viewBox="0 0 24 24"
                        class="testimonial-rating__star{% if i > full_stars %} testimonial-rating__star--empty{% endif %}">
                        <path
                          d="M12 2.75l2.84 5.75 6.35.92-4.59 4.47 1.08 6.33L12 17.24l-5.68 2.98 1.08-6.33L2.81 9.42l6.35-.92L12 2.75Z"
                          fill="currentColor"></path>
                      </svg>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}

              {% if review_description != blank %}
                <p>{{ review_description }}</p>
              {% endif %}

              {% if reviewer_name != blank %}
                <span class="testimonial-author">{{ reviewer_name }}</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

<style>
    .zeraki-trust-strip {
      max-width: 900px;
      margin: 0 0 16px;
      padding: 20px 24px 18px;
      border-radius: 16px;
      background: linear-gradient(180deg, #fffefe 0%, #fff8fb 100%);
      border: 1px solid #f2e9ee;
      box-shadow: 0 8px 18px rgba(78, 50, 59, 0.06);
    }

    .zeraki-trust-strip__heading {
      margin: 0 0 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      color: #221c1f;
      font-size: 16px;
      line-height: 1.2;
      font-weight: 700;
      text-align: center;
    }

    .zeraki-trust-strip__heart {
      color: #f1628d;
      font-size: 14px;
      line-height: 1;
    }

    .zeraki-trust-strip__body {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) auto auto;
      align-items: center;
      column-gap: 28px;
    }

    .zeraki-trust-strip__avatars {
      display: flex;
      align-items: center;
      padding-left: 4px;
    }

    .zeraki-trust-strip__avatar {
      width: 54px;
      height: 54px;
      border-radius: 999px;
      object-fit: cover;
      border: 3px solid #fff;
      box-shadow: 0 6px 12px rgba(61, 31, 42, 0.12);
      margin-left: -12px;
      background: #eed8df;
    }

    .zeraki-trust-strip__avatar:first-child {
      margin-left: 0;
    }

    .zeraki-trust-strip__summary {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 110px;
      text-align: center;
    }

    .zeraki-trust-strip__rating {
      color: #171416;
      font-size: 18px;
      line-height: 1;
      font-weight: 700;
    }

    .zeraki-trust-strip__caption {
      margin-top: 6px;
      color: #3c3538;
      font-size: 14px;
      line-height: 1.2;
      font-weight: 600;
    }

    .zeraki-trust-strip__stars {
      display: flex;
      align-items: center;
      gap: 4px;
      color: #ffbf1d;
    }

    .zeraki-trust-strip__star {
      width: 24px;
      height: 24px;
      flex: 0 0 24px;
      display: block;
    }

    .testimonial-slider {
      max-width: 900px;
      overflow: hidden;
      border-bottom: 1px solid #ddd;
      padding-bottom: 10px;
    }

    h3.head {
      color: #6c4800;
      font-size: 18px;
      font-style: italic;
      font-weight: 600;
      line-height: 160%;
      margin-bottom: 0.4rem;
    }

    .testimonial-track {
      display: flex;
      transition: transform 0.6s ease;
    }

    .testimonial-card {
      min-width: 100%;
      display: flex;
      align-items: flex-start;
      gap: 15px;
      padding: 5px;
    }

    .user-img {
      width: 72px;
      height: 72px;
      object-fit: cover;
      aspect-ratio: 1 / 1;
      border-radius: 999px;
      flex: 0 0 72px;
    }

    .testimonial-content {
      flex: 1 1 auto;
    }

    .testimonial-header {
      display: flex;
      align-items: center;
      margin-bottom: 6px;
    }

    .testimonial-header h3 {
      font-size: 14px;
      margin: 0;
      font-weight: 700;
      color: #221c1f;
    }

    .testimonial-rating {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
    }

    .testimonial-rating__value {
      color: #171416;
      font-size: 13px;
      line-height: 1;
      font-weight: 700;
    }

    .testimonial-rating__stars {
      display: flex;
      align-items: center;
      gap: 2px;
      color: #ffbf1d;
    }

    .testimonial-rating__star {
      width: 14px;
      height: 14px;
      flex: 0 0 14px;
      display: block;
    }

    .testimonial-rating__star--empty {
      color: #e5d8bf;
    }

    .testimonial-content p {
      font-size: 12px;
      line-height: 1.6;
      margin: 0;
      color: #3a3437;
    }

    .testimonial-author {
      display: inline-block;
      margin-top: 8px;
      font-size: 12px;
      line-height: 1.2;
      font-weight: 600;
      color: #6c4800;
    }

    @media(max-width:767px){

      h3.head {
      color: #6c4800;
      font-size: 16px;
      font-style: italic;
      font-weight: 600;
      line-height: 160%;
      margin-bottom: 0.4rem;
      margin-top: 6px;
  }
    }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const reviewSection = document.querySelector('[data-prisachi-product-reviews]');

    if (!reviewSection) return;

    let index = 0;
    const track = reviewSection.querySelector('.testimonial-track');
    const slides = reviewSection.querySelectorAll('.testimonial-card');

    if (!track || slides.length <= 1) return;

    setInterval(function () {
      index++;
      if (index >= slides.length) index = 0;
      track.style.transform = 'translateX(-' + index * 100 + '%)';
    }, 3500);
  });
</script>



