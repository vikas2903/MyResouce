{% assign testimonial_id = 'markleute-testimonials-' | append: section.id %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css">

<section id="{{ testimonial_id }}" class="markleute-testimonials">
  <div class="markleute-testimonials__inner">
    <header class="markleute-testimonials__header">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.review_summary != blank %}
        <p>{{ section.settings.review_summary | escape }}</p>
      {% endif %}
    </header>

    <div class="splide markleute-testimonials__slider" aria-label="Customer testimonials">
      <div class="splide__track">
        <ul class="splide__list">
          {% for block in section.blocks %}
            {% capture demo_image %}https://images.unsplash.com/photo-{% cycle '1558618666-fcd25c85cd64', '1610030469983-98e550d6193c', '1603252109303-2751441dd157', '1583391733956-6c78276477e2', '1608234807905-4466023792f5' %}?auto=format&fit=crop&w=900&q=85{% endcapture %}
            <li class="splide__slide" {{ block.shopify_attributes }}>
              <article class="markleute-testimonials__card">
                <div class="markleute-testimonials__image-wrap">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 900 | image_tag: class: 'markleute-testimonials__image', loading: 'lazy', widths: '350, 500, 700, 900', alt: block.settings.customer_name }}
                  {% else %}
                    <img class="markleute-testimonials__image" src="{{ demo_image | strip }}" alt="Customer review from {{ block.settings.customer_name | escape }}" loading="lazy" width="900" height="900">
                  {% endif %}
                </div>
                <div class="markleute-testimonials__rating" aria-label="{{ block.settings.rating }} out of 5 stars">
                  {% for star in (1..5) %}
                    <span class="{% if star > block.settings.rating %}is-empty{% endif %}">★</span>
                  {% endfor %}
                </div>
                <div class="markleute-testimonials__content">
                  <h3>{{ block.settings.customer_name | escape }}</h3>
                  <p>{{ block.settings.review | escape | newline_to_br }}</p>
                </div>
              </article>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  #{{ testimonial_id }} { padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px; background: {{ section.settings.background }}; color: {{ section.settings.text_color }}; }
  #{{ testimonial_id }} .markleute-testimonials__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
  #{{ testimonial_id }} .markleute-testimonials__header { margin-bottom: 30px; text-align: center; }
  #{{ testimonial_id }} .markleute-testimonials__header h2 { margin: 0; font-size: clamp(27px, 3vw, 42px); font-weight: 700; letter-spacing: -.03em; line-height: 1.15; }
  #{{ testimonial_id }} .markleute-testimonials__header p { margin: 8px 0 0; font-size: 14px; font-weight: 500; letter-spacing: .02em; }
  #{{ testimonial_id }} .splide__track { padding: 0 4px 12px; }
  #{{ testimonial_id }} .splide__slide { height: auto; padding: 0 6px; }
  #{{ testimonial_id }} .markleute-testimonials__card { position: relative; height: 100%; min-height: 500px; overflow: hidden; border: 1px solid #161616; border-radius: 2px; background: #fff; color: #111; box-shadow: 0 7px 18px rgba(0, 0, 0, .09); }
  #{{ testimonial_id }} .markleute-testimonials__image-wrap { height: 315px; background: #e8e8e8; }
  #{{ testimonial_id }} .markleute-testimonials__image { display: block; width: 100%; height: 100%; object-fit: cover; }
  #{{ testimonial_id }} .markleute-testimonials__rating { position: absolute; z-index: 1; top: 292px; left: 50%; display: flex; gap: 2px; min-width: 130px; justify-content: center; padding: 8px 16px; border: 1px solid #111; border-radius: 999px; background: #111; color: #fff; box-shadow: 0 5px 12px rgba(0,0,0,.18); transform: translateX(-50%); font-size: 18px; line-height: 1; }
  #{{ testimonial_id }} .markleute-testimonials__rating .is-empty { color: #777; }
  #{{ testimonial_id }} .markleute-testimonials__content { padding: 34px 22px 28px; text-align: center; }
  #{{ testimonial_id }} .markleute-testimonials__content h3 { margin: 0 0 14px; font-size: 18px; font-weight: 700; line-height: 1.2; }
  #{{ testimonial_id }} .markleute-testimonials__content p { margin: 0; font-size: 15px; font-weight: 400; line-height: 1.6; }
  #{{ testimonial_id }} .splide__arrow { width: 42px; height: 42px; border: 1px solid #111; background: #fff; opacity: 1; box-shadow: 0 3px 9px rgba(0,0,0,.14); }
  #{{ testimonial_id }} .splide__arrow svg { fill: #111; }
  #{{ testimonial_id }} .splide__arrow--prev { left: -20px; }
  #{{ testimonial_id }} .splide__arrow--next { right: -20px; }
  #{{ testimonial_id }} .splide__pagination { bottom: -21px; }
  #{{ testimonial_id }} .splide__pagination__page { width: 7px; height: 7px; margin: 4px; background: #777; opacity: .65; }
  #{{ testimonial_id }} .splide__pagination__page.is-active { background: #111; opacity: 1; transform: scale(1); }
  @media screen and (max-width: 989px) {
    #{{ testimonial_id }} .markleute-testimonials__image-wrap { height: 290px; }
    #{{ testimonial_id }} .markleute-testimonials__rating { top: 267px; }
  }
  @media screen and (max-width: 749px) {
    #{{ testimonial_id }} { padding: {{ section.settings.padding_top | at_most: 48 }}px 16px {{ section.settings.padding_bottom | at_most: 48 }}px; }
    #{{ testimonial_id }} .markleute-testimonials__header { margin-bottom: 22px; }
    #{{ testimonial_id }} .markleute-testimonials__header h2 { font-size: 28px; }
    #{{ testimonial_id }} .markleute-testimonials__header p { font-size: 13px; }
    #{{ testimonial_id }} .splide__slide { padding: 0 2px; }
    #{{ testimonial_id }} .markleute-testimonials__card { min-height: 470px; }
    #{{ testimonial_id }} .markleute-testimonials__image-wrap { height: 275px; }
    #{{ testimonial_id }} .markleute-testimonials__rating { top: 252px; }
    #{{ testimonial_id }} .markleute-testimonials__content { padding: 33px 20px 25px; }
    #{{ testimonial_id }} .splide__arrow { width: 36px; height: 36px; }
    #{{ testimonial_id }} .splide__arrow--prev { left: -8px; }
    #{{ testimonial_id }} .splide__arrow--next { right: -8px; }
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>
<script>
  (function () {
    var slider = document.querySelector('#{{ testimonial_id }} .markleute-testimonials__slider');
    if (!slider || !window.Splide || slider.classList.contains('is-initialized')) return;

    new Splide(slider, {
      type: {{ section.blocks.size }} > 4 ? 'loop' : 'slide',
      perPage: 4,
      perMove: 1,
      gap: 8,
      pagination: true,
      arrows: true,
      speed: 650,
      breakpoints: {
        989: { perPage: 2, gap: 8 },
        749: { perPage: 1, gap: 8, padding: { left: '8px', right: '8px' } }
      }
    }).mount();
  })();
</script>

{% schema %}
{
  "name": "Markleute testimonials",
  "tag": "section",
  "class": "section-markleute-testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our customers love us" },
    { "type": "text", "id": "review_summary", "label": "Review summary", "default": "4.8 star based on 13,482 reviews" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f7f7f7" },
    { "type": "color", "id": "text_color", "label": "Heading color", "default": "#111111" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 900, "max": 1800, "step": 20, "default": 1440, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 100, "step": 4, "default": 32, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 100, "step": 4, "default": 32, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer image" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "customer_name", "label": "Customer name", "default": "Customer name" },
        { "type": "textarea", "id": "review", "label": "Review", "default": "Beautiful quality and a lovely shopping experience." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Markleute testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "customer_name": "Ananya", "review": "The quality feels premium and the fit is exactly as expected." } },
        { "type": "testimonial", "settings": { "customer_name": "Meera", "review": "Beautiful piece, thoughtfully packed and delivered with care." } },
        { "type": "testimonial", "settings": { "customer_name": "Renu", "review": "Lovely style and fabric. I am very happy with my purchase." } },
        { "type": "testimonial", "settings": { "customer_name": "Jaya D.", "review": "Comfortable, elegant and truly worth adding to my wardrobe." } },
        { "type": "testimonial", "settings": { "customer_name": "Simran", "review": "A wonderful experience from order to delivery." } }
      ]
    }
  ]
}
{% endschema %}
