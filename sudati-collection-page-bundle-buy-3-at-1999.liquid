<!-- Load JavaScript -->
<script>
  // Worriorworld Bundle Builder JavaScript
  (function () {
    'use strict';

    // Initialize bundle builder when DOM is ready
    document.addEventListener('DOMContentLoaded', function () {
      const bundleSections = document.querySelectorAll('.worriorworld-bundle-section');
      bundleSections.forEach((section) => {
        new WorriorworldBundle(section);
      });
    });

    class WorriorworldBundle {
      constructor(sectionElement) {
        this.section = sectionElement;
        this.sectionId = sectionElement.id.replace('worriorworld-bundle-', '');
        this.selectedProducts = [];
        this.maxProducts = parseInt(sectionElement.dataset.maxProducts) || 2;
        this.offerProducts = parseInt(sectionElement.dataset.offerProducts) || 2; // Number of products required for the offer
        this.bundlePrice = parseInt(sectionElement.dataset.bundlePrice) || 999; // Price in rupees

        // Initialize
        this.init();
      }

      init() {
        this.bottomBar = this.section.querySelector(`#worriorworld-bottom-bar-${this.sectionId}`);
        this.selectedItemsContainer = this.section.querySelector(`#worriorworld-selected-items-${this.sectionId}`);
        this.emptySlotsContainer = this.section.querySelector(`#worriorworld-empty-slots-${this.sectionId}`);
        this.originalTotal = this.section.querySelector(`#worriorworld-original-total-${this.sectionId}`);
        this.offerTotal = this.section.querySelector(`#worriorworld-offer-total-${this.sectionId}`);
        this.saveAmount = this.section.querySelector(`#worriorworld-save-${this.sectionId}`);
        this.checkoutBtn = this.section.querySelector('[data-gokwik-bundle-checkout]');
        this.gokwikCheckout = this.section.querySelector('.worriorworld-gokwik-checkout');
        this.partyPopper = this.section.querySelector(`#worriorworld-party-popper-${this.sectionId}`);
        this.offerInfo = this.section.querySelector(`#worriorworld-offer-info-${this.sectionId}`);
        this.productsGrid = this.section.querySelector(`#worriorworld-products-${this.sectionId}`);
        this.infiniteLoader = this.section.querySelector(`#worriorworld-infinite-loader-${this.sectionId}`);

        // Infinite scroll variables
        this.currentPage = 2; // Start from page 2 since page 1 (first 20) are already loaded
        this.productsPerPage = 20; // Load 20 products per scroll
        this.isLoading = false;
        this.loadedProductIds = new Set(); // Track loaded product IDs to avoid duplicates
        this.useJSONAPI = true; // Use JSON API from start (more reliable than HTML pagination)

        // Get total products count
        const totalProducts = parseInt(this.productsGrid.dataset.totalProducts) || 0;
        const initialCount = parseInt(this.productsGrid.dataset.initialCount) || 20;
        // Enable infinite scroll if there are more products than initially loaded
        this.hasMoreProducts = totalProducts > initialCount;

        // Store IDs of initially loaded products
        this.productsGrid.querySelectorAll('.worriorworld-product-card').forEach((card) => {
          const productId = card.getAttribute('data-product-id');
          if (productId) {
            this.loadedProductIds.add(productId);
          }
        });

        console.log('Initial products loaded:', this.loadedProductIds.size);

        // Get collection handle - try multiple methods (prioritize data attribute)
        this.collectionHandle = '';

        // Method 1: From data attribute on section (most reliable)
        if (this.section && this.section.dataset.collectionHandle) {
          this.collectionHandle = this.section.dataset.collectionHandle;
        }

        // Method 2: From global collection object
        if (!this.collectionHandle && typeof collection !== 'undefined' && collection && collection.handle) {
          this.collectionHandle = collection.handle;
        }

        // Method 3: From URL
        if (!this.collectionHandle) {
          const collectionUrl = window.location.pathname;
          const collectionMatch = collectionUrl.match(/\/collections\/([^\/\?]+)/);
          if (collectionMatch) {
            this.collectionHandle = collectionMatch[1];
          }
        }

        // Method 4: Try to extract from current page context
        if (!this.collectionHandle) {
          const metaCollection = document.querySelector('meta[property="product:collection"]');
          if (metaCollection && metaCollection.content) {
            this.collectionHandle = metaCollection.content;
          }
        }

        console.log('Infinite scroll setup:', {
          collectionHandle: this.collectionHandle,
          totalProducts: totalProducts,
          hasMore: this.hasMoreProducts,
        });

        // Flag to track if cart has been cleared on this page load
        this.cartClearedOnLoad = false;

        // Clear cart when page loads (only once)
        this.clearCartOnLoad();

        // Quick view elements
        this.quickViewModal = this.section.querySelector(`#worriorworld-quick-view-modal-${this.sectionId}`);
        this.quickViewButtons = this.section.querySelectorAll('.worriorworld-quick-view-btn');
        this.currentProduct = null;
        this.currentVariant = null;
        this.productImages = [];
        this.currentImageIndex = 0;

        // Variant drawer elements
        this.variantDrawer = this.section.querySelector(`#worriorworld-variant-drawer-${this.sectionId}`);
        this.variantDrawerBody = this.section.querySelector(`#variant-drawer-body-${this.sectionId}`);
        this.variantDrawerTitle = this.section.querySelector(`#variant-drawer-title-${this.sectionId}`);
        this.variantDrawerPrice = this.section.querySelector(`#variant-drawer-price-${this.sectionId}`);
        this.variantDrawerAddBtn = this.section.querySelector(`#variant-drawer-add-btn-${this.sectionId}`);
        this.currentProductForVariant = null;
        this.selectedVariant = null;

        // Every product in this offer has one default variant, so card buttons add directly.
        // The variant drawer is never opened by a product-card button.
        this.addButtons = this.section.querySelectorAll('.worriorworld-direct-add-btn');
        this.addButtons.forEach((btn) => {
          btn.dataset.directAddInitialized = 'true';
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            this.handleAddButtonClick(e);
          });
        });

        // GoKwik checkout runs through the existing global onCheckoutClick(button) function.
        // The button is unlocked only after the customer selects the required three products.
        this.updateGoKwikButtonState();

        // Quick view button listeners
        this.quickViewButtons.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const productHandle = btn.dataset.productHandle;
            this.openQuickView(productHandle);
          });
        });

        // Make entire product card clickable to open quick view
        this.setupProductCardClicks();

        // Quick view modal close listeners
        if (this.quickViewModal) {
          const closeBtn = this.quickViewModal.querySelector('.worriorworld-quick-view-close');
          const overlay = this.quickViewModal.querySelector('.worriorworld-quick-view-overlay');

          if (closeBtn) {
            closeBtn.addEventListener('click', () => this.closeQuickView());
          }

          if (overlay) {
            overlay.addEventListener('click', () => this.closeQuickView());
          }

          // Close on ESC key
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !this.quickViewModal.hasAttribute('hidden')) {
              this.closeQuickView();
            }
          });
        }

        // Initial UI update
        this.updateUI();

        // Start cart monitoring to keep cart in sync
        this.startCartMonitoring();

        // Initialize infinite scroll - will load more products as user scrolls
        this.initInfiniteScroll();
      }

      // Clear cart when page loads
      async clearCartOnLoad() {
        // Only clear once per page load
        if (this.cartClearedOnLoad) return;

        try {
          // Get current cart
          const cartResponse = await fetch('/cart.js');
          if (!cartResponse.ok) return;

          const cart = await cartResponse.json();

          // If cart has items, clear them all
          if (cart.items && cart.items.length > 0) {
            const clearPromises = cart.items.map((item) =>
              fetch('/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  id: item.key,
                  quantity: 0,
                }),
              })
            );

            await Promise.all(clearPromises);

            // Reset selected products array
            this.selectedProducts = [];

            // Update UI
            this.updateUI();

            // Dispatch cart updated event
            document.dispatchEvent(new CustomEvent('cart:updated'));
          }

          this.cartClearedOnLoad = true;
        } catch (error) {
          console.error('Error clearing cart on load:', error);
        }
      }

      // Monitor cart to keep it in sync with selected products
      startCartMonitoring() {
        this.isUpdatingCart = false;
        this.isAddingProduct = false;

        // Function to sync cart with selected products
        this.syncCartWithSelection = async () => {
          // Don't sync if we're currently adding/removing products or updating cart
          if (this.isUpdatingCart || this.isAddingProduct) return;

          try {
            const cartResponse = await fetch('/cart.js');
            if (!cartResponse.ok) return;

            const cart = await cartResponse.json();

            // Don't sync if we're in the middle of an operation
            if (this.isUpdatingCart || this.isAddingProduct) return;

            const cartVariantIds = cart.items.map((item) => String(item.variant_id));
            const selectedVariantIds = this.selectedProducts.map((p) => String(p.variantId));

            // Find items in cart that are not in selected products
            const itemsToRemove = cart.items.filter((item) => {
              const variantId = String(item.variant_id);
              return !selectedVariantIds.includes(variantId);
            });

            // Remove items that shouldn't be in cart
            if (itemsToRemove.length > 0) {
              this.isUpdatingCart = true;
              const removePromises = itemsToRemove.map((item) =>
                fetch('/cart/change.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    id: item.key,
                    quantity: 0,
                  }),
                })
              );

              await Promise.all(removePromises);
              this.isUpdatingCart = false;

              // Dispatch cart updated event
              document.dispatchEvent(new CustomEvent('cart:updated'));
            }
          } catch (error) {
            console.error('Error syncing cart:', error);
            this.isUpdatingCart = false;
          }
        };

        // Monitor cart periodically (less frequent to avoid interference)
        setInterval(() => {
          if (!this.isAddingProduct && !this.isUpdatingCart) {
            this.syncCartWithSelection();
          }
        }, 2000); // Check every 2 seconds

        // Also monitor on cart drawer/toggle events
        document.addEventListener('cart:updated', () => {
          if (!this.isAddingProduct && !this.isUpdatingCart) {
            setTimeout(() => {
              this.syncCartWithSelection();
            }, 1000);
          }
        });
      }

      handleAddButtonClick(e) {
        e.preventDefault();
        const btn = e.currentTarget || e.target.closest('.worriorworld-add-btn, .worriorworld-choose-variant-btn');

        if (!btn) {
          console.error('Bundle action button was not found.');
          return;
        }

        // Check if button is disabled
        if (btn.disabled) {
          return;
        }

        const productCard = btn.closest('.worriorworld-product-card');
        const productId = btn.dataset.productId;
        const variantId = btn.dataset.variantId;
        const price = parseInt(btn.dataset.price);
        const title = btn.dataset.title;
        const image = btn.dataset.image;

        // Validate data attributes
        if (!productId || !variantId) {
          console.error('Missing product data:', { productId, variantId, btn });
          alert('Product information is missing. Please refresh the page.');
          return;
        }

        const productData = {
          id: String(productId),
          variantId: String(variantId),
          price: (price || 0) / 100, // Convert cents to rupees
          title: title || 'Product',
          image: image || '',
        };

        // Check if product is already selected
        const isAlreadySelected = this.selectedProducts.some(
          (p) => String(p.id) === String(productData.id) && String(p.variantId) === String(productData.variantId)
        );

        // If already selected, remove it
        if (isAlreadySelected) {
          this.removeProduct(productData);
          return;
        }

        // Check maximum limit
        if (this.selectedProducts.length >= this.maxProducts) {
          alert(`You can only add ${this.maxProducts} products to this bundle.`);
          return;
        }

        // Add product to cart
        this.addProductToCart(productData, btn, productCard);
      }

      async addProductToCart(productData, btn, productCard) {
        const actionBtn = btn || null;
        const actionBtnText = actionBtn ? actionBtn.querySelector('.worriorworld-btn-text') : null;
        const originalText = actionBtnText
          ? actionBtnText.textContent
          : actionBtn
          ? actionBtn.textContent.trim()
          : 'ADD TO CART';

        try {
          // Set flag to prevent cart monitoring from interfering
          this.isAddingProduct = true;

          // Disable button during add
          if (actionBtn) {
            actionBtn.disabled = true;
          }
          if (actionBtnText) {
            actionBtnText.textContent = 'ADDING...';
          } else if (actionBtn) {
            actionBtn.textContent = 'ADDING...';
          }

          // Validate variant ID
          if (!productData.variantId || productData.variantId === 'undefined' || productData.variantId === 'null') {
            throw new Error('Invalid product variant ID');
          }

          console.log('Adding product to cart:', {
            variantId: productData.variantId,
            productId: productData.id,
            title: productData.title,
          });

          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: String(productData.variantId),
              quantity: 1,
            }),
          });

          let data;
          try {
            data = await response.json();
          } catch (jsonError) {
            console.error('Failed to parse JSON response:', jsonError);
            const text = await response.text();
            console.error('Response text:', text);
            throw new Error('Invalid response from server. Please try again.');
          }

          console.log('Cart add response:', data);

          // Check for errors in response - Shopify can return 200 with errors
          if (!response.ok || data.status === 422 || data.error || data.message || data.description) {
            const errorMessage = data.message || data.description || data.error || 'Failed to add product to cart';
            console.error('Cart add error details:', {
              status: response.status,
              statusText: response.statusText,
              data: data,
            });
            throw new Error(errorMessage);
          }

          // Success - verify we got valid data
          if (!data || (data.items && data.items.length === 0)) {
            console.warn('Cart add returned empty or invalid data:', data);
            // Still proceed if we got a response, might be valid
          }

          // Add to selected products
          this.selectedProducts.push(productData);

          // Update button state with animation
          if (actionBtnText) {
            actionBtnText.textContent = 'ADDED';
          } else if (actionBtn) {
            actionBtn.textContent = 'ADDED';
          }
          if (actionBtn) {
            actionBtn.classList.add('added');
            actionBtn.disabled = false;
          }
          if (productCard) {
            productCard.classList.add('selected');

            // Add product card animation
            productCard.style.animation = 'productCardAdded 0.6s ease-out';
            setTimeout(() => {
              productCard.style.animation = '';
            }, 600);
          }

          // Update UI
          this.updateUI();

          // Trigger party popper when offer product count is reached
          if (this.selectedProducts.length === this.offerProducts) {
            this.triggerPartyPopper();
          }

          // Dispatch cart updated event
          document.dispatchEvent(new CustomEvent('cart:updated'));

          // Close quick view if product was added from quick view modal
          const isFromQuickView =
            btn &&
            (btn.closest('.worriorworld-quick-view-modal') ||
              btn.dataset.fromQuickView === 'true' ||
              btn.classList.contains('worriorworld-quick-view-add-btn'));

          if (isFromQuickView) {
            setTimeout(() => {
              this.closeQuickView();
            }, 300); // Small delay to show the success state
          }

          // Reset flag
          this.isAddingProduct = false;
        } catch (error) {
          console.error('Error adding product to cart:', error);
          console.error('Product data:', productData);
          console.error('Error stack:', error.stack);

          // Show more specific error message
          let errorMessage = 'Error adding product to cart. Please try again.';
          if (error.message) {
            errorMessage = error.message;
            // Make error messages more user-friendly
            if (errorMessage.toLowerCase().includes('sold out') || errorMessage.toLowerCase().includes('unavailable')) {
              errorMessage = 'This product is currently unavailable.';
            } else if (errorMessage.toLowerCase().includes('variant')) {
              errorMessage = 'Product variant not available. Please try another product.';
            }
          }

          alert(errorMessage);
          if (actionBtn) {
            actionBtn.disabled = false;
            actionBtn.classList.remove('added');
            if (actionBtnText) {
              actionBtnText.textContent = originalText;
            } else {
              actionBtn.textContent = originalText;
            }
          }

          // Reset flag
          this.isAddingProduct = false;
        }
      }

      removeProduct(productData) {
        // Set flag to prevent cart monitoring from interfering
        this.isUpdatingCart = true;

        // Find and remove from selected products
        const index = this.selectedProducts.findIndex(
          (p) => String(p.id) === String(productData.id) && String(p.variantId) === String(productData.variantId)
        );

        if (index === -1) {
          this.isUpdatingCart = false;
          return;
        }

        // Remove from cart
        fetch('/cart.js')
          .then((res) => res.json())
          .then((cart) => {
            const cartItem = cart.items.find((item) => String(item.variant_id) === String(productData.variantId));

            if (cartItem) {
              return fetch('/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: cartItem.key, quantity: 0 }),
              });
            }
          })
          .then(() => {
            this.selectedProducts.splice(index, 1);

            // Update button state
            const btn = this.section.querySelector(
              `.worriorworld-direct-add-btn[data-variant-id="${productData.variantId}"]`
            );
            if (btn) {
              const btnText = btn.querySelector('.worriorworld-btn-text');
              if (btnText) {
                btnText.textContent = 'ADD TO CART';
              }
              btn.classList.remove('added');
              btn.disabled = false;
            }

            // Update product card
            const productCard = this.section.querySelector(`[data-product-id="${productData.id}"]`);
            if (productCard) {
              productCard.classList.remove('selected');
            }

            // Update UI
            this.updateUI();

            // Dispatch cart updated event
            document.dispatchEvent(new CustomEvent('cart:updated'));

            // Reset flag
            this.isUpdatingCart = false;
          })
          .catch((err) => {
            console.error('Error removing product:', err);
            this.isUpdatingCart = false;
          });
      }

      updateUI() {
        // Update bottom bar visibility
        if (this.selectedProducts.length > 0) {
          this.bottomBar.classList.add('visible');
        } else {
          this.bottomBar.classList.remove('visible');
        }

        // Update selected products display
        this.updateSelectedProductsDisplay();

        // Update totals
        this.updateTotals();

        // Update button states
        this.updateButtonStates();

        // Enable GoKwik only when this Buy Any 3 for ₹1999 bundle is complete.
        this.updateGoKwikButtonState();

        // Update offer info message
        this.updateOfferInfo();
      }

      updateOfferInfo() {
        if (!this.offerInfo) return;

        const selectedCount = this.selectedProducts.length;
        const requiredCount = this.offerProducts;
        const remaining = requiredCount - selectedCount;

        if (selectedCount === 0) {
          this.offerInfo.textContent = `Add ${requiredCount} product${requiredCount > 1 ? 's' : ''} to avail the offer`;
          this.offerInfo.style.display = 'block';
        } else if (selectedCount < requiredCount) {
          if (remaining === 1) {
            this.offerInfo.textContent = 'Add 1 more product to avail the offer';
          } else {
            this.offerInfo.textContent = `Add ${remaining} more product${remaining > 1 ? 's' : ''} to avail the offer`;
          }
          this.offerInfo.style.display = 'block';
        } else {
          // Offer is available, hide the message
          this.offerInfo.style.display = 'none';
        }
      }

      updateSelectedProductsDisplay() {
        // Clear existing items
        this.selectedItemsContainer.innerHTML = '';

        // Show selected products
        this.selectedProducts.forEach((product, index) => {
          const item = document.createElement('div');
          item.className = 'worriorworld-selected-item';
          // Use variant image if available (stored in product.image)
          const displayImage = product.image || '';
          item.innerHTML = `
          <img src="${displayImage}" alt="${product.title}" loading="lazy">
          <span class="worriorworld-selected-item-remove" data-index="${index}">×</span>
        `;
          this.selectedItemsContainer.appendChild(item);

          // Add remove event listener
          const removeBtn = item.querySelector('.worriorworld-selected-item-remove');
          removeBtn.addEventListener('click', () => {
            this.removeProduct(product);
          });
        });

        // Update empty slots
        const remainingSlots = this.maxProducts - this.selectedProducts.length;
        this.emptySlotsContainer.innerHTML = '';
        if (remainingSlots > 0) {
          const messageSlot = document.createElement('div');
          messageSlot.className = 'worriorworld-empty-slot-message';
          messageSlot.textContent = remainingSlots === 1 ? 'Add 1 more' : `Add ${remainingSlots} more`;
          this.emptySlotsContainer.appendChild(messageSlot);
        }
        for (let i = 0; i < remainingSlots; i++) {
          const slot = document.createElement('div');
          slot.className = 'worriorworld-empty-slot';
          slot.innerHTML = '<span class="worriorworld-plus-icon">+</span>';
          this.emptySlotsContainer.appendChild(slot);
        }
      }

      updateTotals() {
        const originalTotal = this.selectedProducts.reduce((sum, product) => sum + product.price, 0);

        if (this.selectedProducts.length === this.offerProducts) {
          // Show bundle offer price
          const savings = originalTotal - this.bundlePrice;
          this.originalTotal.textContent = this.formatPrice(originalTotal);
          this.originalTotal.style.display = 'inline-block';
          this.offerTotal.textContent = this.formatPrice(this.bundlePrice);
          this.saveAmount.textContent = `Save: ${this.formatPrice(savings)}`;
          this.saveAmount.style.display = 'block';
        } else {
          // Show regular total
          this.originalTotal.style.display = 'none';
          this.offerTotal.textContent = this.formatPrice(originalTotal);
          const savings = originalTotal - this.bundlePrice;
          if (savings > 0) {
            this.saveAmount.textContent = `Save: ${this.formatPrice(savings)}`;
          } else {
            this.saveAmount.textContent = 'Save: ₹0';
          }
        }
      }

      updateButtonStates() {
        const isLimitReached = this.selectedProducts.length >= this.maxProducts;

        this.addButtons.forEach((btn) => {
          const productId = btn.dataset.productId;
          const variantId = btn.dataset.variantId;

          // Check if this product is already selected
          const isSelected = this.selectedProducts.some(
            (p) => String(p.id) === String(productId) && String(p.variantId) === String(variantId)
          );

          if (isLimitReached && !isSelected) {
            // Disable button if limit reached and product not selected
            btn.disabled = true;
            btn.classList.add('disabled');
          } else if (!isSelected) {
            // Enable button if product not selected and limit not reached
            btn.disabled = false;
            btn.classList.remove('disabled');
          }
        });
      }

      triggerPartyPopper() {
        // Create party popper animation
        const popper = this.partyPopper;
        popper.classList.add('active');

        // Create confetti particles
        const colors = ['#ff6b35', '#ffd700', '#4ecdc4', '#45b7d1', '#f9ca24', '#f0932b', '#eb4d4b', '#6c5ce7'];
        const particleCount = 50;

        for (let i = 0; i < particleCount; i++) {
          setTimeout(() => {
            const particle = document.createElement('div');
            particle.className = 'worriorworld-confetti-particle';
            particle.style.left = Math.random() * 100 + '%';
            particle.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
            particle.style.animationDelay = Math.random() * 0.5 + 's';
            particle.style.animationDuration = Math.random() * 1 + 1.5 + 's';
            popper.appendChild(particle);

            // Remove particle after animation
            setTimeout(() => {
              if (particle.parentNode) {
                particle.parentNode.removeChild(particle);
              }
            }, 3000);
          }, i * 20);
        }

        // Remove active class after animation
        setTimeout(() => {
          popper.classList.remove('active');
          popper.innerHTML = '';
        }, 3000);
      }

      formatPrice(rupees) {
        return '₹' + rupees.toFixed(0);
      }

      handleCheckout() {
        if (this.selectedProducts.length !== this.offerProducts) {
          alert(`Please select ${this.offerProducts} products to proceed.`);
          return;
        }

        const gokwikBtn = this.checkoutBtn;
        if (!gokwikBtn || gokwikBtn.disabled) {
          alert('GoKwik checkout is not available right now. Please try again.');
          return;
        }

        gokwikBtn.click();
      }

      // Quick View Methods
      openQuickView(productHandle) {
        if (!this.quickViewModal || !productHandle) {
          console.error('Modal or product handle missing');
          return;
        }

        // Show modal
        this.quickViewModal.removeAttribute('hidden');
        this.quickViewModal.classList.add('active');
        document.body.style.overflow = 'hidden';

        // Fetch product data
        const productUrl = '/products/' + encodeURIComponent(productHandle) + '.js';

        fetch(productUrl, {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
        })
          .then((response) => {
            if (!response.ok) {
              throw new Error('Product not found');
            }
            return response.json();
          })
          .then((product) => {
            this.currentProduct = product;
            this.currentVariant = product.variants && product.variants.length > 0 ? product.variants[0] : null;
            this.displayQuickViewProduct(product);
          })
          .catch((error) => {
            console.error('Error loading product:', error);
            alert('Error loading product. Please try again.');
            this.closeQuickView();
          });
      }

      displayQuickViewProduct(product) {
        if (!this.currentVariant) {
          alert('Product variant not available.');
          this.closeQuickView();
          return;
        }

        // Get product images
        this.productImages = [];
        if (product.images && product.images.length > 0) {
          this.productImages = product.images.map((img) => (typeof img === 'string' ? img : img.src || img));
        } else if (product.featured_image) {
          const featImg =
            typeof product.featured_image === 'string'
              ? product.featured_image
              : product.featured_image.src || product.featured_image;
          this.productImages = [featImg];
        }
        this.currentImageIndex = 0;

        // Update title
        const titleEl = this.quickViewModal.querySelector(`#quick-view-title-${this.sectionId}`);
        if (titleEl) {
          titleEl.textContent = product.title;
        }

        // Update price
        const priceWrapper = this.quickViewModal.querySelector(`#quick-view-price-${this.sectionId}`);
        if (priceWrapper) {
          const price = this.currentVariant.price / 100;
          const comparePrice = this.currentVariant.compare_at_price ? this.currentVariant.compare_at_price / 100 : null;

          let priceHtml = `<span class="worriorworld-quick-view-price">₹${price.toFixed(0)}</span>`;
          if (comparePrice && comparePrice > price) {
            priceHtml = `<span class="worriorworld-quick-view-compare-price">₹${comparePrice.toFixed(
              0
            )}</span> ${priceHtml}`;
          }
          priceWrapper.innerHTML = priceHtml;
        }

        // Update description
        const descEl = this.quickViewModal.querySelector(`#quick-view-description-${this.sectionId}`);
        if (descEl) {
          if (product.description) {
            // Strip HTML and limit length
            const text = product.description.replace(/<[^>]*>/g, '').substring(0, 200);
            descEl.textContent = text + (product.description.length > 200 ? '...' : '');
          } else {
            descEl.textContent = 'No description available.';
          }
        }

        // Update images
        this.updateQuickViewImages();

        // Render variant options
        this.renderQuickViewVariants(product);

        // Update add button (will be updated after variants are rendered)
        this.updateQuickViewAddButton();
      }

      updateQuickViewImages() {
        const mainImg = this.quickViewModal.querySelector(`#quick-view-main-img-${this.sectionId}`);
        const thumbnails = this.quickViewModal.querySelector(`#quick-view-thumbnails-${this.sectionId}`);
        const prevBtn = this.quickViewModal.querySelector('.worriorworld-quick-view-prev');
        const nextBtn = this.quickViewModal.querySelector('.worriorworld-quick-view-next');

        if (!mainImg || !thumbnails) return;

        // Update main image
        if (this.productImages.length > 0) {
          mainImg.src = this.productImages[this.currentImageIndex];
          mainImg.alt = this.currentProduct.title;
        }

        // Update thumbnails
        thumbnails.innerHTML = '';
        this.productImages.forEach((img, index) => {
          const thumb = document.createElement('div');
          thumb.className = 'worriorworld-quick-view-thumbnail' + (index === this.currentImageIndex ? ' active' : '');
          thumb.innerHTML = `<img src="${img}" alt="Thumbnail ${index + 1}" loading="lazy">`;
          thumb.addEventListener('click', () => {
            this.currentImageIndex = index;
            this.updateQuickViewImages();
          });
          thumbnails.appendChild(thumb);
        });

        // Update navigation buttons
        if (prevBtn) {
          prevBtn.style.display = this.productImages.length > 1 ? 'flex' : 'none';
          prevBtn.onclick = () => {
            this.currentImageIndex =
              (this.currentImageIndex - 1 + this.productImages.length) % this.productImages.length;
            this.updateQuickViewImages();
          };
        }

        if (nextBtn) {
          nextBtn.style.display = this.productImages.length > 1 ? 'flex' : 'none';
          nextBtn.onclick = () => {
            this.currentImageIndex = (this.currentImageIndex + 1) % this.productImages.length;
            this.updateQuickViewImages();
          };
        }
      }

      updateQuickViewAddButton() {
        if (!this.currentProduct || !this.currentVariant) return;

        const addBtn = this.quickViewModal.querySelector(`#quick-view-add-btn-${this.sectionId}`);
        if (addBtn) {
          addBtn.dataset.productId = this.currentProduct.id;
          addBtn.dataset.variantId = this.currentVariant.id;
          addBtn.dataset.price = this.currentVariant.price; // Keep in cents for data attribute
          addBtn.dataset.title = this.currentProduct.title;

          // Get variant image
          let variantImage = '';
          if (this.currentVariant.featured_image) {
            variantImage =
              typeof this.currentVariant.featured_image === 'string'
                ? this.currentVariant.featured_image
                : this.currentVariant.featured_image.src || this.currentVariant.featured_image;
          } else if (this.currentVariant.image) {
            variantImage =
              typeof this.currentVariant.image === 'string'
                ? this.currentVariant.image
                : this.currentVariant.image.src || this.currentVariant.image;
          }

          if (!variantImage && this.productImages.length > 0) {
            variantImage = this.productImages[0];
          }

          addBtn.dataset.image = variantImage || '';

          // Check if already selected
          const isSelected = this.selectedProducts.some(
            (p) =>
              String(p.id) === String(this.currentProduct.id) && String(p.variantId) === String(this.currentVariant.id)
          );

          addBtn.textContent = isSelected ? 'REMOVE FROM BOX' : 'ADD TO CART';
          addBtn.classList.toggle('selected', isSelected);

          // Add click listener if not already added
          addBtn.onclick = (e) => {
            e.preventDefault();
            // Mark that this is from quick view
            addBtn.dataset.fromQuickView = 'true';
            this.handleAddButtonClick(e);
            // Update button state after add/remove
            setTimeout(() => {
              this.updateQuickViewAddButton();
            }, 100);
          };
        }
      }

      renderQuickViewVariants(product) {
        const variantsContainer = this.quickViewModal.querySelector(`#quick-view-variants-${this.sectionId}`);
        if (!variantsContainer) return;

        // Hide if no variants or only default variant
        if (!product.variants || product.variants.length <= 1 || !product.options || product.options.length === 0) {
          variantsContainer.style.display = 'none';
          return;
        }

        variantsContainer.style.display = 'block';
        const options = product.options || [];
        let html = '';

        options.forEach((option, optionIndex) => {
          const optionName = option.name || `Option ${optionIndex + 1}`;
          const optionValues = option.values || [];
          const isColorOption =
            optionName.toLowerCase().includes('color') || optionName.toLowerCase().includes('colour');

          html += `
          <div class="worriorworld-quick-view-variant-group">
            <label class="worriorworld-quick-view-variant-label">${optionName}</label>
            <div class="worriorworld-quick-view-variant-values ${
              isColorOption ? 'color-options' : ''
            }" data-option-index="${optionIndex}">
        `;

          optionValues.forEach((value) => {
            const isAvailable = this.isVariantAvailable(product.variants, optionIndex, value);

            // Skip out of stock variants
            if (!isAvailable) return;

            // Find variant image for this option value
            let variantImage = '';
            if (isColorOption) {
              const matchingVariant = product.variants.find((v) => {
                if (!v.available) return false;
                return v.options && v.options[optionIndex] === value;
              });

              if (matchingVariant) {
                if (matchingVariant.featured_image) {
                  variantImage =
                    typeof matchingVariant.featured_image === 'string'
                      ? matchingVariant.featured_image
                      : matchingVariant.featured_image.src || matchingVariant.featured_image;
                } else if (matchingVariant.image) {
                  variantImage =
                    typeof matchingVariant.image === 'string'
                      ? matchingVariant.image
                      : matchingVariant.image.src || matchingVariant.image;
                }
              }
            }

            const isSelected =
              this.currentVariant && this.currentVariant.options && this.currentVariant.options[optionIndex] === value;

            const imageHtml = variantImage
              ? `<img src="${variantImage}" alt="${value}" class="quick-view-variant-image">`
              : '';

            html += `
            <button 
              type="button" 
              class="worriorworld-quick-view-variant-btn ${isColorOption && variantImage ? 'with-image' : ''} ${
              isSelected ? 'selected' : ''
            }" 
              data-option-index="${optionIndex}"
              data-option-value="${value}"
            >
              ${imageHtml}
              <span class="quick-view-variant-text">${value}</span>
            </button>
          `;
          });

          html += `
            </div>
          </div>
        `;
        });

        variantsContainer.innerHTML = html;

        // Add event listeners
        const variantButtons = variantsContainer.querySelectorAll('.worriorworld-quick-view-variant-btn');
        variantButtons.forEach((btn) => {
          btn.addEventListener('click', (e) => this.handleQuickViewVariantClick(e, product));
        });
      }

      handleQuickViewVariantClick(e, product) {
        const btn = e.target.closest('.worriorworld-quick-view-variant-btn');
        const optionIndex = parseInt(btn.dataset.optionIndex);
        const optionValue = btn.dataset.optionValue;

        // Update selected state
        const optionGroup = btn.closest('.worriorworld-quick-view-variant-values');
        optionGroup.querySelectorAll('.worriorworld-quick-view-variant-btn').forEach((b) => {
          b.classList.remove('selected');
        });
        btn.classList.add('selected');

        // Find matching variant
        const selectedOptions = [];
        const optionGroups = this.quickViewModal.querySelectorAll('.worriorworld-quick-view-variant-values');

        optionGroups.forEach((group, index) => {
          const selectedBtn = group.querySelector('.worriorworld-quick-view-variant-btn.selected');
          if (selectedBtn) {
            selectedOptions[index] = selectedBtn.dataset.optionValue;
          }
        });

        // Find variant matching all selected options
        const matchingVariant = product.variants.find((variant) => {
          if (!variant.available) return false;
          if (!variant.options || variant.options.length !== selectedOptions.length) return false;

          return variant.options.every((opt, idx) => opt === selectedOptions[idx]);
        });

        if (matchingVariant) {
          this.currentVariant = matchingVariant;

          // Update price
          const priceWrapper = this.quickViewModal.querySelector(`#quick-view-price-${this.sectionId}`);
          if (priceWrapper) {
            const price = matchingVariant.price / 100;
            const comparePrice = matchingVariant.compare_at_price ? matchingVariant.compare_at_price / 100 : null;

            let priceHtml = `<span class="worriorworld-quick-view-price">₹${price.toFixed(0)}</span>`;
            if (comparePrice && comparePrice > price) {
              priceHtml = `<span class="worriorworld-quick-view-compare-price">₹${comparePrice.toFixed(
                0
              )}</span> ${priceHtml}`;
            }
            priceWrapper.innerHTML = priceHtml;
          }

          // Update images if variant has specific images
          if (matchingVariant.featured_image) {
            const variantImg =
              typeof matchingVariant.featured_image === 'string'
                ? matchingVariant.featured_image
                : matchingVariant.featured_image.src || matchingVariant.featured_image;

            // Update main image
            const mainImg = this.quickViewModal.querySelector(`#quick-view-main-img-${this.sectionId}`);
            if (mainImg) {
              mainImg.src = variantImg;
              this.currentImageIndex = 0;
              this.productImages = [variantImg];
              this.updateQuickViewImages();
            }
          }

          // Update add button
          this.updateQuickViewAddButton();
        }
      }

      closeQuickView() {
        if (this.quickViewModal) {
          this.quickViewModal.setAttribute('hidden', '');
          this.quickViewModal.classList.remove('active');
          document.body.style.overflow = '';
          this.currentProduct = null;
          this.currentVariant = null;
          this.productImages = [];
          this.currentImageIndex = 0;
        }
      }

      enableGoKwikButton() {
        const gokwikBtn = this.checkoutBtn;
        if (!gokwikBtn) return;

        gokwikBtn.disabled = false;
        gokwikBtn.style.pointerEvents = 'auto';
        gokwikBtn.style.opacity = '1';
        gokwikBtn.classList.add('ready');
        gokwikBtn.setAttribute('aria-disabled', 'false');
      }

      disableGoKwikButton() {
        const gokwikBtn = this.checkoutBtn;
        if (!gokwikBtn) return;

        gokwikBtn.disabled = true;
        gokwikBtn.style.pointerEvents = 'none';
        gokwikBtn.style.opacity = '0.65';
        gokwikBtn.classList.remove('ready');
        gokwikBtn.setAttribute('aria-disabled', 'true');
      }

      updateGoKwikButtonState() {
        if (this.selectedProducts.length === this.offerProducts) {
          this.enableGoKwikButton();
        } else {
          this.disableGoKwikButton();
        }
      }

      // Variant Selector Methods
      handleChooseVariantClick(e) {
        e.preventDefault();
        const btn = e.target.closest('.worriorworld-choose-variant-btn');
        const productHandle = btn.dataset.productHandle;
        const productId = btn.dataset.productId;

        if (!productHandle) {
          console.error('Product handle missing');
          return;
        }

        if (this.selectedProducts.length >= this.maxProducts) {
          alert(
            `Your Buy Any ${this.maxProducts} for ₹${this.bundlePrice} bundle is complete. Remove a product to change your selection.`
          );
          return;
        }

        this.openVariantDrawer(productHandle, productId);
      }

      async openVariantDrawer(productHandle, productId) {
        if (!this.variantDrawer) return;

        // Show drawer
        this.variantDrawer.removeAttribute('hidden');
        this.variantDrawer.classList.add('active');
        document.body.style.overflow = 'hidden';

        // Show loading state
        this.variantDrawerBody.innerHTML = `
        <div class="worriorworld-variant-loading">
          <div class="worriorworld-loader"></div>
          <p>Loading variants...</p>
        </div>
      `;

        try {
          // Fetch product data
          const response = await fetch(`/products/${encodeURIComponent(productHandle)}.js`, {
            method: 'GET',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
          });

          if (!response.ok) {
            throw new Error('Failed to load product');
          }

          const product = await response.json();
          this.currentProductForVariant = product;
          this.selectedVariant = null;

          // Update title
          if (this.variantDrawerTitle) {
            this.variantDrawerTitle.textContent = product.title;
          }

          // Render variant options
          this.renderVariantOptions(product);
        } catch (error) {
          console.error('Error loading product:', error);
          this.variantDrawerBody.innerHTML = `
          <div class="worriorworld-variant-error">
            <p>Error loading product. Please try again.</p>
          </div>
        `;
        }
      }

      renderVariantOptions(product) {
        if (!product.variants || product.variants.length === 0) {
          this.variantDrawerBody.innerHTML = `
          <div class="worriorworld-variant-error">
            <p>No variants available for this product.</p>
          </div>
        `;
          return;
        }

        // Group variants by options
        const options = product.options || [];
        let html = '';

        options.forEach((option, optionIndex) => {
          const optionName = option.name || `Option ${optionIndex + 1}`;
          const optionValues = option.values || [];
          const isColorOption =
            optionName.toLowerCase().includes('color') || optionName.toLowerCase().includes('colour');

          html += `
          <div class="worriorworld-variant-option-group">
            <label class="worriorworld-variant-option-label">${optionName}</label>
            <div class="worriorworld-variant-option-values ${
              isColorOption ? 'color-options' : ''
            }" data-option-index="${optionIndex}">
        `;

          optionValues.forEach((value, valueIndex) => {
            const isAvailable = this.isVariantAvailable(product.variants, optionIndex, value);

            // Skip out of stock variants
            if (!isAvailable) return;

            // Find variant image for this option value
            let variantImage = '';
            if (isColorOption) {
              const matchingVariant = product.variants.find((v) => {
                if (!v.available) return false;
                return v.options && v.options[optionIndex] === value;
              });

              if (matchingVariant) {
                // Get variant image
                if (matchingVariant.featured_image) {
                  variantImage =
                    typeof matchingVariant.featured_image === 'string'
                      ? matchingVariant.featured_image
                      : matchingVariant.featured_image.src || matchingVariant.featured_image;
                } else if (matchingVariant.image) {
                  variantImage =
                    typeof matchingVariant.image === 'string'
                      ? matchingVariant.image
                      : matchingVariant.image.src || matchingVariant.image;
                }

                // If no variant image, try to get from product images
                if (!variantImage && product.images && product.images.length > 0) {
                  // Try to find image by variant ID or position
                  const variantImageObj = product.images.find((img) => {
                    if (typeof img === 'object' && img.variant_ids) {
                      return img.variant_ids.includes(matchingVariant.id);
                    }
                    return false;
                  });
                  if (variantImageObj) {
                    variantImage =
                      typeof variantImageObj === 'string' ? variantImageObj : variantImageObj.src || variantImageObj;
                  }
                }
              }
            }

            const imageHtml = variantImage
              ? `<img src="${variantImage}" alt="${value}" class="variant-option-image">`
              : '';

            html += `
            <button 
              type="button" 
              class="worriorworld-variant-option-btn ${isColorOption && variantImage ? 'with-image' : ''}" 
              data-option-index="${optionIndex}"
              data-option-value="${value}"
            >
              ${imageHtml}
              <span class="variant-option-text">${value}</span>
            </button>
          `;
          });

          html += `
            </div>
          </div>
        `;
        });

        this.variantDrawerBody.innerHTML = html;

        // Add event listeners to variant option buttons
        const optionButtons = this.variantDrawerBody.querySelectorAll('.worriorworld-variant-option-btn');
        optionButtons.forEach((btn) => {
          btn.addEventListener('click', (e) => this.handleVariantOptionClick(e));
        });

        // Select first available variant by default
        this.selectFirstAvailableVariant(product);
      }

      isVariantAvailable(variants, optionIndex, optionValue) {
        return variants.some((variant) => {
          if (!variant.available) return false;
          const variantOptionValue = variant.options && variant.options[optionIndex];
          return variantOptionValue === optionValue;
        });
      }

      handleVariantOptionClick(e) {
        const btn = e.target.closest('.worriorworld-variant-option-btn');
        const optionIndex = parseInt(btn.dataset.optionIndex);
        const optionValue = btn.dataset.optionValue;

        // Update selected state
        const optionGroup = btn.closest('.worriorworld-variant-option-values');
        optionGroup.querySelectorAll('.worriorworld-variant-option-btn').forEach((b) => {
          b.classList.remove('selected');
        });
        btn.classList.add('selected');

        // Find matching variant
        this.updateSelectedVariant(optionIndex, optionValue);
      }

      updateSelectedVariant(optionIndex, optionValue) {
        if (!this.currentProductForVariant || !this.currentProductForVariant.variants) return;

        // Get all selected option values
        const selectedOptions = [];
        const optionGroups = this.variantDrawerBody.querySelectorAll('.worriorworld-variant-option-values');

        optionGroups.forEach((group, index) => {
          const selectedBtn = group.querySelector('.worriorworld-variant-option-btn.selected');
          if (selectedBtn) {
            selectedOptions[index] = selectedBtn.dataset.optionValue;
          }
        });

        // Find variant matching all selected options
        const matchingVariant = this.currentProductForVariant.variants.find((variant) => {
          if (!variant.available) return false;
          if (!variant.options || variant.options.length !== selectedOptions.length) return false;

          return variant.options.every((opt, idx) => opt === selectedOptions[idx]);
        });

        if (matchingVariant) {
          this.selectedVariant = matchingVariant;
          this.updateVariantPrice(matchingVariant);
          if (this.variantDrawerAddBtn) {
            this.variantDrawerAddBtn.disabled = false;
          }
        } else {
          this.selectedVariant = null;
          if (this.variantDrawerPrice) {
            this.variantDrawerPrice.textContent = 'Select options';
          }
          if (this.variantDrawerAddBtn) {
            this.variantDrawerAddBtn.disabled = true;
          }
        }
      }

      selectFirstAvailableVariant(product) {
        if (!product.variants) return;

        const firstAvailable = product.variants.find((v) => v.available);
        if (firstAvailable && firstAvailable.options) {
          // Select first available variant's options
          firstAvailable.options.forEach((value, index) => {
            const optionGroup = this.variantDrawerBody.querySelector(`[data-option-index="${index}"]`);
            if (optionGroup) {
              const matchingBtn = Array.from(optionGroup.querySelectorAll('.worriorworld-variant-option-btn')).find(
                (btn) => btn.dataset.optionValue === value && !btn.disabled
              );
              if (matchingBtn) {
                matchingBtn.click();
              }
            }
          });
        }
      }

      updateVariantPrice(variant) {
        if (this.variantDrawerPrice) {
          const price = variant.price / 100;
          const comparePrice = variant.compare_at_price ? variant.compare_at_price / 100 : null;

          let priceHtml = `₹${price.toFixed(0)}`;
          if (comparePrice && comparePrice > price) {
            priceHtml = `<span style="text-decoration: line-through; color: #999; margin-right: 8px;">₹${comparePrice.toFixed(
              0
            )}</span>${priceHtml}`;
          }
          this.variantDrawerPrice.innerHTML = priceHtml;
        }
      }

      async addSelectedVariantToCart() {
        if (!this.selectedVariant || !this.currentProductForVariant) {
          alert('Please select a variant');
          return;
        }

        // Check maximum limit
        if (this.selectedProducts.length >= this.maxProducts) {
          alert(`You can only add ${this.maxProducts} products to this bundle.`);
          return;
        }

        // Get variant image
        let variantImage = '';
        if (this.selectedVariant.featured_image) {
          variantImage =
            typeof this.selectedVariant.featured_image === 'string'
              ? this.selectedVariant.featured_image
              : this.selectedVariant.featured_image.src || this.selectedVariant.featured_image;
        } else if (this.selectedVariant.image) {
          variantImage =
            typeof this.selectedVariant.image === 'string'
              ? this.selectedVariant.image
              : this.selectedVariant.image.src || this.selectedVariant.image;
        }

        // Fallback to product image if no variant image
        if (!variantImage) {
          if (this.currentProductForVariant.featured_image) {
            variantImage =
              typeof this.currentProductForVariant.featured_image === 'string'
                ? this.currentProductForVariant.featured_image
                : this.currentProductForVariant.featured_image.src || this.currentProductForVariant.featured_image;
          } else if (this.currentProductForVariant.images && this.currentProductForVariant.images.length > 0) {
            const firstImage = this.currentProductForVariant.images[0];
            variantImage = typeof firstImage === 'string' ? firstImage : firstImage.src || firstImage;
          }
        }

        const productData = {
          id: String(this.currentProductForVariant.id),
          variantId: String(this.selectedVariant.id),
          price: this.selectedVariant.price / 100, // Convert cents to rupees
          title: this.currentProductForVariant.title,
          image: variantImage || '',
        };

        // Close drawer
        this.closeVariantDrawer();

        // Add to cart
        const productCard = this.section.querySelector(
          `.worriorworld-product-card[data-product-id="${productData.id}"]`
        );
        const btn = productCard ? productCard.querySelector('.worriorworld-choose-variant-btn') : null;

        await this.addProductToCart(productData, btn, productCard);
      }

      closeVariantDrawer() {
        if (this.variantDrawer) {
          this.variantDrawer.setAttribute('hidden', '');
          this.variantDrawer.classList.remove('active');
          document.body.style.overflow = '';
          this.currentProductForVariant = null;
          this.selectedVariant = null;
        }
      }

      // Load all remaining products on page load
      async loadAllRemainingProducts() {
        if (!this.collectionHandle) {
          console.log('Cannot load all products: No collection handle');
          return;
        }

        const totalProducts = parseInt(this.productsGrid.dataset.totalProducts) || 0;
        const currentlyLoaded = this.loadedProductIds.size;

        if (currentlyLoaded >= totalProducts) {
          console.log('All products already loaded');
          return;
        }

        console.log(`Loading all remaining products: ${currentlyLoaded}/${totalProducts} loaded`);

        // Show loading indicator
        if (this.infiniteLoader) {
          this.infiniteLoader.style.display = 'block';
          this.infiniteLoader.style.opacity = '1';
          this.infiniteLoader.style.height = 'auto';
        }

        // Load products in batches using JSON API
        // Start from page 2 since page 1 (first 50) are already loaded via Liquid
        const limit = 250; // Shopify allows up to 250 products per request
        let pageNumber = 2; // Always start from page 2 since Liquid loads page 1

        while (this.loadedProductIds.size < totalProducts) {
          try {
            const url = `/collections/${this.collectionHandle}/products.json?page=${pageNumber}&limit=${limit}`;
            console.log(`Fetching batch ${pageNumber}: ${url}`);

            const response = await fetch(url, {
              cache: 'no-cache',
              headers: {
                Accept: 'application/json',
              },
            });

            if (!response.ok) {
              console.error(`Failed to load products batch ${pageNumber}: ${response.status}`);
              break;
            }

            const data = await response.json();
            const products = data.products || [];

            if (products.length === 0) {
              console.log('No more products to load');
              break;
            }

            // Filter out already loaded products and render new ones
            const newProducts = products.filter((product) => {
              const productId = String(product.id);
              if (this.loadedProductIds.has(productId)) {
                console.log(`Skipping duplicate product ID: ${productId} on page ${pageNumber}`);
                return false;
              }
              this.loadedProductIds.add(productId);
              return true;
            });

            console.log(
              `Rendering ${newProducts.length} new products from batch ${pageNumber} (${products.length} total in response)`
            );

            if (newProducts.length === 0 && products.length > 0) {
              // All products in this batch are duplicates - might be pagination issue
              console.warn(`All products on page ${pageNumber} are duplicates. This might indicate pagination issue.`);
              // If we've tried multiple pages with duplicates, stop to avoid infinite loop
              if (pageNumber > 10) {
                console.error('Too many duplicate pages detected. Stopping to avoid infinite loop.');
                break;
              }
              // Try next page anyway
              pageNumber++;
              await new Promise((resolve) => setTimeout(resolve, 200));
              continue;
            }

            // Render each new product
            newProducts.forEach((product) => {
              this.renderProductCard(product);
            });

            // Re-initialize event listeners for new products
            this.initializeNewProducts();

            // Update UI after each batch
            this.updateUI();

            // If we got fewer products than the limit, we've reached the end
            if (products.length < limit) {
              console.log(`Reached end of products (got ${products.length} products, limit was ${limit})`);
              break;
            }

            // If we've loaded all products, stop
            if (this.loadedProductIds.size >= totalProducts) {
              console.log('All products loaded!');
              break;
            }

            pageNumber++;

            // Small delay to avoid overwhelming the server and allow UI to update
            await new Promise((resolve) => setTimeout(resolve, 200));
          } catch (error) {
            console.error(`Error loading products batch ${pageNumber}:`, error);
            break;
          }
        }

        console.log(`Finished loading products. Total loaded: ${this.loadedProductIds.size}/${totalProducts}`);

        // Hide loading indicator
        if (this.infiniteLoader) {
          this.infiniteLoader.style.display = 'none';
        }

        // Update hasMoreProducts flag
        this.hasMoreProducts = this.loadedProductIds.size < totalProducts;

        // Final UI update
        this.updateUI();
      }

      // Infinite Scroll Methods
      initInfiniteScroll() {
        if (!this.productsGrid || !this.infiniteLoader) {
          console.log('Infinite scroll: Missing elements', {
            productsGrid: !!this.productsGrid,
            infiniteLoader: !!this.infiniteLoader,
          });
          return;
        }

        // If all products are already loaded, disable infinite scroll
        if (!this.hasMoreProducts) {
          console.log('Infinite scroll: All products already loaded, disabling infinite scroll');
          this.infiniteLoader.style.display = 'none';
          return;
        }

        if (!this.collectionHandle) {
          console.log('Infinite scroll: No collection handle found');
          console.log('Available collection handle methods:', {
            sectionData: this.section?.dataset?.collectionHandle,
            globalCollection: typeof collection !== 'undefined' ? collection?.handle : 'undefined',
            url: window.location.pathname,
          });
          return;
        }

        const totalProducts = parseInt(this.productsGrid.dataset.totalProducts) || 0;
        const loadedCount = this.loadedProductIds.size;

        console.log('Infinite scroll initialized:', {
          collection: this.collectionHandle,
          totalProducts: totalProducts,
          loadedCount: loadedCount,
          hasMore: this.hasMoreProducts,
          productsPerPage: this.productsPerPage,
        });

        // Make loader visible and properly positioned for intersection observer
        this.infiniteLoader.style.display = 'block';
        this.infiniteLoader.style.visibility = 'visible';
        this.infiniteLoader.style.opacity = '0.3'; // Slightly visible for debugging
        this.infiniteLoader.style.minHeight = '100px';
        this.infiniteLoader.style.height = '100px';
        this.infiniteLoader.style.position = 'relative';
        this.infiniteLoader.style.zIndex = '1';

        // Ensure loader is after products grid in DOM
        if (this.infiniteLoader.parentNode !== this.productsGrid.parentNode) {
          // Move loader to be sibling of products grid
          const container = this.productsGrid.parentNode;
          if (container && container.contains(this.infiniteLoader)) {
            // Already in correct parent, just ensure it's after products grid
            container.insertBefore(this.infiniteLoader, this.productsGrid.nextSibling);
          }
        }

        // Create intersection observer with better settings
        this.observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              console.log('Intersection observer triggered:', {
                isIntersecting: entry.isIntersecting,
                isLoading: this.isLoading,
                hasMore: this.hasMoreProducts,
                intersectionRatio: entry.intersectionRatio,
              });

              if (entry.isIntersecting && !this.isLoading && this.hasMoreProducts) {
                console.log('✅ User scrolled to bottom - Loading more products via JSON API...');
                // Use JSON API directly since it's more reliable than HTML pagination
                this.loadMoreProductsFromJSON();
              }
            });
          },
          {
            root: null, // Use viewport as root
            rootMargin: '400px', // Start loading 400px before reaching the bottom
            threshold: [0, 0.1, 0.5, 1.0], // Multiple thresholds for better detection
          }
        );

        // Observe the loader element
        this.observer.observe(this.infiniteLoader);
        console.log('✅ IntersectionObserver is now watching the loader element');
      }

      async loadMoreProducts() {
        if (this.isLoading || !this.hasMoreProducts || !this.collectionHandle) {
          console.log('Load more blocked:', {
            isLoading: this.isLoading,
            hasMore: this.hasMoreProducts,
            handle: this.collectionHandle,
          });
          return;
        }

        // If JSON API mode is enabled, use that instead
        if (this.useJSONAPI) {
          return this.loadMoreProductsFromJSON();
        }

        this.isLoading = true;
        this.infiniteLoader.style.display = 'block';
        this.infiniteLoader.style.opacity = '1';
        this.infiniteLoader.style.height = 'auto';

        const pageToLoad = this.currentPage;
        this.currentPage++; // Increment for next load

        console.log(`Loading page ${pageToLoad} for collection ${this.collectionHandle}`);

        try {
          // Try multiple URL formats for Shopify pagination
          const timestamp = new Date().getTime();
          let url = `/collections/${this.collectionHandle}?page=${pageToLoad}&_=${timestamp}`;

          console.log(`Fetching: ${url}`);
          let response = await fetch(url, {
            cache: 'no-cache',
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              Accept: 'text/html',
            },
          });

          // If first attempt fails, try with view parameter
          if (!response.ok || response.status === 404) {
            url = `/collections/${this.collectionHandle}?page=${pageToLoad}&view=ajax&_=${timestamp}`;
            console.log(`Retrying with view parameter: ${url}`);
            response = await fetch(url, {
              cache: 'no-cache',
              headers: {
                'X-Requested-With': 'XMLHttpRequest',
                Accept: 'text/html',
              },
            });
          }

          if (!response.ok) {
            throw new Error(`Failed to load products: ${response.status}`);
          }

          const html = await response.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');

          // Try multiple selectors to find products (in case structure differs)
          let allProducts = doc.querySelectorAll('.worriorworld-product-card');

          // If no products found with main selector, try finding the products grid container first
          if (allProducts.length === 0) {
            const productsGrid =
              doc.querySelector('.worriorworld-products-grid') ||
              doc.querySelector('#worriorworld-products-' + this.sectionId);
            if (productsGrid) {
              allProducts = productsGrid.querySelectorAll('.worriorworld-product-card');
            }
          }

          // Also try searching in the entire document as fallback
          if (allProducts.length === 0) {
            allProducts = doc.querySelectorAll('[data-product-id]');
          }

          console.log(`Found ${allProducts.length} total products in response for page ${pageToLoad}`);

          // Filter out products we've already loaded
          const newProducts = Array.from(allProducts).filter((productCard) => {
            const productId = productCard.getAttribute('data-product-id');
            if (!productId) {
              console.warn('Product card missing data-product-id');
              return false;
            }

            // Skip if we already have this product
            if (this.loadedProductIds.has(productId)) {
              console.log(`Skipping duplicate product ID: ${productId}`);
              return false;
            }

            // Add to loaded set
            this.loadedProductIds.add(productId);
            return true;
          });

          console.log(
            `Found ${newProducts.length} NEW products (out of ${allProducts.length} total) on page ${pageToLoad}`
          );
          console.log(`Total unique products loaded so far: ${this.loadedProductIds.size}`);

          // If all products are duplicates, Shopify HTML pagination isn't working - switch to JSON API
          if (allProducts.length > 0 && newProducts.length === 0) {
            console.warn(
              'All products on page are duplicates. Shopify HTML pagination not working. Switching to JSON API permanently...'
            );
            this.useJSONAPI = true;
            this.isLoading = false;
            // Retry immediately with JSON API
            setTimeout(() => {
              this.loadMoreProductsFromJSON();
            }, 100);
            return;
          }

          if (newProducts.length === 0) {
            console.log('No new products available');
            this.hasMoreProducts = false;
            this.infiniteLoader.style.display = 'none';
            if (this.observer) {
              this.observer.unobserve(this.infiniteLoader);
            }
          } else {
            // Append only new products to grid
            newProducts.forEach((productCard) => {
              const clonedCard = productCard.cloneNode(true);
              this.productsGrid.appendChild(clonedCard);
            });

            // Re-initialize event listeners for new products
            this.initializeNewProducts();

            // Check if we've loaded all products
            const currentProductCount = this.productsGrid.querySelectorAll('.worriorworld-product-card').length;
            const totalProducts = parseInt(this.productsGrid.dataset.totalProducts) || 0;

            if (totalProducts > 0 && currentProductCount >= totalProducts) {
              console.log('All products loaded');
              this.hasMoreProducts = false;
              setTimeout(() => {
                this.infiniteLoader.style.display = 'none';
                if (this.observer) {
                  this.observer.unobserve(this.infiniteLoader);
                }
              }, 500);
            } else if (newProducts.length < this.productsPerPage) {
              // If we got fewer products than expected, likely no more pages
              console.log(`Got ${newProducts.length} products, likely last page`);
              this.hasMoreProducts = false;
              setTimeout(() => {
                this.infiniteLoader.style.display = 'none';
                if (this.observer) {
                  this.observer.unobserve(this.infiniteLoader);
                }
              }, 500);
            } else {
              // Hide loader after a short delay, keep it ready for next load
              setTimeout(() => {
                this.infiniteLoader.style.opacity = '0.3'; // Keep slightly visible for IntersectionObserver
                this.infiniteLoader.style.minHeight = '100px';
                this.infiniteLoader.style.height = '100px';
                console.log('✅ Products loaded, loader ready for next scroll');
              }, 500);
            }
          }
        } catch (error) {
          console.error('Error loading more products:', error);
          this.hasMoreProducts = false;
          this.infiniteLoader.style.display = 'none';
          if (this.observer) {
            this.observer.unobserve(this.infiniteLoader);
          }
        } finally {
          this.isLoading = false;
        }
      }

      // Alternative method using Shopify Collection JSON API for proper pagination
      async loadMoreProductsFromJSON() {
        if (this.isLoading || !this.hasMoreProducts || !this.collectionHandle) {
          console.log('❌ Load blocked:', {
            isLoading: this.isLoading,
            hasMore: this.hasMoreProducts,
            handle: this.collectionHandle,
          });
          return;
        }

        this.isLoading = true;
        this.infiniteLoader.style.display = 'block';
        this.infiniteLoader.style.opacity = '1';
        this.infiniteLoader.style.height = 'auto';

        // Calculate page number based on how many products we've loaded
        const loadedCount = this.loadedProductIds.size;
        const pageNumber = Math.floor(loadedCount / this.productsPerPage) + 1;
        const limit = this.productsPerPage;

        console.log(
          `Loading products from JSON API: page=${pageNumber}, already loaded=${loadedCount}, limit=${limit}`
        );

        try {
          // Use Shopify's collection products JSON endpoint with page parameter
          // Note: Shopify JSON API uses page numbers, not offset
          const url = `/collections/${this.collectionHandle}/products.json?page=${pageNumber}&limit=${limit}`;

          console.log(`Fetching JSON: ${url}`);
          const response = await fetch(url, {
            cache: 'no-cache',
            headers: {
              Accept: 'application/json',
            },
          });

          if (!response.ok) {
            throw new Error(`Failed to load products: ${response.status}`);
          }

          const data = await response.json();
          const products = data.products || [];

          console.log(`✅ Found ${products.length} products from JSON API on page ${pageNumber}`);
          console.log(
            'Products data sample:',
            products.length > 0
              ? {
                  id: products[0].id,
                  title: products[0].title,
                  available: products[0].available,
                }
              : 'No products'
          );

          if (products.length === 0) {
            console.log('No more products available');
            this.hasMoreProducts = false;
            this.infiniteLoader.style.display = 'none';
            if (this.observer) {
              this.observer.unobserve(this.infiniteLoader);
            }
          } else {
            // Filter out already loaded products (shouldn't happen with offset, but just in case)
            const newProducts = products.filter((product) => {
              const productId = String(product.id);
              if (this.loadedProductIds.has(productId)) {
                console.log(`⚠️ Skipping duplicate product ID: ${productId}`);
                return false;
              }
              this.loadedProductIds.add(productId);
              return true;
            });

            console.log(`🎨 Rendering ${newProducts.length} new products (out of ${products.length} total)`);

            if (newProducts.length === 0) {
              console.warn('⚠️ All products in this batch are duplicates!');
              this.hasMoreProducts = false;
              this.infiniteLoader.style.display = 'none';
              if (this.observer) {
                this.observer.unobserve(this.infiniteLoader);
              }
              return;
            }

            // Verify productsGrid exists before rendering
            if (!this.productsGrid) {
              console.error('❌ productsGrid element not found! Cannot render products.');
              this.isLoading = false;
              return;
            }

            console.log('✅ productsGrid found, starting to render products...');

            // Render each product card
            let renderedCount = 0;
            let skippedCount = 0;
            newProducts.forEach((product, index) => {
              try {
                const beforeCount = this.productsGrid.querySelectorAll('.worriorworld-product-card').length;
                this.renderProductCard(product);
                const afterCount = this.productsGrid.querySelectorAll('.worriorworld-product-card').length;

                if (afterCount > beforeCount) {
                  renderedCount++;
                  if (index === 0) {
                    console.log('✅ First product card rendered and appended successfully');
                  }
                } else {
                  skippedCount++;
                  console.warn(`⚠️ Product ${product.id} was not rendered (likely filtered out)`);
                }
              } catch (error) {
                console.error(`❌ Error rendering product ${product.id}:`, error);
                console.error('Error stack:', error.stack);
              }
            });

            console.log(`✅ Successfully rendered ${renderedCount} product cards, skipped ${skippedCount}`);
            console.log(
              `📊 Total products in grid now: ${
                this.productsGrid.querySelectorAll('.worriorworld-product-card').length
              }`
            );

            // Re-initialize event listeners for new products
            this.initializeNewProducts();

            // Update UI after rendering
            this.updateUI();

            // Check if we've loaded all products
            const currentProductCount = this.productsGrid.querySelectorAll('.worriorworld-product-card').length;
            const totalProducts = parseInt(this.productsGrid.dataset.totalProducts) || 0;

            if (totalProducts > 0 && currentProductCount >= totalProducts) {
              console.log('All products loaded');
              this.hasMoreProducts = false;
              setTimeout(() => {
                this.infiniteLoader.style.display = 'none';
                if (this.observer) {
                  this.observer.unobserve(this.infiniteLoader);
                }
              }, 500);
            } else if (newProducts.length < this.productsPerPage) {
              // If we got fewer products than expected, likely no more pages
              console.log(`Got ${newProducts.length} products, likely last page`);
              this.hasMoreProducts = false;
              setTimeout(() => {
                this.infiniteLoader.style.display = 'none';
                if (this.observer) {
                  this.observer.unobserve(this.infiniteLoader);
                }
              }, 500);
            } else {
              // Hide loader after a short delay, keep it ready for next load
              setTimeout(() => {
                this.infiniteLoader.style.opacity = '0.3'; // Keep slightly visible for IntersectionObserver
                this.infiniteLoader.style.minHeight = '100px';
                this.infiniteLoader.style.height = '100px';
                console.log('✅ Products loaded, loader ready for next scroll');
              }, 500);
            }
          }
        } catch (error) {
          console.error('Error loading products from JSON API:', error);
          this.hasMoreProducts = false;
          this.infiniteLoader.style.display = 'none';
          if (this.observer) {
            this.observer.unobserve(this.infiniteLoader);
          }
        } finally {
          this.isLoading = false;
        }
      }

      renderProductCard(product) {
        if (!product) {
          console.warn('⚠️ renderProductCard: Product is null or undefined');
          return;
        }

        if (!this.productsGrid) {
          console.error('❌ renderProductCard: productsGrid element not found!');
          return;
        }

        // Check if product has any available variants (don't rely on product.available flag)
        // Shopify JSON API might not always set available correctly, so be lenient
        const availableVariants =
          product.variants && product.variants.length > 0
            ? product.variants.filter((v) => v.available !== false) // Include variants where available is not explicitly false
            : [];

        // Always try to use a variant - prefer available ones, but use any variant if needed
        let selectedVariant = null;
        if (availableVariants.length > 0) {
          selectedVariant = availableVariants[0];
        } else if (product.variants && product.variants.length > 0) {
          // Use first variant even if marked unavailable (might be a data issue)
          selectedVariant = product.variants[0];
          console.log(
            `⚠️ Using variant marked unavailable for product: ${product.id} - ${product.title} (no available variants, using first variant)`
          );
        }

        if (!selectedVariant) {
          console.warn(`⚠️ No variant found for product: ${product.id} - ${product.title}`);
          return;
        }

        const productCard = document.createElement('div');
        productCard.className = 'worriorworld-product-card';
        productCard.setAttribute('data-product-id', product.id);
        productCard.setAttribute('data-variant-id', selectedVariant.id);
        productCard.setAttribute('data-product-handle', product.handle);

        // Build variant chips HTML
        let variantChipsHtml = '';
        if (product.options && product.options.length > 0 && product.options[0].values) {
          const optionValues = product.options[0].values.slice(0, 4);
          variantChipsHtml =
            '<div class="worriorworld-product-variants"><div class="worriorworld-product-variant-options">';
          optionValues.forEach((value) => {
            const variantAvailable = product.variants.some((v) => v.available && v.options && v.options[0] === value);
            if (variantAvailable) {
              variantChipsHtml += `<span class="worriorworld-variant-chip" data-option-value="${value}">${value}</span>`;
            }
          });
          if (product.options[0].values.length > 4) {
            variantChipsHtml += `<span class="worriorworld-variant-more">+${
              product.options[0].values.length - 4
            } more</span>`;
          }
          variantChipsHtml += '</div></div>';
        }

        // Build price HTML
        let priceHtml = '';
        const variantPrice = selectedVariant.price || 0;
        const comparePrice = selectedVariant.compare_at_price || 0;

        // Ensure prices are numbers
        let priceValue = typeof variantPrice === 'string' ? parseFloat(variantPrice) : variantPrice;
        let comparePriceValue = typeof comparePrice === 'string' ? parseFloat(comparePrice) : comparePrice;

        // Shopify JSON API typically returns prices in cents (e.g., 40000 for ₹400)
        // However, some APIs might return prices already in rupees
        // Check if price seems to be in cents (typically > 100 for most products) or already in rupees
        // If price is less than 1000, it's likely already in rupees
        if (priceValue > 0) {
          if (priceValue >= 1000) {
            // Price is in cents, convert to rupees
            priceValue = priceValue / 100;
          }
          // If price < 1000, assume it's already in rupees, don't divide
        }

        if (comparePriceValue > 0) {
          if (comparePriceValue >= 1000) {
            // Compare price is in cents, convert to rupees
            comparePriceValue = comparePriceValue / 100;
          }
          // If compare price < 1000, assume it's already in rupees, don't divide
        }

        if (comparePriceValue && comparePriceValue > priceValue && priceValue > 0) {
          priceHtml = `<div class="worriorworld-product-price-wrapper">
          <span class="worriorworld-product-original-price">${this.formatMoney(comparePriceValue)}</span>
          <span class="worriorworld-product-price">${this.formatMoney(priceValue)}</span>
        </div>`;
        } else if (priceValue > 0) {
          priceHtml = `<div class="worriorworld-product-price-wrapper">
          <span class="worriorworld-product-price">${this.formatMoney(priceValue)}</span>
        </div>`;
        } else {
          // Fallback if price is missing
          priceHtml = `<div class="worriorworld-product-price-wrapper">
          <span class="worriorworld-product-price">Price unavailable</span>
        </div>`;
        }

        const imageUrl = product.featured_image || (product.images && product.images[0]) || '';
        const imageSrc = typeof imageUrl === 'string' ? imageUrl : imageUrl.src || '';

        productCard.innerHTML = `
        <div class="worriorworld-product-image-wrapper">
          <img 
            src="${imageSrc}"
            alt="${product.title}"
            loading="lazy"
            class="worriorworld-product-image"
          >
          <button 
            type="button" 
            class="worriorworld-quick-view-btn" 
            data-product-handle="${product.handle}"
            aria-label="Quick view ${product.title}"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="currentColor"/>
            </svg>
          </button>
        </div>
        <div class="worriorworld-product-info">
          <h3 class="worriorworld-product-title">${product.title}</h3>
          ${variantChipsHtml}
          ${priceHtml}
          <button 
            type="button"
            class="worriorworld-add-btn worriorworld-direct-add-btn" 
            data-product-id="${product.id}" 
            data-variant-id="${selectedVariant.id}" 
            data-price="${selectedVariant.price}" 
            data-title="${product.title}" 
            data-image="${imageSrc}"
          >
            <span class="worriorworld-btn-text">ADD TO CART</span>
          </button>
        </div>
      `;

        try {
          this.productsGrid.appendChild(productCard);
          console.log(`✅ Product card appended to grid: ${product.title} (ID: ${product.id})`);
        } catch (error) {
          console.error(`❌ Error appending product card to grid:`, error);
          console.error('Product data:', { id: product.id, title: product.title });
          console.error('productsGrid element:', this.productsGrid);
        }
      }

      formatMoney(rupees) {
        if (!rupees || rupees === 0) {
          return '₹0';
        }
        // Ensure rupees is a number (price should already be converted to rupees before calling this)
        const price = typeof rupees === 'string' ? parseFloat(rupees) : rupees;
        // Format rupees with Indian locale
        return '₹' + Math.round(price).toLocaleString('en-IN');
      }

      initializeNewProducts() {
        // Re-query all buttons to include new products
        const newQuickViewButtons = this.productsGrid.querySelectorAll('.worriorworld-quick-view-btn');
        newQuickViewButtons.forEach((btn) => {
          if (!btn.dataset.initialized) {
            btn.dataset.initialized = 'true';
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              const productHandle = btn.dataset.productHandle;
              this.openQuickView(productHandle);
            });
          }
        });

        const newDirectAddButtons = this.productsGrid.querySelectorAll('.worriorworld-direct-add-btn');
        newDirectAddButtons.forEach((btn) => {
          if (!btn.dataset.directAddInitialized) {
            btn.dataset.directAddInitialized = 'true';
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              this.handleAddButtonClick(e);
            });
          }
        });

        // Setup click handlers for new product cards
        this.setupProductCardClicks();

        // Update the reference used for card-button enabled/disabled states.
        this.addButtons = this.section.querySelectorAll('.worriorworld-direct-add-btn');
      }

      setupProductCardClicks() {
        // Add click handler to all product cards that don't have one yet
        const productCards = this.productsGrid.querySelectorAll('.worriorworld-product-card');
        productCards.forEach((card) => {
          if (!card.dataset.clickHandlerAdded) {
            card.dataset.clickHandlerAdded = 'true';
            card.style.cursor = 'pointer';

            card.addEventListener('click', (e) => {
              // Don't open quick view if clicking on buttons or links inside the card
              if (e.target.closest('button') || e.target.closest('a')) {
                return;
              }

              const productHandle = card.dataset.productHandle;
              if (productHandle) {
                this.openQuickView(productHandle);
              }
            });
          }
        });
      }
    }
  })();
</script>

