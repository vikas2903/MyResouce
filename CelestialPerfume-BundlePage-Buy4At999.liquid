<script>
  (() => {
    const root = document.getElementById('GiftBoxBundle-{{ section.id }}');
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = 'true';
    const maxItems = 4;
    const minimumItems = 4;
    const bundlePrice = 99900;
    const moneyFormat = root.dataset.currencyFormat;
    const slots = root.querySelector('.gift-box-bundle__slots');
    const total = root.querySelector('.gift-box-bundle__total strong');
    const checkout = root.querySelector('.bundle-checkout-btn');
    const checkoutText = checkout.querySelector('.btn-text');
    const checkoutLoader = root.querySelector('.addloadr');
    const quickView = root.querySelector('.gift-box-quick-view');
    const quickViewDialog = quickView && quickView.querySelector('.gift-box-quick-view__dialog');
    let quickViewTrigger;

    const closeQuickView = () => {
      if (!quickView) return;
      quickView.classList.remove('is-open');
      quickView.setAttribute('aria-hidden', 'true');
      if (quickViewTrigger) quickViewTrigger.focus();
    };

    if (quickView) {
      const quickViewTitle = quickView.querySelector('#BundleQuickViewTitle-{{ section.id }}');
      const quickViewDescription = quickView.querySelector('.gift-box-quick-view__description');
      const quickViewImage = quickView.querySelector('.gift-box-quick-view__image');
      const quickViewLink = quickView.querySelector('.gift-box-quick-view__link');
      const quickViewThumbnails = quickView.querySelector('.gift-box-quick-view__thumbnails');
      const quickViewPrice = quickView.querySelector('.gift-box-quick-view__price');
      const quickViewAdd = quickView.querySelector('[data-quick-view-add]');

      root.querySelectorAll('[data-quick-view]').forEach((trigger) =>
        trigger.addEventListener('click', () => {
          quickViewTrigger = trigger;
          const cardButton = trigger.closest('.gift-box-card').querySelector('.gift-box-card__button');
          const title = trigger.dataset.title || '';
          quickViewTitle.textContent = title;
          quickViewDescription.textContent = trigger.dataset.description || '';
          quickViewImage.alt = title;
          quickViewLink.href = trigger.dataset.url || '#';

          const images = (trigger.dataset.images || trigger.dataset.image || '')
            .split('||')
            .filter(Boolean);
          const activeImage = images[0] || trigger.dataset.image || '';
          quickViewImage.src = activeImage;
          quickViewThumbnails.replaceChildren();
          images.forEach((imageUrl, index) => {
            const thumbnail = document.createElement('button');
            thumbnail.type = 'button';
            thumbnail.className = `gift-box-quick-view__thumbnail${index === 0 ? ' is-active' : ''}`;
            thumbnail.setAttribute('aria-label', `View image ${index + 1} of ${title}`);
            const image = document.createElement('img');
            image.src = imageUrl;
            image.alt = '';
            thumbnail.appendChild(image);
            thumbnail.addEventListener('click', () => {
              quickViewImage.src = imageUrl;
              quickViewThumbnails.querySelectorAll('.gift-box-quick-view__thumbnail').forEach((item) => item.classList.remove('is-active'));
              thumbnail.classList.add('is-active');
            });
            quickViewThumbnails.appendChild(thumbnail);
          });

          const price = Number(cardButton.dataset.price);
          const comparePrice = Number(cardButton.dataset.comparePrice);
          quickViewPrice.replaceChildren();
          if (comparePrice > price) {
            const compare = document.createElement('s');
            compare.textContent = formatMoney(comparePrice);
            quickViewPrice.appendChild(compare);
          }
          const currentPrice = document.createElement('span');
          currentPrice.textContent = formatMoney(price);
          quickViewPrice.appendChild(currentPrice);

          const alreadyAdded = items.some((item) => item.id === cardButton.dataset.variantId);
          quickViewAdd.textContent = alreadyAdded ? 'ADDED TO BOX' : 'ADD TO BOX';
          quickViewAdd.disabled = alreadyAdded || items.length >= maxItems || cardButton.disabled;
          quickViewAdd.onclick = () => {
            if (quickViewAdd.disabled) return;
            cardButton.click();
            closeQuickView();
          };
          quickView.classList.add('is-open');
          quickView.setAttribute('aria-hidden', 'false');
          quickViewDialog.focus();
        })
      );
      quickView.querySelectorAll('[data-quick-view-close]').forEach((button) =>
        button.addEventListener('click', closeQuickView)
      );
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && quickView.classList.contains('is-open')) closeQuickView();
      });
    }
    let items = [];

    const formatMoney = (cents) => {
      if (window.Shopify && Shopify.formatMoney) return Shopify.formatMoney(cents, moneyFormat);
      return new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency: '{{ cart.currency.iso_code | default: shop.currency }}',
      }).format(cents / 100);
    };
    const render = () => {
      slots.innerHTML = '';
      for (let index = 0; index < maxItems; index++) {
        const item = items[index];
        const slot = document.createElement('div');
        slot.className = `gift-box-slot${item ? '' : ' gift-box-slot--empty'}`;
        if (item) {
          slot.title = item.title;
          slot.innerHTML = item.image
            ? `<img src="${item.image}" alt="${item.title.replace(/"/g, '&quot;')}">`
            : '<span>Box</span>';
          if (item.removable) {
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.setAttribute('aria-label', `Remove ${item.title}`);
            remove.textContent = '×';
            remove.addEventListener('click', (event) => {
              event.preventDefault();
              event.stopImmediatePropagation();
              items = items.filter((selected) => selected.id !== item.id);
              render();
            }, true);
            slot.appendChild(remove);
          }
        } else slot.textContent = 'Add';
        slots.appendChild(slot);
      }
      const cartTotal = items.reduce((sum, item) => sum + item.price, 0);
      const offerApplied = items.length === maxItems;
      if (offerApplied) {
        const savings = Math.max(0, cartTotal - bundlePrice);
        total.innerHTML = `${cartTotal > bundlePrice ? `<s class="bundle-original-price">${formatMoney(cartTotal)}</s>` : ''}<span>${formatMoney(bundlePrice)}</span>${savings ? `<small class="bundle-savings">Save ${formatMoney(savings)}</small>` : ''}<small class="bundle-offer-label">BUY 4 AT ${formatMoney(bundlePrice)}</small>`;
      } else {
        total.textContent = formatMoney(cartTotal);
      }
      total.classList.toggle('bundle-offer-message', offerApplied);
      checkout.disabled = items.length < minimumItems;
      root.querySelectorAll('.gift-box-card__button').forEach((button) => {
        const added = items.some((item) => item.id === button.dataset.variantId);
        button.classList.toggle('is-added', added);
        button.textContent = added ? 'ADDED' : 'ADD TO BOX';
        button.disabled = added || items.length >= maxItems;
      });
    };
    root.querySelectorAll('.gift-box-card__variants').forEach((select) =>
      select.addEventListener('change', () => {
        const button = select.closest('.gift-box-card').querySelector('.gift-box-card__button');
        const option = select.selectedOptions[0];
        button.dataset.variantId = option.value;
        button.dataset.price = option.dataset.price;
        button.dataset.comparePrice = option.dataset.comparePrice;
        button.dataset.title = option.dataset.title;
        button.dataset.image = option.dataset.image;
        render();
      })
    );
    root.querySelectorAll('.gift-box-card__button').forEach((button) =>
      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopImmediatePropagation();
        if (items.length >= maxItems || items.some((item) => item.id === button.dataset.variantId)) return;
        items.push({
          id: button.dataset.variantId,
          title: button.dataset.title,
          price: Number(button.dataset.price),
          image: button.dataset.image || '',
          removable: true,
        });
        render();
      }, true)
    );
    checkout.addEventListener('click', async (event) => {
      // Ignore repeat clicks while the GoKwik handoff is in progress.
      if (checkout.dataset.bundleReady === 'true') return;

      // This section owns its checkout action. Prevent theme/cart-drawer handlers
      // from treating this first click as a regular cart button.
      event.preventDefault();
      event.stopImmediatePropagation();
      if (items.length < minimumItems) {
        alert(`Please select at least ${minimumItems} products to proceed.`);
        return;
      }
      if (checkout.dataset.loading === 'true') return;
      checkout.dataset.loading = 'true';
      checkout.disabled = true;
      if (checkoutLoader) checkoutLoader.style.display = 'block';
      try {
        const response = await fetch(root.dataset.cartAddUrl + '.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            items: items.map((item) => ({
              id: Number(item.id),
              quantity: 1,
              properties: items.length === maxItems
                ? {
                    _Bundle: 'Buy 4 at 999',
                    _Bundle_Offer: 'BUY 4 AT 999',
                    _Bundle_Price: formatMoney(bundlePrice),
                  }
                : {},
            })),
          }),
        });
        if (!response.ok) throw new Error('Could not add items to cart');
        checkout.dataset.bundleReady = 'true';
        setTimeout(() => {
          if (checkoutLoader) checkoutLoader.style.display = 'none';
          if (typeof onCheckoutClick === 'function') {
            onCheckoutClick(checkout);
          } else {
            window.location.href = '/checkout';
          }
        }, 200);
      } catch (error) {
        checkout.disabled = items.length < minimumItems;
        checkout.dataset.loading = '';
        if (checkoutText) checkoutText.style.display = '';
        if (checkoutLoader) checkoutLoader.style.display = 'none';
        alert(error.message || 'Please try again.');
      }
    }, true);
    render();
  })();
</script>

{% schema %}
{
  "name": "Gift box bundle page",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Products collection",
      "info": "Leave blank to use the current collection page."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your box" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Choose any 4 products for ₹999" },
    { "type": "text", "id": "checkout_label", "label": "Checkout label", "default": "CHECKOUT" },
    { "type": "text", "id": "gokwik_main_title", "label": "GoKwik main title", "default": "CHECKOUT" },
    { "type": "text", "id": "gokwik_sub_title", "label": "GoKwik subtitle", "default": "Secure Payment" }
  ],
  "presets": [{ "name": "Gift box bundle page" }]
}
{% endschema %}
