
{% liquid
  assign bundle_collection = section.settings.collection
  if bundle_collection == blank
    assign bundle_collection = collection
  endif
%}

<section
  id="GiftBoxBundle-{{ section.id }}"
  class="gift-box-bundle"
  data-section-id="{{ section.id }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-checkout-url="{{ routes.checkout_url }}"
  data-currency-format="{{ shop.money_format | escape }}"
>
  <div class="gift-box-bundle__header">
    {% if section.settings.heading != blank %}
      <h1>{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p>{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="gift-box-bundle__grid">
    {% if bundle_collection != blank %}
      {% paginate bundle_collection.products by 250 %}
      {% for product in bundle_collection.products %}
        {% assign current_variant = product.selected_or_first_available_variant %}
        <article class="gift-box-card" data-product-id="{{ product.id }}">
          <div class="gift-box-card__image-wrap">
            <button
              type="button"
              class="gift-box-card__quick-view-trigger"
              aria-label="Quick view {{ product.title | escape }}"
              aria-haspopup="dialog"
              aria-controls="BundleQuickView-{{ section.id }}"
              data-quick-view
              data-title="{{ product.title | escape }}"
              data-description="{{ product.description | strip_html | strip_newlines | escape }}"
              data-url="{{ product.url }}"
              data-image="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 1200 }}{% endif %}"
              data-images="{% for image in product.images limit: 6 %}{{ image | image_url: width: 1200 }}{% unless forloop.last %}||{% endunless %}{% endfor %}"
            >
              <span class="sale-lbl" product-id="{{ product.id }}">BUY 4 AT 999</span>
              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 900
                  | image_tag: class: 'gift-box-card__image', loading: 'lazy', widths: '360, 540, 720, 900'
                }}
              {% endif %}
            </button>
          </div>
          <div class="gift-box-card__content">
            <div class="gift-box-card__title-row">
              <h2>{{ product.title | truncate: 25 }}</h2>
            </div>
            <div class="gift-box-card__prices">
              <span>{{ current_variant.price | money_with_currency }}</span>
              {% if current_variant.compare_at_price > current_variant.price %}
                <s>{{ current_variant.compare_at_price | money_with_currency }}</s>
                {% comment %} <em>
                  {{-
                    current_variant.compare_at_price
                    | minus: current_variant.price
                    | times: 100.0
                    | divided_by: current_variant.compare_at_price
                    | round
                  -}}
                  % OFF</em
                > {% endcomment %}
              {% endif %}
            </div>
            {% if product.variants.size > 1 %}
              <label class="visually-hidden" for="BundleVariant-{{ section.id }}-{{ product.id }}"
                >Choose {{ product.title | escape }} variant</label
              >
              <select id="BundleVariant-{{ section.id }}-{{ product.id }}" class="gift-box-card__variants">
                {% for variant in product.variants %}
                  <option
                    value="{{ variant.id }}"
                    data-price="{{ variant.price }}"
                    data-compare-price="{{ variant.compare_at_price }}"
                    data-title="{{ product.title | escape }}{% unless variant.title == 'Default Title' %} — {{ variant.title | escape }}{% endunless %}"
                    data-image="{% if variant.image != blank %}{{ variant.image | image_url: width: 100 }}{% elsif product.featured_image != blank %}{{ product.featured_image | image_url: width: 100 }}{% endif %}"
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                    {% if variant.id == current_variant.id %}
                      selected
                    {% endif %}
                  >
                    {{ variant.title -}}
                    {%- unless variant.available %} — Sold out{% endunless %}
                  </option>
                {% endfor %}
              </select>
            {% endif %}
            <button
              type="button"
              class="gift-box-card__button"
              {% unless current_variant.available %}
                disabled
              {% endunless %}
              data-variant-id="{{ current_variant.id }}"
              data-price="{{ current_variant.price }}"
              data-compare-price="{{ current_variant.compare_at_price }}"
              data-title="{{ product.title | escape }}"
              data-image="{% if current_variant.image != blank %}{{ current_variant.image | image_url: width: 100 }}{% elsif product.featured_image != blank %}{{ product.featured_image | image_url: width: 100 }}{% endif %}"
            >
              {% if current_variant.available %}ADD TO BOX{% else %}SOLD OUT{% endif %}
            </button>
          </div>
        </article>
      {% endfor %}
      {% endpaginate %}
    {% else %}
      <p class="gift-box-bundle__empty">Select a collection in this section’s settings to display products.</p>
    {% endif %}
  </div>

  <div id="BundleQuickView-{{ section.id }}" class="gift-box-quick-view" aria-hidden="true">
    <div class="gift-box-quick-view__backdrop" data-quick-view-close></div>
    <section class="gift-box-quick-view__dialog" role="dialog" aria-modal="true" aria-labelledby="BundleQuickViewTitle-{{ section.id }}" tabindex="-1">
      <button type="button" class="gift-box-quick-view__close" aria-label="Close quick view" data-quick-view-close>&times;</button>
      <div class="gift-box-quick-view__media">
        <div class="gift-box-quick-view__image-wrap"><img class="gift-box-quick-view__image" src="" alt="" width="900" height="900"></div>
        <div class="gift-box-quick-view__thumbnails" aria-label="Product images"></div>
      </div>
      <div class="gift-box-quick-view__content">
        <div class="gift-box-quick-view__heading"><h2 id="BundleQuickViewTitle-{{ section.id }}"></h2><span class="gift-box-quick-view__size">6 ML</span></div>
        <div class="gift-box-quick-view__price"></div>
        <button type="button" class="gift-box-quick-view__add" data-quick-view-add>ADD TO BOX</button>
        <div class="gift-box-quick-view__description"></div>
        <a class="gift-box-quick-view__link" href="#">
          <span>View full product details</span>
          <svg aria-hidden="true" viewBox="0 0 20 20" focusable="false"><path d="M3 10h13M11 5l5 5-5 5"></path></svg>
        </a>
      </div>
    </section>
  </div>

  <div class="gift-box-bundle__bar" aria-live="polite">
    <div class="gift-box-bundle__slots"></div>
    <div class="gift-box-bundle__summary">
      <div class="gift-box-bundle__total"><span>Total</span><strong></strong></div>
      <div class="bundle-gokwik-checkout" id="bundle-gokwik-checkout-{{ section.id }}">
        <button type="button" class="button bundle-checkout-btn" id="bundle-checkout-btn-{{ section.id }}">
          <span class="btn-text">
            <span>{{ section.settings.gokwik_main_title | default: 'CHECKOUT' }}</span>
            <span>{{ section.settings.gokwik_sub_title | default: 'Secure Payment' }}</span>
          </span>
          <span class="pay-opt-icon">
            <img src="https://cdn.gokwik.co/v4/images/upi-icons.svg" alt="UPI">
            <img src="https://cdn.gokwik.co/v4/images/right-arrow.svg" alt="Arrow">
          </span>
          <div style="display:none" class="addloadr" id="btn-loader-{{ section.id }}"><div class="cir-loader">Loading..</div></div>
        </button>
      </div>
    </div>
  </div>
</section>

