{%- liquid
  assign recommendation_collection = collections['rings']
  assign recommendation_heading = 'You may also like'
  assign recommendation_subtitle = 'Buy 1 Get 1 FREE | Get 2 Rings at 399/'
-%}

{%- if recommendation_collection != blank and recommendation_collection.products_count > 0 -%}
  <div class="zeraki-cart-recommendations">
    <div class="zeraki-cart-recommendations__header">
      <h2 class="zeraki-cart-recommendations__title">{{ recommendation_heading }}</h2>
      <p class="zeraki-cart-recommendations__subtitle">{{ recommendation_subtitle }}</p>
    </div>

    <div class="zeraki-cart-recommendations__track">
      {%- for product in recommendation_collection.products limit: 8 -%}
        {%- if product.available -%}
          <a class="zeraki-cart-recommendations__card" href="{{ product.url }}">
            <div class="zeraki-cart-recommendations__image-wrap">
              {%- if product.featured_image != blank -%}
                <img
                  class="zeraki-cart-recommendations__image"
                  src="{{ product.featured_image | image_url: width: 240 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                  width="88"
                  height="110"
                >
              {%- endif -%}
            </div>

            <div class="zeraki-cart-recommendations__content">
              <h3 class="zeraki-cart-recommendations__product-title">
                {{ product.title | strip_html | truncate: 42 }}
              </h3>
              <div class="zeraki-cart-recommendations__price">
                {{ product.price | money }}
              </div>
              <span class="zeraki-cart-recommendations__button">View</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <style>
    .zeraki-cart-recommendations {
      margin: 24px 0;
      padding: 0 12px;
    }

    .zeraki-cart-recommendations__header {
      margin-bottom: 14px;
    }

    .zeraki-cart-recommendations__title {
      margin: 0;
      color: #19140f;
      font-size: 32px;
      line-height: 1.1;
      font-weight: 500;
      letter-spacing: 0;
    }

    .zeraki-cart-recommendations__subtitle {
      margin: 8px 0 0;
      color: #9d6f14;
      font-size: 16px;
      line-height: 1.35;
      font-weight: 500;
    }

    .zeraki-cart-recommendations__track {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      padding-bottom: 10px;
      scroll-snap-type: x proximity;
      -ms-overflow-style: none;
      scrollbar-width: thin;
      scrollbar-color: #8d8d8d transparent;
    }

    .zeraki-cart-recommendations__track::-webkit-scrollbar {
      height: 5px;
    }

    .zeraki-cart-recommendations__track::-webkit-scrollbar-track {
      background: transparent;
    }

    .zeraki-cart-recommendations__track::-webkit-scrollbar-thumb {
      background: #8d8d8d;
      border-radius: 999px;
    }

    .zeraki-cart-recommendations__card {
      min-width: 248px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 8px;
      border: 1px solid #dcc17b;
      border-radius: 14px;
      background: linear-gradient(180deg, #fff7df 0%, #fff0c7 100%);
      text-decoration: none;
      scroll-snap-align: start;
      box-shadow: 0 2px 8px rgba(116, 83, 16, 0.08);
    }

    .zeraki-cart-recommendations__image-wrap {
      flex: 0 0 76px;
      width: 76px;
      height: 96px;
      border-radius: 10px;
      overflow: hidden;
      background: #f7ecd0;
    }

    .zeraki-cart-recommendations__image {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .zeraki-cart-recommendations__content {
      flex: 1 1 auto;
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding-top: 2px;
    }

    .zeraki-cart-recommendations__product-title {
      margin: 0 0 8px;
      color: #1d1b18;
      font-size: 15px;
      line-height: 1.2;
      font-weight: 500;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .zeraki-cart-recommendations__price {
      margin: 0 0 12px;
      color: #d61f1f;
      font-size: 16px;
      line-height: 1;
      font-weight: 600;
    }

    .zeraki-cart-recommendations__button {
      min-width: 82px;
      padding: 8px 18px;
      border: 1px solid #d7bc79;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.55);
      color: #3b2b08;
      font-size: 15px;
      line-height: 1;
      font-weight: 500;
      text-align: center;
    }

    @media screen and (max-width: 749px) {
      .zeraki-cart-recommendations {
        padding: 0 8px;
      }

      .zeraki-cart-recommendations__title {
        font-size: 24px;
      }

      .zeraki-cart-recommendations__subtitle {
        font-size: 14px;
      }

      .zeraki-cart-recommendations__card {
        min-width: 220px;
      }
    }
  </style>
{%- endif -%}
