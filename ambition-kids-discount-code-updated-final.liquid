<script>

(function () {
  const COLLECTION_HANDLE = 'app-test-discount-products';
  const FIXED_PRICE = 399;
  const BUNDLE_TAG = 'STEAL DEAL @ RS. 399';
  const TARGET_SELECTOR = '.mob_upsell';
  const SECTION_TITLE = 'Steal Deals';

  let stealDealProducts = [];
  let dataLoaded = false;
  let preloadPromise = null;
  let isRemovingDiscountItems = false;
  let isSyncingDrawer = false;
  let syncScheduled = false;
  let lastCartSignature = '';
  const activeAddButtons = new Set();

  async function getCart() {
    return fetch('/cart.js', {
      headers: { Accept: 'application/json' },
      credentials: 'same-origin',
      cache: 'no-store',
    }).then((r) => r.json());
  }

  function getDiscountedItems(cart) {
    return cart.items.filter(
      (item) => item.properties && item.properties.bundle_type === BUNDLE_TAG
    );
  }

  function getNonDiscountedItems(cart) {
    return cart.items.filter(
      (item) => !item.properties || item.properties.bundle_type !== BUNDLE_TAG
    );
  }

  async function preloadProducts() {
    if (dataLoaded) return stealDealProducts;
    if (preloadPromise) return preloadPromise;

    preloadPromise = fetch(`/collections/${COLLECTION_HANDLE}/products.json?limit=50`, {
      headers: { Accept: 'application/json' },
      credentials: 'same-origin',
    })
      .then((res) => res.json())
      .then((data) => {
        stealDealProducts = data.products || [];
        dataLoaded = true;
        return stealDealProducts;
      })
      .catch((err) => {
        console.error('[Steal Deals] Load error:', err);
        return [];
      })
      .finally(() => {
        preloadPromise = null;
      });

    return preloadPromise;
  }

  function removeStealDealsContainer() {
    const container = document.getElementById('steal-deals-wrapper');
    if (container) container.remove();
  }

  function openCartDrawer() {
    setTimeout(() => {
      if (window.CartDrawerPremium?.open) {
        window.CartDrawerPremium.open();
      }
    }, 800);
  }

  function injectIntoDrawer() {
    const target = document.querySelector(TARGET_SELECTOR);
    if (!target) return;
    if (document.getElementById('steal-deals-wrapper')) return;
    if (!stealDealProducts.length) return;

    const cardsHTML = stealDealProducts.map((p) => {
      const v = p.variants.find((x) => x.available) || p.variants[0];
      if (!v) return '';

      const img = v.featured_image?.src || p.images[0]?.src || '';
      const price = parseInt(v.price, 10);
      const off = price > FIXED_PRICE
        ? Math.round(((price - FIXED_PRICE) / price) * 100)
        : 0;
      const safeTitle = p.title.replace(/"/g, '&quot;');

      return `
        <div class="sd-card">
          <div class="sd-img-wrap">
            ${off > 0 ? `<span class="sd-off">-${off}% OFF</span>` : ''}
            <img src="${img}" alt="${safeTitle}" loading="lazy" />
          </div>
          <div class="sd-info">
            <h4>${safeTitle}</h4>
            <div>
              <span class="sd-price">₹${FIXED_PRICE}</span>
              <span class="sd-old">₹${price}</span>
            </div>
          </div>
          <button class="sd-add" data-id="${v.id}" type="button">+</button>
        </div>
      `;
    }).join('');

    const wrapper = document.createElement('div');
    wrapper.id = 'steal-deals-wrapper';
    wrapper.innerHTML = `
      <div class="sd-header">${SECTION_TITLE}
      <div class="unloacked-wrapper">
<svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 576 512" height="10" width="10" xmlns="http://www.w3.org/2000/svg"><path d="M423.5 0C339.5.3 272 69.5 272 153.5V224H48c-26.5 0-48 21.5-48 48v192c0 26.5 21.5 48 48 48h352c26.5 0 48-21.5 48-48V272c0-26.5-21.5-48-48-48h-48v-71.1c0-39.6 31.7-72.5 71.3-72.9 40-.4 72.7 32.1 72.7 72v80c0 13.3 10.7 24 24 24h32c13.3 0 24-10.7 24-24v-80C576 68 507.5-.3 423.5 0z"></path></svg>
    UNLOCKED 
</div>
      
      </div>
      <div id="steal-deals-container">${cardsHTML}</div>
    `;

    target.insertAdjacentElement('afterend', wrapper);
  }

  function getCartSignature(cart) {
    return cart.items
      .map((item) => `${item.key}:${item.quantity}`)
      .sort()
      .join('|');
  }

  function dispatchCartRefreshEvents() {
    document.dispatchEvent(new CustomEvent('cart:updated'));
    document.dispatchEvent(new CustomEvent('cart:refresh'));
    document.dispatchEvent(new CustomEvent('cart-drawer:updated'));
  }

  async function syncDrawerContent(force) {
    if (isSyncingDrawer) return;

    const target = document.querySelector(TARGET_SELECTOR);
    if (!target) {
      removeStealDealsContainer();
      return;
    }

    isSyncingDrawer = true;

    try {
      await preloadProducts();

      const cart = await getCart();
      const signature = getCartSignature(cart);

      if (!force && signature === lastCartSignature && document.getElementById('steal-deals-wrapper')) {
        return;
      }

      lastCartSignature = signature;

      const nonDiscounted = getNonDiscountedItems(cart);

      if (nonDiscounted.length > 0) {
        if (!document.getElementById('steal-deals-wrapper')) {
          injectIntoDrawer();
        }
      } else {
        removeStealDealsContainer();
      }
    } catch (err) {
      console.error('[Steal Deals] Drawer sync error:', err);
    } finally {
      isSyncingDrawer = false;
    }
  }

  function scheduleDrawerSync(force) {
    if (syncScheduled) return;

    syncScheduled = true;
    window.setTimeout(() => {
      syncScheduled = false;
      syncDrawerContent(force);
    }, 120);
  }

  async function removeDiscountedItemsIfMainMissing() {
    if (isRemovingDiscountItems) return;

    try {
      const cart = await getCart();
      const discounted = getDiscountedItems(cart);
      const nonDiscounted = getNonDiscountedItems(cart);

      if (discounted.length > 0 && nonDiscounted.length === 0) {
        isRemovingDiscountItems = true;

        const updates = {};
        discounted.forEach((item) => {
          updates[item.key] = 0;
        });

        await fetch('/cart/update.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          credentials: 'same-origin',
          body: JSON.stringify({ updates }),
        });

        lastCartSignature = '';
        dispatchCartRefreshEvents();

        removeStealDealsContainer();
        openCartDrawer();
      }
    } catch (err) {
      console.error('[Steal Deals] Remove discounted items error:', err);
    } finally {
      isRemovingDiscountItems = false;
    }
  }

  async function enforceDependency() {
    try {
      const cart = await getCart();
      const discounted = getDiscountedItems(cart);
      const nonDiscounted = getNonDiscountedItems(cart);

      if (nonDiscounted.length === 0) {
        removeStealDealsContainer();
      }

      if (discounted.length > 0 && nonDiscounted.length === 0) {
        await removeDiscountedItemsIfMainMissing();
      }
    } catch (err) {
      console.error('[Steal Deals] Dependency check error:', err);
    }
  }

  function setButtonLoading(btn) {
    if (!btn.dataset.originalText) {
      btn.dataset.originalText = btn.textContent;
    }

    btn.disabled = true;
    btn.classList.add('is-loading');
    btn.classList.remove('is-success');
    btn.textContent = '...';
    btn.style.pointerEvents = 'none';
  }

  function setButtonSuccess(btn) {
    btn.classList.remove('is-loading');
    btn.classList.add('is-success');
    btn.textContent = '✓';
  }

  function resetButton(btn) {
    btn.disabled = false;
    btn.classList.remove('is-loading', 'is-success');
    btn.textContent = btn.dataset.originalText || '+';
    btn.style.pointerEvents = '';
  }

  async function addDiscountProduct(variantId, btn) {
    if (activeAddButtons.has(variantId)) return;

    activeAddButtons.add(variantId);
    setButtonLoading(btn);

    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        credentials: 'same-origin',
        body: JSON.stringify({
          items: [
            {
              id: parseInt(variantId, 10),
              quantity: 1,
              properties: {
                bundle_type: BUNDLE_TAG,
              },
            },
          ],
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.description || result.message || 'Unable to add product');
      }

      setButtonSuccess(btn);

      lastCartSignature = '';
      dispatchCartRefreshEvents();

      openCartDrawer();

      setTimeout(() => {
        activeAddButtons.delete(variantId);
        resetButton(btn);
      }, 900);
    } catch (err) {
      console.error('[Steal Deals] Add error:', err);
      activeAddButtons.delete(variantId);
      resetButton(btn);
      alert(err.message || 'Unable to add product. Please try again.');
    }
  }

  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.sd-add');
    if (!btn) return;

    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();

    if (btn.disabled || btn.classList.contains('is-loading')) {
      return;
    }

    addDiscountProduct(btn.dataset.id, btn);
  }, true);

  const observer = new MutationObserver((mutations) => {
    const shouldSync = mutations.some((mutation) => {
      return Array.from(mutation.addedNodes).some((node) => {
        return node.nodeType === 1 && (
          node.matches?.(TARGET_SELECTOR) ||
          node.querySelector?.(TARGET_SELECTOR)
        );
      });
    });

    if (shouldSync) {
      scheduleDrawerSync(false);
    }
  });

  observer.observe(document.body, { childList: true, subtree: true });

  document.addEventListener('change', (e) => {
    if (e.target.matches('input[name="updates[]"], [data-cart-quantity]')) {
      setTimeout(() => {
        lastCartSignature = '';
        enforceDependency();
        scheduleDrawerSync(true);
      }, 800);
    }
  });

  document.addEventListener('click', (e) => {
    const removeLink = e.target.closest(
      'a[href*="/cart/change?"], a[href*="quantity=0"], [data-cart-remove]'
    );
    if (removeLink) {
      setTimeout(() => {
        lastCartSignature = '';
        enforceDependency();
        scheduleDrawerSync(true);
      }, 800);
    }
  });

  ['cart:updated', 'cart:refresh', 'cart-drawer:updated', 'cart:opened'].forEach((evt) => {
    document.addEventListener(evt, () => {
      setTimeout(() => {
        lastCartSignature = '';
        enforceDependency();
        scheduleDrawerSync(true);
      }, 500);
    });
  });

  function init() {
    preloadProducts();
    enforceDependency();
    scheduleDrawerSync(true);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<style>
  #steal-deals-wrapper {
    padding: 10px 0 0;
    background: #fff;
    border-radius: 7px;
  }

  .sd-header {
    font-size: 16px;
    font-weight: 700;
    color: #111;
    margin: 0 10px 10px;
  }

  #steal-deals-container {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 0 10px 10px;
  }

  .sd-card {
    min-width: 260px;
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 8px;
    border: 1px solid #eee;
    border-radius: 10px;
    background: #fff;
  }

  .sd-img-wrap {
    position: relative;
  }

  .sd-img-wrap img {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: 6px;
  }

  .sd-off {
    position: absolute;
    top: -3px;
    left: -3px;
    background: #b8e57c;
    color: #1a4d00;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 5px;
    border-radius: 3px;
  }

  .sd-info {
    flex: 1;
  }

  .sd-info h4 {
    font-size: 12px;
    margin: 0 0 4px;
    line-height: 1.3;
  }

  .sd-price {
    font-weight: 700;
    font-size: 13px;
  }

  .sd-old {
    text-decoration: line-through;
    color: #999;
    font-size: 11px;
    margin-left: 4px;
  }

  .sd-add {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #000;
    color: #fff;
    border: none;
    font-size: 31px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.15s ease, opacity 0.2s ease, background 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  .sd-add:hover {
    transform: scale(1.05);
  }

  .sd-add:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .sd-add.is-loading {
    background: #444;
  }

  .sd-add.is-success {
    background: #1a8f3c;
    font-size: 18px;
  }
  .mob_upsell{height:0!important;}

  .unloacked-wrapper {
    padding: 4px 13px;
    border-radius: 30px;
    background: green;
    color: #fff;
    font-size: 11px;
}
</style>
