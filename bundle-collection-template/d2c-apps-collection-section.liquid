{%- liquid
  assign current_collection = collection
  assign bundle_two_price = section.settings.bundle_2_price | times: 100
  assign bundle_three_price = section.settings.bundle_3_price | times: 100
-%}

<section
  class="bundle-collection bundle-collection--{{ section.id }}"
  data-bundle-collection
  data-section-id="{{ section.id }}"
  data-currency-code="{{ cart.currency.iso_code | default: shop.currency }}"
  data-bundle-two-price="{{ bundle_two_price }}"
  data-bundle-three-price="{{ bundle_three_price }}"
  data-bundle-limit="3"
>
  <div class="bundle-collection__shell page-width">
    <div class="bundle-collection__products">
      <div class="bundle-collection__header">
        <p class="bundle-collection__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="bundle-collection__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.description != blank -%}
          <div class="bundle-collection__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>

      {%- if current_collection != blank and current_collection.products_count > 0 -%}
        <div class="bundle-collection__grid">
          {%- for product in current_collection.products -%}
            {% render 'collection-snippet', product: product %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="bundle-collection__empty">
          Add this section to a collection template to show bundle products.
        </div>
      {%- endif -%}
    </div>

    <aside class="bundle-collection__summary">
      <div class="bundle-collection__summary-card">
        <p class="bundle-collection__summary-eyebrow">Create Your Bundle</p>
        <h3 class="bundle-collection__summary-title">{{ section.settings.sidebar_heading }}</h3>

        <div class="bundle-collection__status" data-bundle-status>
          Choose 2 products to start your bundle.
        </div>

        <div class="bundle-collection__progress">
          <div class="bundle-collection__progress-steps">
            <span data-progress-step="1">1</span>
            <span data-progress-step="2">2</span>
            <span data-progress-step="3">3</span>
          </div>
          <p class="bundle-collection__progress-text" data-progress-text>
            Choose 2 or 3 products to unlock bundle pricing.
          </p>
        </div>

        <div class="bundle-collection__selected" data-selected-list>
          <div class="bundle-collection__selected-empty">
            Your selected products will appear here.
          </div>
        </div>

        <div class="bundle-collection__totals">
          <div class="bundle-collection__total-row">
            <span>Subtotal</span>
            <strong data-regular-total>{{ 0 | money }}</strong>
          </div>
          <div class="bundle-collection__total-row">
            <span>Bundle discount</span>
            <strong data-bundle-discount>-{{ 0 | money }}</strong>
          </div>
          <div class="bundle-collection__total-row bundle-collection__total-row--highlight">
            <span>Bundle total</span>
            <strong data-bundle-total>{{ 0 | money }}</strong>
          </div>
          <div class="bundle-collection__total-row bundle-collection__total-row--savings">
            <span>You save</span>
            <strong data-bundle-savings>{{ 0 | money }}</strong>
          </div>
        </div>

        <button
          type="button"
          class="bundle-collection__cta"
          data-bundle-submit
          disabled
        >
          Add bundle to cart
        </button>

        <p class="bundle-collection__fineprint">{{ section.settings.footer_note }}</p>
      </div>
    </aside>
  </div>

  <div class="bundle-collection__modal" data-variant-modal hidden>
    <div class="bundle-collection__modal-backdrop" data-modal-close></div>
    <div class="bundle-collection__modal-dialog" role="dialog" aria-modal="true" aria-labelledby="bundle-modal-title-{{ section.id }}">
      <button type="button" class="bundle-collection__modal-close" data-modal-close aria-label="Close">x</button>
      <p class="bundle-collection__modal-eyebrow">Select variant</p>
      <h3 id="bundle-modal-title-{{ section.id }}" class="bundle-collection__modal-title" data-modal-product-title></h3>
      <div class="bundle-collection__modal-options" data-modal-options></div>
      <button type="button" class="bundle-collection__modal-submit" data-modal-submit disabled>
        Add variant to bundle
      </button>
    </div>
  </div>

  <style>
    .bundle-collection {
      --bundle-bg: {{ section.settings.background_color }};
      --bundle-card: {{ section.settings.card_color }};
      --bundle-text: {{ section.settings.text_color }};
      --bundle-muted: {{ section.settings.muted_text_color }};
      --bundle-accent: {{ section.settings.accent_color }};
      --bundle-accent-soft: {{ section.settings.accent_soft_color }};
      --bundle-border: {{ section.settings.border_color }};
      --bundle-shadow: 0 20px 60px rgba(17, 24, 39, 0.08);
      background:
        radial-gradient(circle at top right, rgba(255, 255, 255, 0.8), transparent 26%),
        linear-gradient(180deg, #fffaf4 0%, var(--bundle-bg) 100%);
      color: var(--bundle-text);
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }

    .bundle-collection__shell {
      display: grid;
      grid-template-columns: minmax(0, 1.5fr) minmax(320px, 420px);
      gap: 32px;
      align-items: start;
    }

    .bundle-collection__header {
      margin-bottom: 24px;
    }

    .bundle-collection__eyebrow,
    .bundle-collection__summary-eyebrow,
    .bundle-collection__modal-eyebrow {
      margin: 0 0 10px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--bundle-accent);
    }

    .bundle-collection__title,
    .bundle-collection__summary-title,
    .bundle-collection__modal-title {
      margin: 0;
      font-size: clamp(28px, 3vw, 42px);
      line-height: 1.05;
      color: var(--bundle-text);
    }

    .bundle-collection__summary-title,
    .bundle-collection__modal-title {
      font-size: 28px;
    }

    .bundle-collection__description,
    .bundle-collection__fineprint {
      color: var(--bundle-muted);
      font-size: 15px;
      line-height: 1.6;
    }

    .bundle-collection__grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
      gap: 18px;
    }

    .bundle-collection__card {
      background: var(--bundle-card);
      border: 1px solid var(--bundle-border);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(17, 24, 39, 0.08);
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .bundle-collection__card.is-selected {
      transform: translateY(-4px);
      border-color: var(--bundle-accent);
      box-shadow: 0 24px 50px rgba(13, 148, 136, 0.18);
    }

    .bundle-collection__card-media {
      position: relative;
      padding: 6px 6px 0;
      background: #fff;
    }

    .bundle-collection__card-link {
      display: block;
      border-radius: 0;
      overflow: hidden;
      background: #fff;
      aspect-ratio: 0.8 / 1;
    }

    .bundle-collection__card-image,
    .bundle-collection__card-placeholder {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .bundle-collection__card-placeholder {
      background: linear-gradient(135deg, #f6efe7, #ece3d7);
    }

    .bundle-collection__card-badge {
      position: absolute;
      left: 12px;
      bottom: 12px;
      background: #0a8a16;
      color: #fff;
      border-radius: 2px;
      padding: 6px 10px;
      font-size: 12px;
      line-height: 1;
      font-weight: 800;
      text-transform: uppercase;
    }

    .bundle-collection__card-body {
      padding: 14px 12px 12px;
    }

    .bundle-collection__card-title {
      color: var(--bundle-text);
      text-decoration: none;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: 17px;
      font-weight: 700;
      line-height: 1.3;
    }

    .bundle-collection__card-sizes {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 12px 0 10px;
    }

    .bundle-collection__card-size,
    .bundle-collection__card-size-more {
      min-width: 34px;
      min-height: 30px;
      padding: 6px 10px;
      border: 1px solid #d4d4d8;
      background: #fff;
      color: var(--bundle-text);
      font-size: 12px;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .bundle-collection__card-size.is-active {
      background: #111111;
      color: #fff;
      border-color: #111111;
    }

    .bundle-collection__card-size-more {
      border-color: transparent;
      color: var(--bundle-muted);
      padding-inline: 0;
    }

    .bundle-collection__card-colors {
      display: flex;
      gap: 8px;
      margin-bottom: 12px;
    }

    .bundle-collection__card-color {
      width: 26px;
      height: 26px;
      border-radius: 999px;
      background: var(--card-swatch-color);
      box-shadow: inset 0 0 0 1px rgba(17, 24, 39, 0.12);
    }

    .bundle-collection__card-color.is-active {
      box-shadow:
        0 0 0 2px #fff,
        0 0 0 3px #111111;
    }

    .bundle-collection__card-price-row,
    .bundle-collection__total-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .bundle-collection__card-price-row {
      margin: 0 0 10px;
    }

    .bundle-collection__card-price {
      font-size: 18px;
      font-weight: 800;
    }

    .bundle-collection__card-compare {
      color: var(--bundle-muted);
      text-decoration: line-through;
      font-size: 14px;
      font-weight: 600;
    }

    .bundle-collection__card-meta {
      margin: 0;
      color: var(--bundle-muted);
      font-size: 12px;
    }

    .bundle-collection__card-footer {
      display: grid;
      gap: 10px;
    }

    .bundle-collection__card-toggle {
      width: 100%;
      border: 1px solid #111111;
      border-radius: 4px;
      padding: 14px 18px;
      background: #fff;
      color: #111111;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .bundle-collection__card.is-selected .bundle-collection__card-toggle {
      background: var(--bundle-accent);
      border-color: var(--bundle-accent);
      color: #fff;
    }

    .bundle-collection__summary {
      position: sticky;
      top: 24px;
    }

    .bundle-collection__summary-card {
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(14px);
      border: 1px solid var(--bundle-border);
      border-radius: 28px;
      padding: 24px;
      box-shadow: var(--bundle-shadow);
    }

    .bundle-collection__totals {
      display: grid;
      gap: 12px;
    }

    .bundle-collection__status {
      margin: 14px 0 18px;
      padding: 14px 16px;
      border-radius: 18px;
      background: var(--bundle-accent-soft);
      border: 1px solid var(--bundle-accent);
      color: var(--bundle-text);
      font-size: 14px;
      font-weight: 700;
    }

    .bundle-collection__progress {
      margin: 20px 0;
      padding: 16px;
      border-radius: 20px;
      background: #fff;
      border: 1px solid var(--bundle-border);
    }

    .bundle-collection__progress-steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 12px;
    }

    .bundle-collection__progress-steps span {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 38px;
      border-radius: 999px;
      border: 1px solid var(--bundle-border);
      background: #f8f5ef;
      color: var(--bundle-muted);
      font-size: 13px;
      font-weight: 800;
    }

    .bundle-collection__progress-steps span.is-active {
      background: var(--bundle-accent);
      border-color: var(--bundle-accent);
      color: #fff;
    }

    .bundle-collection__progress-text {
      margin: 0;
      font-size: 14px;
      color: var(--bundle-muted);
    }

    .bundle-collection__selected {
      display: grid;
      gap: 10px;
      margin-bottom: 20px;
    }

    .bundle-collection__selected-empty,
    .bundle-collection__selected-item {
      border-radius: 18px;
      border: 1px dashed var(--bundle-border);
      padding: 14px 16px;
      background: rgba(255, 255, 255, 0.75);
    }

    .bundle-collection__selected-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      border-style: solid;
    }

    .bundle-collection__selected-main {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .bundle-collection__selected-thumb {
      flex: 0 0 52px;
      width: 52px;
      height: 52px;
      border-radius: 14px;
      object-fit: cover;
      background: #f4efe8;
      display: block;
    }

    .bundle-collection__selected-copy {
      min-width: 0;
    }

    .bundle-collection__selected-item strong {
      display: block;
      font-size: 14px;
      margin-bottom: 4px;
    }

    .bundle-collection__selected-item p {
      margin: 0;
      color: var(--bundle-muted);
      font-size: 12px;
    }

    .bundle-collection__selected-side {
      text-align: right;
      flex: 0 0 auto;
    }

    .bundle-collection__selected-remove {
      border: 0;
      background: transparent;
      color: var(--bundle-accent);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      padding: 0;
    }

    .bundle-collection__totals {
      margin-bottom: 20px;
    }

    .bundle-collection__total-row {
      font-size: 14px;
      color: var(--bundle-muted);
    }

    .bundle-collection__total-row strong {
      color: var(--bundle-text);
      font-size: 16px;
    }

    .bundle-collection__total-row[data-empty='true'] strong,
    .bundle-collection__total-row[data-empty='true'] span {
      opacity: 0.7;
    }

    .bundle-collection__total-row--highlight {
      padding: 14px 16px;
      border-radius: 18px;
      background: #fff;
      border: 1px solid var(--bundle-accent);
    }

    .bundle-collection__total-row--savings strong {
      color: var(--bundle-accent);
    }

    .bundle-collection__cta,
    .bundle-collection__modal-submit {
      width: 100%;
      min-height: 52px;
      border: 0;
      border-radius: 999px;
      background: var(--bundle-text);
      color: #fff;
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .bundle-collection__cta[disabled],
    .bundle-collection__modal-submit[disabled] {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .bundle-collection__fineprint {
      margin: 12px 0 0;
      font-size: 12px;
    }

    .bundle-collection__empty {
      padding: 32px;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.75);
      border: 1px solid var(--bundle-border);
    }

    .bundle-collection__modal[hidden] {
      display: none;
    }

    .bundle-collection__modal {
      position: fixed;
      inset: 0;
      z-index: 40;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .bundle-collection__modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(15, 23, 42, 0.5);
    }

    .bundle-collection__modal-dialog {
      position: relative;
      width: min(100%, 520px);
      max-height: calc(100vh - 40px);
      overflow: auto;
      background: #fff;
      border-radius: 28px;
      padding: 24px;
      box-shadow: 0 30px 80px rgba(15, 23, 42, 0.22);
    }

    .bundle-collection__modal-close {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 38px;
      height: 38px;
      border-radius: 999px;
      border: 0;
      background: #f4f1eb;
      color: var(--bundle-text);
      font-size: 24px;
      cursor: pointer;
    }

    .bundle-collection__modal-options {
      display: grid;
      gap: 18px;
      margin: 18px 0 20px;
    }

    .bundle-collection__option-group {
      display: grid;
      gap: 10px;
    }

    .bundle-collection__option-title {
      margin: 0;
      color: var(--bundle-muted);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .bundle-collection__option-values {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .bundle-collection__variant-chip {
      border: 1px solid var(--bundle-border);
      border-radius: 999px;
      background: #fff;
      color: var(--bundle-text);
      min-height: 42px;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
    }

    .bundle-collection__variant-chip.is-selected {
      border-color: var(--bundle-accent);
      background: var(--bundle-accent-soft);
      color: var(--bundle-text);
    }

    .bundle-collection__variant-chip[disabled] {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .bundle-collection__variant-chip--color {
      width: 52px;
      min-width: 52px;
      padding: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .bundle-collection__variant-swatch {
      width: 30px;
      height: 30px;
      border-radius: 999px;
      border: 2px solid rgba(255, 255, 255, 0.9);
      box-shadow: 0 0 0 1px rgba(24, 24, 27, 0.12);
      background: var(--swatch-color, linear-gradient(135deg, #d6d3d1, #f5f5f4));
      flex: 0 0 auto;
    }

    .bundle-collection__variant-summary {
      margin: 0 0 4px;
      color: var(--bundle-text);
      font-size: 14px;
      font-weight: 700;
    }

    .bundle-collection__variant-stock {
      margin: 0;
      color: var(--bundle-muted);
      font-size: 12px;
    }

    @media (max-width: 989px) {
      .bundle-collection__shell {
        grid-template-columns: 1fr;
      }

      .bundle-collection__summary {
        position: static;
        order: -1;
      }
    }

    @media (max-width: 749px) {
      .bundle-collection {
        padding-top: 20px;
        padding-bottom: 20px;
      }

      .bundle-collection__shell {
        gap: 18px;
      }

      .bundle-collection__grid {
        grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
        gap: 12px;
      }

      .bundle-collection__summary-card,
      .bundle-collection__modal-dialog {
        padding: 16px;
        border-radius: 22px;
      }

      .bundle-collection__summary-card {
        position: sticky;
        top: 10px;
        z-index: 5;
      }

      .bundle-collection__card-toggle {
        left: 28px;
        right: 28px;
        width: calc(100% - 56px);
        bottom: 24px;
      }

      .bundle-collection__summary-eyebrow {
        margin-bottom: 6px;
      }

      .bundle-collection__summary-title {
        font-size: 22px;
      }

      .bundle-collection__status {
        margin: 10px 0 12px;
        padding: 12px 14px;
        font-size: 13px;
      }

      .bundle-collection__progress {
        margin: 0 0 12px;
        padding: 12px;
        border-radius: 16px;
      }

      .bundle-collection__progress-steps {
        gap: 8px;
        margin-bottom: 8px;
      }

      .bundle-collection__progress-steps span {
        min-height: 34px;
        font-size: 12px;
      }

      .bundle-collection__progress-text {
        font-size: 12px;
      }

      .bundle-collection__selected {
        gap: 8px;
        margin-bottom: 12px;
      }

      .bundle-collection__selected-empty,
      .bundle-collection__selected-item {
        padding: 10px 12px;
        border-radius: 14px;
      }

      .bundle-collection__selected-thumb {
        width: 42px;
        height: 42px;
        border-radius: 10px;
      }

      .bundle-collection__selected-item strong {
        font-size: 13px;
      }

      .bundle-collection__selected-item p,
      .bundle-collection__selected-remove {
        font-size: 11px;
      }

      .bundle-collection__totals {
        gap: 8px;
        margin-bottom: 12px;
      }

      .bundle-collection__total-row {
        font-size: 12px;
      }

      .bundle-collection__total-row strong {
        font-size: 14px;
      }

      .bundle-collection__total-row--highlight {
        padding: 12px 14px;
        border-radius: 14px;
      }

      .bundle-collection__cta {
        min-height: 46px;
        font-size: 14px;
      }

      .bundle-collection__fineprint {
        margin-top: 8px;
        font-size: 11px;
      }

      .bundle-collection__card {
        border-radius: 10px;
      }

      .bundle-collection__card-media {
        padding: 4px 4px 0;
      }

      .bundle-collection__card-link {
        aspect-ratio: 0.83 / 1;
      }

      .bundle-collection__card-body {
        padding: 12px 10px 10px;
      }

      .bundle-collection__card-title {
        font-size: 14px;
      }

      .bundle-collection__card-price {
        font-size: 15px;
      }

      .bundle-collection__card-meta {
        font-size: 11px;
      }

      .bundle-collection__card-sizes {
        gap: 4px;
        margin: 10px 0 8px;
      }

      .bundle-collection__card-size,
      .bundle-collection__card-size-more {
        min-width: 28px;
        min-height: 26px;
        padding: 5px 8px;
        font-size: 11px;
      }

      .bundle-collection__card-colors {
        gap: 6px;
        margin-bottom: 10px;
      }

      .bundle-collection__card-color {
        width: 22px;
        height: 22px;
      }

      .bundle-collection__card-badge {
        left: 8px;
        right: 8px;
        bottom: 8px;
        font-size: 10px;
        padding: 6px 8px;
      }

      .bundle-collection__card-toggle {
        padding: 12px 14px;
        font-size: 11px;
        letter-spacing: 0.14em;
      }

      .bundle-collection__products .bundle-collection__header {
        margin-bottom: 14px;
      }

      .bundle-collection__modal-options {
        gap: 10px;
      }

      .bundle-collection__option-values {
        gap: 8px;
      }

      .bundle-collection__variant-chip {
        min-height: 38px;
        padding: 8px 14px;
        font-size: 12px;
      }

      .bundle-collection__variant-chip--color {
        width: 46px;
        min-width: 46px;
      }
    }
  </style>

  <script>
    (() => {
      const section = document.querySelector('.bundle-collection--{{ section.id }}');
      if (!section) return;

      const bundleLimit = Number(section.dataset.bundleLimit || 3);
      const bundleTwoPrice = Number(section.dataset.bundleTwoPrice || 0);
      const bundleThreePrice = Number(section.dataset.bundleThreePrice || 0);
      const currencyCode = section.dataset.currencyCode || 'USD';

      const cards = Array.from(section.querySelectorAll('[data-product-card]'));
      const selectedList = section.querySelector('[data-selected-list]');
      const regularTotalEl = section.querySelector('[data-regular-total]');
      const bundleDiscountEl = section.querySelector('[data-bundle-discount]');
      const bundleTotalEl = section.querySelector('[data-bundle-total]');
      const savingsEl = section.querySelector('[data-bundle-savings]');
      const submitButton = section.querySelector('[data-bundle-submit]');
      const progressText = section.querySelector('[data-progress-text]');
      const progressSteps = Array.from(section.querySelectorAll('[data-progress-step]'));
      const bundleStatus = section.querySelector('[data-bundle-status]');

      const modal = section.querySelector('[data-variant-modal]');
      const modalTitle = section.querySelector('[data-modal-product-title]');
      const modalOptions = section.querySelector('[data-modal-options]');
      const modalSubmit = section.querySelector('[data-modal-submit]');
      const modalCloseButtons = Array.from(section.querySelectorAll('[data-modal-close]'));

      const selectedItems = [];
      let modalContext = null;
      let pendingVariant = null;
      let modalVariants = [];
      let modalOptionNames = [];
      let modalSelection = {};
      let lastCompletedCount = 0;

      const moneyFormatter = new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency: currencyCode
      });

      const formatMoney = (cents) => moneyFormatter.format((cents || 0) / 100);

      const getSwatchColor = (title) => {
        const normalized = String(title || '').toLowerCase();
        const colorMap = {
          black: '#111111',
          white: '#f8fafc',
          red: '#dc2626',
          blue: '#2563eb',
          navy: '#1e3a8a',
          green: '#16a34a',
          yellow: '#facc15',
          pink: '#ec4899',
          purple: '#7c3aed',
          orange: '#ea580c',
          grey: '#9ca3af',
          gray: '#9ca3af',
          silver: '#cbd5e1',
          gold: '#d4a017',
          beige: '#d6c4a1',
          brown: '#8b5e3c',
          tan: '#c19a6b'
        };

        const directKey = Object.keys(colorMap).find((key) => normalized.includes(key));
        if (directKey) return colorMap[directKey];

        let hash = 0;
        for (let i = 0; i < normalized.length; i += 1) {
          hash = normalized.charCodeAt(i) + ((hash << 5) - hash);
        }
        return 'hsl(' + (Math.abs(hash) % 360) + ', 55%, 72%)';
      };

      const getVariantDisplayTitle = (variant) => {
        const parts = [variant.option1, variant.option2, variant.option3].filter(Boolean);
        if (parts.length) return parts.join(' / ');
        return variant.title || 'Default';
      };

      const matchesSelection = (variant, selection) => {
        return [1, 2, 3].every((index) => {
          const key = 'option' + index;
          if (!selection[key]) return true;
          return variant[key] === selection[key];
        });
      };

      const findVariantFromSelection = () => {
        return modalVariants.find((variant) => variant.available && matchesSelection(variant, modalSelection))
          || modalVariants.find((variant) => matchesSelection(variant, modalSelection))
          || null;
      };

      const getAvailableValuesForIndex = (optionIndex) => {
        const key = 'option' + optionIndex;
        const values = [];

        modalVariants.forEach((variant) => {
          const partialSelection = { ...modalSelection };
          delete partialSelection[key];

          if (matchesSelection(variant, partialSelection) && !values.includes(variant[key])) {
            values.push(variant[key]);
          }
        });

        return values.filter(Boolean);
      };

      const syncModalSelectionUi = () => {
        Array.from(modalOptions.querySelectorAll('[data-option-index]')).forEach((button) => {
          const optionIndex = button.dataset.optionIndex;
          const optionValue = button.dataset.optionValue;
          const key = 'option' + optionIndex;
          const availableValues = getAvailableValuesForIndex(Number(optionIndex));
          const isAvailable = availableValues.includes(optionValue);
          const isSelected = modalSelection[key] === optionValue;

          button.classList.toggle('is-selected', isSelected);
          button.disabled = !isAvailable;
        });

        const selectedVariant = findVariantFromSelection();
        pendingVariant = selectedVariant;

        if (selectedVariant) {
          section.querySelector('[data-modal-variant-summary]')?.replaceChildren(document.createTextNode(getVariantDisplayTitle(selectedVariant)));
          section.querySelector('[data-modal-variant-stock]')?.replaceChildren(document.createTextNode(selectedVariant.available ? 'Available' : 'Sold out'));
          modalSubmit.disabled = !selectedVariant.available;
        } else {
          section.querySelector('[data-modal-variant-summary]')?.replaceChildren(document.createTextNode('Select options'));
          section.querySelector('[data-modal-variant-stock]')?.replaceChildren(document.createTextNode('Unavailable combination'));
          modalSubmit.disabled = true;
        }
      };

      const renderModalOptionGroups = () => {
        modalOptions.innerHTML = `
          <p class="bundle-collection__variant-summary" data-modal-variant-summary></p>
          <p class="bundle-collection__variant-stock" data-modal-variant-stock></p>
        `;

        modalOptionNames.forEach((name, index) => {
          const optionIndex = index + 1;
          const values = [];

          modalVariants.forEach((variant) => {
            const value = variant['option' + optionIndex];
            if (value && !values.includes(value)) values.push(value);
          });

          if (!values.length) return;

          const isColorGroup = String(name || '').toLowerCase().includes('color');
          const groupMarkup = `
            <div class="bundle-collection__option-group">
              <p class="bundle-collection__option-title">${name}</p>
              <div class="bundle-collection__option-values">
                ${values.map((value) => `
                  <button
                    type="button"
                    class="bundle-collection__variant-chip ${isColorGroup ? 'bundle-collection__variant-chip--color' : ''}"
                    data-option-index="${optionIndex}"
                    data-option-value="${String(value).replace(/"/g, '&quot;')}"
                    aria-label="${value}"
                    title="${value}"
                  >
                    ${isColorGroup
                      ? `<span class="bundle-collection__variant-swatch" style="--swatch-color: ${getSwatchColor(value)};"></span>`
                      : `${value}`
                    }
                  </button>
                `).join('')}
              </div>
            </div>
          `;

          modalOptions.insertAdjacentHTML('beforeend', groupMarkup);
        });

        syncModalSelectionUi();
      };

      const getBundlePrice = () => {
        if (selectedItems.length === 2) return bundleTwoPrice;
        if (selectedItems.length === 3) return bundleThreePrice;
        return 0;
      };

      const isMobileViewport = () => window.matchMedia('(max-width: 749px)').matches;

      const scrollToBundleSummary = () => {
        const summaryCard = section.querySelector('.bundle-collection__summary-card');
        if (!summaryCard) return;
        summaryCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };

      const findSelectedIndex = (productId) => selectedItems.findIndex((item) => item.productId === productId);

      const syncCards = () => {
        cards.forEach((card) => {
          const productId = Number(card.dataset.productId);
          const index = findSelectedIndex(productId);
          const toggle = card.querySelector('[data-card-toggle]');
          const hasVariants = card.dataset.hasMultipleVariants === 'true';

          card.classList.toggle('is-selected', index !== -1);
          toggle.setAttribute('aria-pressed', index !== -1 ? 'true' : 'false');

          if (index !== -1) {
            toggle.textContent = 'Remove';
          } else if (hasVariants) {
            toggle.textContent = 'Choose options';
          } else {
            toggle.textContent = 'Add to bundle';
          }
        });
      };

      const renderSelected = () => {
        if (!selectedItems.length) {
          selectedList.innerHTML = '<div class="bundle-collection__selected-empty">Your selected products will appear here.</div>';
          return;
        }

        selectedList.innerHTML = selectedItems.map((item) => `
          <div class="bundle-collection__selected-item">
            <div class="bundle-collection__selected-main">
              ${item.image ? `<img class="bundle-collection__selected-thumb" src="${item.image}" alt="${item.productTitle}">` : '<div class="bundle-collection__selected-thumb"></div>'}
              <div class="bundle-collection__selected-copy">
                <strong>${item.productTitle}</strong>
                <p>${item.variantTitle}</p>
              </div>
            </div>
            <div class="bundle-collection__selected-side">
              <strong>${formatMoney(item.price)}</strong>
              <button type="button" class="bundle-collection__selected-remove" data-remove-product="${item.productId}">Remove</button>
            </div>
          </div>
        `).join('');
      };

      const updateSummary = () => {
        const regularTotal = selectedItems.reduce((sum, item) => sum + item.price, 0);
        const bundlePrice = getBundlePrice();
        const savings = bundlePrice > 0 ? Math.max(regularTotal - bundlePrice, 0) : 0;
        const discountValue = bundlePrice > 0 ? savings : 0;

        regularTotalEl.textContent = formatMoney(regularTotal);
        bundleDiscountEl.textContent = '-' + formatMoney(discountValue);
        bundleTotalEl.textContent = formatMoney(bundlePrice);
        savingsEl.textContent = formatMoney(savings);

        progressSteps.forEach((step, index) => {
          step.classList.toggle('is-active', index < selectedItems.length);
        });

        if (selectedItems.length < 2) {
          progressText.textContent = 'Choose ' + (2 - selectedItems.length) + ' more product' + (selectedItems.length === 1 ? '' : 's') + ' to unlock your first bundle price.';
          bundleStatus.textContent = '2-product bundle: ' + formatMoney(bundleTwoPrice) + ' | 3-product bundle: ' + formatMoney(bundleThreePrice);
        } else if (selectedItems.length === 2) {
          progressText.textContent = '2-product bundle selected.';
          bundleStatus.textContent = 'Bundle active: 2 products for ' + formatMoney(bundleTwoPrice);
        } else {
          progressText.textContent = '3-product bundle selected.';
          bundleStatus.textContent = 'Bundle active: 3 products for ' + formatMoney(bundleThreePrice);
        }

        submitButton.disabled = !(selectedItems.length === 2 || selectedItems.length === 3);

        const completedCount = selectedItems.length === 2 || selectedItems.length === 3 ? selectedItems.length : 0;
        if (isMobileViewport() && completedCount > 0 && completedCount !== lastCompletedCount) {
          window.setTimeout(scrollToBundleSummary, 80);
        }
        lastCompletedCount = completedCount;
      };

      const commitSelection = (item) => {
        const index = findSelectedIndex(item.productId);

        if (index !== -1) {
          selectedItems.splice(index, 1);
        } else {
          if (selectedItems.length >= bundleLimit) return;
          selectedItems.push(item);
        }

        syncCards();
        renderSelected();
        updateSummary();
      };

      const openModal = (card) => {
        const variantsJson = card.querySelector('[data-product-variants]');
        const optionsJson = card.querySelector('[data-product-options]');
        if (!variantsJson) return;

        modalContext = card;
        pendingVariant = null;
        modalTitle.textContent = card.dataset.productTitle || '';

        let variants = [];
        try {
          variants = JSON.parse(variantsJson.textContent);
        } catch (error) {
          variants = [];
        }

        let optionNames = [];
        try {
          optionNames = JSON.parse(optionsJson.textContent);
        } catch (error) {
          optionNames = [];
        }

        modalVariants = variants;
        modalOptionNames = optionNames;

        const firstAvailable = modalVariants.find((variant) => variant.available) || modalVariants[0] || null;
        modalSelection = {};

        if (firstAvailable) {
          modalSelection.option1 = firstAvailable.option1 || '';
          modalSelection.option2 = firstAvailable.option2 || '';
          modalSelection.option3 = firstAvailable.option3 || '';
        }

        renderModalOptionGroups();

        modal.hidden = false;
        document.body.classList.add('overflow-hidden');
      };

      const closeModal = () => {
        modal.hidden = true;
        modalOptions.innerHTML = '';
        modalSubmit.disabled = true;
        modalContext = null;
        pendingVariant = null;
        modalVariants = [];
        modalOptionNames = [];
        modalSelection = {};
        document.body.classList.remove('overflow-hidden');
      };

      cards.forEach((card) => {
        const toggle = card.querySelector('[data-card-toggle]');
        if (!toggle) return;

        toggle.addEventListener('click', () => {
          const productId = Number(card.dataset.productId);
          const selectedIndex = findSelectedIndex(productId);

          if (selectedIndex !== -1) {
            selectedItems.splice(selectedIndex, 1);
            syncCards();
            renderSelected();
            updateSummary();
            return;
          }

          if (selectedItems.length >= bundleLimit) {
            progressText.textContent = 'You can only add up to 3 products in this bundle.';
            return;
          }

          if (card.dataset.hasMultipleVariants === 'true') {
            openModal(card);
            return;
          }

          commitSelection({
            productId,
            productTitle: card.dataset.productTitle,
            image: card.dataset.productImage,
            variantId: Number(card.dataset.defaultVariantId),
            variantTitle: card.dataset.defaultVariantTitle,
            price: Number(card.dataset.defaultPrice || 0)
          });
        });
      });

      modalOptions.addEventListener('click', (event) => {
        const option = event.target.closest('[data-option-index]');
        if (!option || option.disabled) return;

        const optionIndex = option.dataset.optionIndex;
        const optionValue = option.dataset.optionValue;
        modalSelection['option' + optionIndex] = optionValue;
        syncModalSelectionUi();
      });

      modalSubmit.addEventListener('click', () => {
        if (!modalContext || !pendingVariant) return;

        commitSelection({
          productId: Number(modalContext.dataset.productId),
          productTitle: modalContext.dataset.productTitle,
          image: modalContext.dataset.productImage,
          variantId: pendingVariant.id,
          variantTitle: getVariantDisplayTitle(pendingVariant),
          price: pendingVariant.price
        });

        closeModal();
      });

      modalCloseButtons.forEach((button) => {
        button.addEventListener('click', closeModal);
      });

      selectedList.addEventListener('click', (event) => {
        const removeButton = event.target.closest('[data-remove-product]');
        if (!removeButton) return;

        const productId = Number(removeButton.dataset.removeProduct);
        const selectedIndex = findSelectedIndex(productId);
        if (selectedIndex === -1) return;

        selectedItems.splice(selectedIndex, 1);
        syncCards();
        renderSelected();
        updateSummary();
      });

      submitButton.addEventListener('click', async () => {
        if (!(selectedItems.length === 2 || selectedItems.length === 3)) return;

        submitButton.disabled = true;
        submitButton.textContent = 'Adding bundle...';

        try {
          const response = await fetch(window.Shopify?.routes?.root ? window.Shopify.routes.root + 'cart/add.js' : '/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              items: selectedItems.map((item) => ({
                id: item.variantId,
                quantity: 1,
                properties: {
                  '_bundle_offer': selectedItems.length === 3 ? '3 products' : '2 products',
                  '_bundle_price_target': formatMoney(getBundlePrice())
                }
              }))
            })
          });

          if (!response.ok) throw new Error('Bundle add failed');

          window.location.href = '/cart';
        } catch (error) {
          submitButton.disabled = false;
          submitButton.textContent = 'Add bundle to cart';
          progressText.textContent = 'Something went wrong while adding the bundle. Please try again.';
        }
      });

      updateSummary();
      syncCards();
    })();
  </script>
</section>

