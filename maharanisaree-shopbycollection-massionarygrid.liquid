{% liquid
  assign section_title = section.settings.heading
%}

<section class="ms-discover-section ms-discover-section--{{ section.id }}">
  <div class="ms-discover-shell page-width">
    {% if section_title != blank %}
      {% comment %} <div class="ms-discover-header">
        <h2 class="ms-discover-title">{{ section_title }}</h2>
      </div> {% endcomment %}


      <div class="wrap_title  des_title_5 sub_title_size_32 lazyloaded">
		<h3 class="section-title tc pr flex fl_center al_center fs__24 title_5 lazyloaded"><span class="mr__10 ml__10">{{ section_title }}</span></h3>
		</div>
    {% endif %}

    <div class="ms-discover-grid">
      {% for block in section.blocks limit: 4 %}
        {% liquid
          assign block_collection = block.settings.collection
          assign block_title = block.settings.custom_title
          assign block_link = block.settings.link

          if block_title == blank and block_collection != blank
            assign block_title = block_collection.title
          endif

          if block_link == blank and block_collection != blank
            assign block_link = block_collection.url
          endif
        %}

        <a
          class="ms-discover-card ms-discover-card--{{ forloop.index }}{% if block_link == blank %} ms-discover-card--disabled{% endif %}"
          {% if block_link != blank %}
            href="{{ block_link }}"
          {% else %}
            aria-disabled="true"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="ms-discover-media">
            {% if block.settings.desktop_image != blank %}
              {{
                block.settings.desktop_image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  class: 'ms-discover-image ms-discover-image--desktop',
                  alt: block_title,
                  widths: '400, 700, 900, 1200, 1400'
              }}
            {% endif %}

            {% if block.settings.mobile_image != blank %}
              {{
                block.settings.mobile_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  class: 'ms-discover-image ms-discover-image--mobile',
                  alt: block_title,
                  widths: '300, 500, 700, 900'
              }}
            {% elsif block.settings.desktop_image != blank %}
              {{
                block.settings.desktop_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  class: 'ms-discover-image ms-discover-image--mobile',
                  alt: block_title,
                  widths: '300, 500, 700, 900'
              }}
            {% endif %}
          </div>

          <div class="ms-discover-overlay">
            {% if block_title != blank %}
              <h3 class="ms-discover-card-title">{{ block_title }}</h3>
            {% endif %}

            <span class="ms-discover-button">Shop Now</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
    .ms-discover-section--{{ section.id }} {
      background: #ffffff;
      padding: 28px 0 44px;
    }

    .ms-discover-section--{{ section.id }} .page-width {
      max-width: 1520px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .ms-discover-section--{{ section.id }} .ms-discover-header {
      text-align: center;
      margin-bottom: 18px;
    }

    .ms-discover-section--{{ section.id }} .ms-discover-title {
      margin: 0;
      color: #0d0d0d;
      font-size: clamp(28px, 3vw, 48px);
      line-height: 1;
      font-weight: 500;
      font-family: "Times New Roman", serif;
      letter-spacing: 0.02em;
    }

    .ms-discover-section--{{ section.id }} .ms-discover-grid {
      display: grid;
      grid-template-columns: 1fr 1.4fr 1fr;
      grid-template-rows: minmax(245px, 1fr) minmax(245px, 1fr);
      gap: 24px;
    }

    .ms-discover-section--{{ section.id }} .ms-discover-card {
      position: relative;
      display: block;
      overflow: hidden;
      border-radius: 14px;
      min-height: 300px;
      background: #d9d0c6;
      text-decoration: none;
      color: inherit;
    }

    .ms-discover-section--{{ section.id }} .ms-discover-card--disabled {
      pointer-events: none;
    }

    .ms-discover-section--{{ section.id }} .ms-discover-card--1,
    .ms-discover-section--{{ section.id }} .ms-discover-card--3 {
      grid-row: span 2;
      min-height: 640px;
    }

    .ms-discover-section--{{ section.id }} .ms-discover-media,
    .ms-discover-section--{{ section.id }} .ms-discover-image {
      width: 100%;
      height: 100%;
    }

    .ms-discover-section--{{ section.id }} .ms-discover-media {
      position: absolute;
      inset: 0;
    }

    .ms-discover-section--{{ section.id }} .ms-discover-image {
      display: block;
      object-fit: cover;
    }

    .ms-discover-section--{{ section.id }} .ms-discover-image--mobile {
      display: none;
    }

    .ms-discover-section--{{ section.id }} .ms-discover-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.02) 22%, rgba(0, 0, 0, 0.28) 100%);
      pointer-events: none;
    }

    .ms-discover-section--{{ section.id }} .ms-discover-overlay {
      position: absolute;
      inset: auto 20px 18px;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .ms-discover-section--{{ section.id }} .ms-discover-card-title {
      margin: 0;
      color: #ffffff;
      text-align: center;
      font-size: clamp(20px, 2.8vw, 32px);
      line-height: 1.1;
      font-weight: 500;
      font-family: "Times New Roman", serif;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.28);
    }

    .ms-discover-section--{{ section.id }} .ms-discover-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 116px;
      min-height: 40px;
      padding: 9px 20px;
      border-radius: 999px;
      background: #ffffff;
      color: #111111;
      font-size: 15px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.01em;
      text-transform: uppercase;
      opacity:0 !important;
    }

    @media screen and (max-width: 989px) {
      .ms-discover-section--{{ section.id }} {
        padding: 20px 0 28px;
      }

      .ms-discover-section--{{ section.id }} .page-width {
        padding: 0 14px;
      }

      .ms-discover-section--{{ section.id }} .ms-discover-header {
        margin-bottom: 14px;
      }

      .ms-discover-section--{{ section.id }} .ms-discover-title {
        font-size: 30px;
      }

      .ms-discover-section--{{ section.id }} .ms-discover-grid {
        {% comment %} grid-template-columns: 1fr 1fr; {% endcomment %}
        {% comment %} grid-template-rows: 60px 190px 86px 190px; {% endcomment %}
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: max-content; 
        gap: 12px;
        grid-auto-flow: dense;
        padding-top: 10px;
      }

      .ms-discover-section--{{ section.id }} .ms-discover-card {
        min-height: auto;
        border-radius: 12px;
      }

      .ms-discover-section--{{ section.id }} .ms-discover-card--1 {
        grid-column: 1;
        grid-row: 1 / span 2;
        min-height: 262px;
      }

      .ms-discover-section--{{ section.id }} .ms-discover-card--2 {
        grid-column: 2;
        grid-row: 1;
        min-height: 118px;
      }

      .ms-discover-section--{{ section.id }} .ms-discover-card--3 {
        {% comment %} grid-column: 2;
        grid-row: 2 / span 2;
        min-height: 322px;
       {% endcomment %}
      grid-column: 2;
          grid-row: revert-rule;
          min-height: 281px;
  }

      .ms-discover-section--{{ section.id }} .ms-discover-card--4 {
        grid-column: 1;
        grid-row: 3;
        min-height: 118px;
      }

      .ms-discover-section--{{ section.id }} .ms-discover-image--desktop {
        display: none;
      }

      .ms-discover-section--{{ section.id }} .ms-discover-image--mobile {
        display: block;
      }

      .ms-discover-section--{{ section.id }} .ms-discover-overlay {
        inset: auto 12px 10px;
        gap: 8px;
      }

      .ms-discover-section--{{ section.id }} .ms-discover-card-title {
        font-size: 18px;
      }

      .ms-discover-section--{{ section.id }} .ms-discover-button {
        min-width: 78px;
        min-height: 24px;
        padding: 5px 12px;
        font-size: 8px;
      }
    }
</style>

{% schema %}
{
  "name": "Maharani Saree Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Discover"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Grid card",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title",
          "info": "If empty, the selected collection title will be used."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "If empty, the selected collection link will be used."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Maharani Saree Grid",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
