{% liquid
  assign free_discount_goal = free_discount_goal | default: 80000
  assign progress_percent = 0
%}

<div
  class="charmacy-shipping-bar"
  data-free-discount-goal="{{ free_discount_goal }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <p class="charmacy-shipping-bar__message" data-shipping-message>
    Add items to unlock your free discount.
  </p>

  <div class="charmacy-shipping-bar__progress-wrap">
    <div
      class="charmacy-shipping-bar__track"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ progress_percent }}"
      aria-label="Free discount progress"
    >
      <div class="charmacy-shipping-bar__fill" data-shipping-fill style="width: {{ progress_percent }}%;"></div>
    </div>

    <div class="charmacy-shipping-bar__icon" data-shipping-icon aria-hidden="true">
      <svg viewBox="0 0 32 32" focusable="false">
        <path d="M6 9.5h12.5c.8 0 1.5.7 1.5 1.5v9.5c0 .8-.7 1.5-1.5 1.5H8.8a3.3 3.3 0 0 0-5.6 0H3c-.8 0-1.5-.7-1.5-1.5v-7.8c0-.5.2-.9.5-1.2l2.8-2.8c.3-.3.7-.5 1.2-.5Zm14 4h4.3c.5 0 .9.2 1.2.6l2.6 3.1c.2.3.4.7.4 1.1v2.2c0 .8-.7 1.5-1.5 1.5h-.4a3.3 3.3 0 0 0-6.1 0H20V13.5Zm-13.5 9a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6Zm17.2 0a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6ZM6.6 11 4.4 13.2h3.1c.4 0 .8-.4.8-.8V11H6.6Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
      </svg>
    </div>
  </div>
</div>

<style>
  .charmacy-shipping-bar {
    --shipping-bar-color: #9C2D41;
    --shipping-bar-track: #f6e6ea;
    --shipping-bar-text: #9C2D41;
    width: 100%;
    padding: 10px 0 4px;
    border-radius: 14px;
    background: transparent;
    box-sizing: border-box;
  }

  .charmacy-shipping-bar.is-hidden {
    display: none;
  }

  .charmacy-shipping-bar__message {
    margin: 0 0 10px;
    color: var(--shipping-bar-text);
    font-size: 14px;
    line-height: 1.45;
    font-weight: 600;
    text-align: center;
  }

  .charmacy-shipping-bar__message strong {
    color: var(--shipping-bar-color);
  }

  .charmacy-shipping-bar__progress-wrap {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 40px;
  }

  .charmacy-shipping-bar__track {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 10px;
    border-radius: 999px;
    background: var(--shipping-bar-track);
  }

  .charmacy-shipping-bar__fill {
    height: 100%;
    width: 0;
    border-radius: 999px;
    background-color: var(--shipping-bar-color);
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.12) 0,
      rgba(255, 255, 255, 0.12) 10px,
      rgba(255, 255, 255, 0.3) 10px,
      rgba(255, 255, 255, 0.3) 20px
    );
    transition: width 0.35s ease;
  }

  .charmacy-shipping-bar__icon {
    position: absolute;
    top: 50%;
    left: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--shipping-bar-color);
    color: #ffffff;
    transform: translate(-50%, -50%);
    box-shadow: 0 4px 10px rgba(156, 45, 65, 0.2);
    transition: left 0.35s ease;
    z-index: 2;
  }

  .charmacy-shipping-bar__icon svg {
    width: 19px;
    height: 19px;
    display: block;
  }
</style>

<script>
  (function () {
    const shippingBar = document.querySelector(".charmacy-shipping-bar");
    const STORAGE_KEY = "charmacyShippingBarCart";

    if (!shippingBar) return;

    const fill = shippingBar.querySelector("[data-shipping-fill]");
    const message = shippingBar.querySelector("[data-shipping-message]");
    const icon = shippingBar.querySelector("[data-shipping-icon]");
    const progressBar = shippingBar.querySelector(".charmacy-shipping-bar__track");
    const goalCents = Number(shippingBar.dataset.freeDiscountGoal || 0);
    const moneyFormat = shippingBar.dataset.moneyFormat || "";

    function formatMoney(cents, currency) {
      if (window.Shopify && typeof window.Shopify.formatMoney === "function" && moneyFormat) {
        return window.Shopify.formatMoney(cents, moneyFormat);
      }

      return new Intl.NumberFormat("en-IN", {
        style: "currency",
        currency: currency || "INR",
        maximumFractionDigits: 2
      }).format((cents || 0) / 100);
    }

    function saveCartState(cart) {
      try {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
          total_price: cart?.total_price || 0,
          item_count: cart?.item_count || 0,
          currency: cart?.currency || "INR"
        }));
      } catch (error) {
        console.error("Shipping bar sessionStorage save failed:", error);
      }
    }

    function readCartState() {
      try {
        const storedCart = sessionStorage.getItem(STORAGE_KEY);

        return storedCart ? JSON.parse(storedCart) : null;
      } catch (error) {
        console.error("Shipping bar sessionStorage read failed:", error);
        return null;
      }
    }

    function updateIconPosition(progress) {
      if (!progressBar || !icon) return;

      const trackWidth = progressBar.clientWidth;
      const fillWidth = (progress / 100) * trackWidth;
      const iconWidth = icon.offsetWidth || 34;
      const minLeft = iconWidth / 2;
      const maxLeft = trackWidth - iconWidth / 2;
      const targetLeft = Math.min(Math.max(fillWidth, minLeft), maxLeft);

      icon.style.left = targetLeft + "px";
    }

    function updateBar(cartTotalPriceCents, currency) {
      if (!goalCents || !fill || !message) return;

      if (cartTotalPriceCents <= 0) {
        shippingBar.classList.add("is-hidden");
        fill.style.width = "0%";
        updateIconPosition(0);
        return;
      }

      shippingBar.classList.remove("is-hidden");

      const remainingCents = Math.max(goalCents - cartTotalPriceCents, 0);
      const progress = Math.min((cartTotalPriceCents / goalCents) * 100, 100);

      fill.style.width = progress + "%";

      if (progressBar) {
        progressBar.setAttribute("aria-valuenow", String(Math.round(progress)));
      }

      updateIconPosition(progress);

      if (remainingCents > 0) {
        message.innerHTML = "Spend <strong>" + formatMoney(remainingCents, currency) + "</strong> more to get your free shipping.";
      } else {
        message.innerHTML = "You unlocked free shipping!";
      }
    }

    function renderFromCart(cart) {
      const cartTotalPriceCents = cart?.total_price || 0;
      const currency = cart?.currency || "INR";

      updateBar(cartTotalPriceCents, currency);
    }

    async function onCartUpdate() {
      try {
        const res = await fetch("/cart.js", {
          headers: { Accept: "application/json" }
        });

        const cart = await res.json();
        const cartTotalPriceCents = cart?.total_price || 0;
        const cartTotalQty = cart?.item_count || 0;
        const currency = cart?.currency || "INR";

        console.log("cart", cart);
        console.log("cart item count", cartTotalQty);

        saveCartState(cart);
        renderFromCart(cart);
      } catch (err) {
        console.error("Cart update failed:", err);
      }
    }

    const storedCart = readCartState();

    if (storedCart) {
      renderFromCart(storedCart);
    } else {
      shippingBar.classList.add("is-hidden");
      updateIconPosition(0);
    }

    const triggerCartUpdate = () => onCartUpdate();

    onCartUpdate();
    window.addEventListener("resize", () => {
      const latestCart = readCartState();

      if (latestCart) {
        renderFromCart(latestCart);
      }
    });

    document.addEventListener("cart:updated", triggerCartUpdate);

    if (!window.__shippingBarPatched) {
      window.__shippingBarPatched = true;

      const originalFetch = window.fetch;

      window.fetch = async (...args) => {
        const response = await originalFetch(...args);

        try {
          const url = typeof args[0] === "string"
            ? args[0]
            : args[0]?.url || "";

          if (/\/cart\/(add|change|update)/.test(url)) {
            triggerCartUpdate();
          }
        } catch (e) {}

        return response;
      };

      const originalOpen = XMLHttpRequest.prototype.open;

      XMLHttpRequest.prototype.open = function (...args) {
        this.addEventListener("load", () => {
          const url = typeof args[1] === "string" ? args[1] : "";

          if (/\/cart\/(add|change|update)/.test(url)) {
            triggerCartUpdate();
          }
        });

        return originalOpen.apply(this, args);
      };
    }
  })();
</script>
