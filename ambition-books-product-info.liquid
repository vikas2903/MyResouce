<style>
  .cart-deal-banner-wrap,
  .cart-deal-banner-wrap * {
    box-sizing: border-box;
  }

  .cart-deal-banner-wrap {
    width: 100%;
    padding: 16px 20px;
    font-family: Arial, sans-serif;
  }

  .cart-deal-banner {
    display: block;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    padding: 16px 12px;
    border-radius: 14px;
    background: linear-gradient(180deg, #ffb11a 0%, #ffa500 38%, #ff8c00 100%);
    color: #ffffff;
    text-align: center;
    text-decoration: none;
    /* box-shadow:
      0 0 20px rgba(255, 165, 0, 0.5),
      0 0 42px rgba(255, 165, 0, 0.46),
      0 0 68px rgba(255, 140, 0, 0.32),
      0 12px 28px rgba(255, 140, 0, 0.3); */
    animation: cartDealFloat 2.2s ease-in-out infinite, cartDealGlow 1.9s ease-in-out infinite alternate;
  }

  .cart-deal-banner::before {
    content: "";
    position: absolute;
    inset: -12px;
    border-radius: 18px;
    background: rgba(255, 165, 0, 0.42);
    filter: blur(18px);
    z-index: -1;
    animation: cartDealHalo 2s ease-in-out infinite alternate;
  }

  .cart-deal-banner::after {
    content: "";
    position: absolute;
    top: 0;
    left: -32%;
    width: 28%;
    height: 100%;
    border-radius: inherit;
    /* background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0)); */
    transform: skewX(-20deg);
    pointer-events: none;
    animation: cartDealSweep 2.8s ease-in-out infinite;
  }

  .cart-deal-banner__text {
    position: relative;
    z-index: 1;
    display: inline-block;
    font-size: clamp(22px, 3.2vw, 28px);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-shadow:
      0 2px 0 rgba(180, 78, 0, 0.18),
      0 0 16px rgba(255, 255, 255, 0.14);
  }

  .cart-deal-banner__subtext {
    position: relative;
    z-index: 1;
    display: block;
    margin-top: 8px;
    font-size: clamp(12px, 1.4vw, 14px);
    line-height: 1.35;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.94);
    letter-spacing: 0.01em;
  }

  .cart-deal-banner__price {
    display: inline-block;
    margin: 0 2px;
    padding: 1px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    /* box-shadow: 0 0 18px rgba(255, 255, 255, 0.18); */
    animation: cartDealPricePop 1.25s ease-in-out infinite;
  }

  @keyframes cartDealFloat {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-2px);
    }
  }

  /* @keyframes cartDealGlow {
    0% {
      box-shadow:
        0 0 16px rgba(255, 165, 0, 0.4),
        0 0 30px rgba(255, 165, 0, 0.32),
        0 0 52px rgba(255, 140, 0, 0.22),
        0 12px 28px rgba(255, 140, 0, 0.24);
    }

    100% {
      box-shadow:
        0 0 24px rgba(255, 165, 0, 0.62),
        0 0 50px rgba(255, 165, 0, 0.5),
        0 0 82px rgba(255, 140, 0, 0.38),
        0 14px 34px rgba(255, 140, 0, 0.34);
    }
  } */

  @keyframes cartDealHalo {
    0% {
      inset: -8px;
      opacity: 0.72;
      filter: blur(16px);
    }

    100% {
      inset: -14px;
      opacity: 1;
      filter: blur(24px);
    }
  }

  @keyframes cartDealSweep {
    0% {
      left: -32%;
      opacity: 0;
    }

    18% {
      opacity: 0.85;
    }

    45% {
      left: 104%;
      opacity: 0;
    }

    100% {
      left: 104%;
      opacity: 0;
    }
  }

  @keyframes cartDealPricePop {
    0%,
    100% {
      transform: scale(1);
      /* box-shadow: 0 0 14px rgba(255, 255, 255, 0.16); */
    }

    50% {
      transform: scale(1.08);
      /* box-shadow: 0 0 24px rgba(255, 255, 255, 0.26); */
    }
  }

  @media (max-width: 767px) {
    .cart-deal-banner-wrap {
      padding: 12px;
    }

    .cart-deal-banner {
      padding: 18px 14px;
      border-radius: 12px;
    }

    .cart-deal-banner__text {
      font-size: 18px;
    }

    .cart-deal-banner__subtext {
      margin-top: 6px;
      font-size: 11px;
    }
  }
</style>

<div class="cart-deal-banner-wrap">
  <a class="cart-deal-banner" href="javascript:void(0);" aria-label="Go to cart now and unlock 399 deal">
    <span class="cart-deal-banner__text">Go to Cart Drawer - Unlock <span class="cart-deal-banner__price">&#8377;399</span> Deal! &#128293;</span>
    <span class="cart-deal-banner__subtext">T&amp;C: Offer will be applicable on 1+ product.</span>
  </a>
</div>
