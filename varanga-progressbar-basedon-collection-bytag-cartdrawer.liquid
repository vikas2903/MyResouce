{% comment %} 
<div class="msg-slider"> 
  {% if cart.item_count == 1 or cart.item_count == 2 %}
    {% if cart.item_count == 1 %}
        <div class="msg">Yay! You’ve availed 5% off</div>
    {% elsif cart.item_count == 2 %}
         <div class="msg">ADD 1 MORE TO UNLOCK THE OFFER</div>
    {% endif %}
    <div class="msg">BUY 2 GET 1 FREE</div>
  {% elsif cart.item_count >= 3 and cart.item_count <= 6 %}
    <div class="msg">BUY 3 GET 2 FREE</div>
     {% if cart.item_count == 3 %}
        <div class="msg">ADD 2 MORE TO UNLOCK THE OFFER</div>
    {% elsif cart.item_count == 4 %}
         <div class="msg">ADD 1 MORE TO UNLOCK THE OFFER</div>
    {% elsif cart.item_count >= 5 %}
         <div class="msg">CONGRATULATIONS 🎉🎉</div>
    {% endif %}
  {% endif %}
</div>

<style>
.msg-slider {
  position: relative;
  width: 100%;
  padding: 15px 10px;
  overflow: hidden;
  margin: 0 auto;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #222;
  color: #fff;
}

/* All messages stacked */
.msg-slider .msg {
  position: absolute;
  width: 100%;
  text-align: center;
  font-size: 16px;
  opacity: 0;
  animation: fadeSlide 6s infinite;

  @media(max-width: 768px){
    font-size: 13px;
  }
}

/* Each message starts at different time */
.msg-slider .msg:nth-child(1) {
  animation-delay: 0s;
}

.msg-slider .msg:nth-child(2) {
  animation-delay: 3s;
}

/* Keyframes for fade in/out */
@keyframes fadeSlide {
  0% { opacity: 0; }
  10% { opacity: 1; }   /* fade in */
  40% { opacity: 1; }   /* stay visible */
  50% { opacity: 0; }   /* fade out */
  100% { opacity: 0; }
}

</style>
 {% endcomment %}

