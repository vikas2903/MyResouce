{% endif %}

{%- comment -%} Tag-based Buy 2 offers {%- endcomment -%}
{%- assign lucky_1299_count = 0 -%}
{%- assign lucky_1999_count = 0 -%}
{%- for item in cart.items -%}
  {%- if item.product.tags contains 'Lucky1299' -%}
    {%- assign lucky_1299_count = lucky_1299_count | plus: item.quantity -%}
  {%- endif -%}
  {%- if item.product.tags contains 'Lucky1999' -%}
    {%- assign lucky_1999_count = lucky_1999_count | plus: item.quantity -%}
  {%- endif -%}
{%- endfor -%}

<div class="lucky-offers-root" data-lucky-1299-count="{{ lucky_1299_count }}" data-lucky-1999-count="{{ lucky_1999_count }}"></div>

<style>
  .lucky-offer-progress { margin: 0 10px 18px; text-align: center; }
  .lucky-offer-progress__title { color: var(--brand-gold-dark, #9f7b42); font-size: 15px; font-weight: 700; margin: 0 0 4px; }
  .lucky-offer-progress__message { color: var(--brand-text-muted, #7f6740); font-size: 13px; font-weight: 500; margin: 0; }
  .lucky-offer-progress__track { background: rgba(198,165,107,.18); border-radius: 999px; height: 6px; margin-top: 12px; position: relative; }
  .lucky-offer-progress__fill { background: linear-gradient(90deg, #9f7b42, #c6a56b, #dec490); border-radius: 999px; height: 6px; transition: width .4s ease; }
  .lucky-offer-progress__step { align-items: center; background: #fff; border: 1px solid rgba(198,165,107,.35); border-radius: 50%; box-shadow: 0 2px 6px rgba(159,123,66,.12); color: #9f7b42; display: flex; font-size: 12px; font-weight: 700; height: 28px; justify-content: center; position: absolute; top: -11px; width: 28px; }
  .lucky-offer-progress__step--one { left: 50%; transform: translateX(-50%); }
  .lucky-offer-progress__step--two { right: 0; }
  .lucky-offer-progress__step.is-complete { background: #c6a56b; border-color: #9f7b42; color: #fff; }
</style>

<script>
  (function () {
    const offers = [
      { tag: 'Lucky1299', price: '₹1,299' },
      { tag: 'Lucky1999', price: '₹1,999' }
    ];
    const productTags = new Map();

    function offerMarkup(offer, quantity) {
      if (!quantity) return '';
      const unlocked = quantity >= 2;
      const progress = unlocked ? 100 : 50;
      const message = unlocked
        ? `Congratulations! Buy 2 at ${offer.price} is unlocked.`
        : `Add 1 more eligible product to unlock Buy 2 at ${offer.price}.`;

      return `<div class="lucky-offer-progress">
        <p class="lucky-offer-progress__title">Buy 2 at ${offer.price}</p>
        <p class="lucky-offer-progress__message">${message}</p>
        <div class="lucky-offer-progress__track">
          <div class="lucky-offer-progress__fill" style="width:${progress}%"></div>
          <span class="lucky-offer-progress__step lucky-offer-progress__step--one is-complete">1</span>
          <span class="lucky-offer-progress__step lucky-offer-progress__step--two ${unlocked ? 'is-complete' : ''}">2</span>
        </div>
      </div>`;
    }

    async function getProductTags(handle) {
      if (!handle) return [];
      if (productTags.has(handle)) return productTags.get(handle);
      try {
        const response = await fetch(`/products/${encodeURIComponent(handle)}.js`);
        const product = await response.json();
        const tags = Array.isArray(product.tags) ? product.tags : String(product.tags || '').split(',').map(tag => tag.trim());
        productTags.set(handle, tags);
        return tags;
      } catch (error) {
        return [];
      }
    }

    async function refreshLuckyOffers() {
      const root = document.querySelector('.lucky-offers-root');
      if (!root) return;
      const initialCounts = {
        Lucky1299: Number(root.dataset.lucky1299Count || 0),
        Lucky1999: Number(root.dataset.lucky1999Count || 0)
      };
      root.innerHTML = offers.map(offer => offerMarkup(offer, initialCounts[offer.tag])).join('');
      try {
        const response = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
        const cart = await response.json();
        const counts = { Lucky1299: 0, Lucky1999: 0 };

        await Promise.all(cart.items.map(async item => {
          const tags = await getProductTags(item.handle);
          offers.forEach(offer => {
            if (tags.includes(offer.tag)) counts[offer.tag] += item.quantity;
          });
        }));

        root.innerHTML = offers.map(offer => offerMarkup(offer, counts[offer.tag])).join('');
      } catch (error) {
        // Keep the Liquid-rendered values visible if the cart refresh fails.
      }
    }

    const triggerCartUpdate = () => setTimeout(refreshLuckyOffers, 150);

    // Watch every Shopify cart API request so the progress bars update even
    // when the cart drawer is updated by an app or custom theme script.
    if (!window.__luckyOfferProgressPatched) {
      window.__luckyOfferProgressPatched = true;
      document.addEventListener('cart:updated', triggerCartUpdate);
      document.addEventListener('cart:change', triggerCartUpdate);

      const originalFetch = window.fetch;
      window.fetch = async (...args) => {
        const response = await originalFetch(...args);
        try {
          const url = typeof args[0] === 'string' ? args[0] : (args[0] && args[0].url) || '';
          if (/\/cart\/(add|change|update)(?:\.js)?(?:[/?]|$)/i.test(url)) triggerCartUpdate();
        } catch (error) {}
        return response;
      };

      const originalOpen = XMLHttpRequest.prototype.open;
      XMLHttpRequest.prototype.open = function (...args) {
        this.addEventListener('load', () => {
          const url = typeof args[1] === 'string' ? args[1] : '';
          if (/\/cart\/(add|change|update)(?:\.js)?(?:[/?]|$)/i.test(url)) triggerCartUpdate();
        });
        return originalOpen.apply(this, args);
      };
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', refreshLuckyOffers);
    } else {
      refreshLuckyOffers();
    }
  })();
</script>
