  <style>
  :root {
    --brand-gold: #c6a56b;
    --brand-gold-dark: #9f7b42;
    --brand-gold-light: #f4ecdf;
    --brand-gold-soft: #e8d5b2;
    --brand-text-muted: #7f6740;
  }

  div#cart-progress-container1 {
    text-align: center;
    align-content: center;
    align-items: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: sticky;
    z-index: 1;
    top: 4px;
    border-radius: 0;

    margin: 0px 10px 18px;
    gap: 0px;
  }

  #cart-progress-bar1 {
    display: block !important;
    position: relative;
    height: 6px;
    border-radius: 999px;
    transition: width 0.4s ease;
    background: linear-gradient(
      90deg,
      var(--brand-gold-dark),
      var(--brand-gold),
      #dec490
    );
    box-shadow: 0 2px 8px rgba(159, 123, 66, 0.18);
  }

  .pro-wrap {
    height: 6px;
    width: 100%;
    background: linear-gradient(
      90deg,
      rgba(198, 165, 107, 0.18),
      rgba(198, 165, 107, 0.1)
    );
    border: 0;
    border-radius: 999px;
    position: relative;
    overflow: visible;
    margin-top: 12px;
  }

  span.step-1,
  span.step-2,
  span.step-3 {
    position: absolute;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    top: -11px;
    background: #ffffff;
    padding: 5px;
    border: 1px solid rgba(198, 165, 107, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 2px 6px rgba(159, 123, 66, 0.12);
  }

  span.step-1 {
    left: 33%;
    transform: translateX(-50%);
  }

  span.step-2 {
    left: 66%;
    transform: translateX(-50%);
  }

  span.step-3 {
    right: 0;
  }

  span.step-1 svg,
  span.step-2 svg,
  span.step-3 svg {
    width: 100%;
    height: 100%;
    stroke: var(--brand-gold-dark);
  }

  .step-complete {
    background: var(--brand-gold) !important;
    border-color: var(--brand-gold-dark) !important;
    box-shadow: 0 4px 10px rgba(159, 123, 66, 0.24) !important;
  }

  .step-complete svg {
    stroke: #ffffff !important;
  }

  .progress-offer-title {
    font-size: 15px;
    font-weight: 700;
    margin: 0;
    color: var(--brand-gold-dark);
    text-align: center;
    line-height: 1.2;
    padding-bottom:4px;
  }

  p#progress-messagee1 {
    text-align: center;
    display: block;
    width: 100%;
    font-size: 13px;
    font-weight: 500;
    color: var(--brand-text-muted);
    letter-spacing: 0;
    margin: 0;
    line-height: 1.4;
    text-transform: none;
  }

  @media (max-width: 768px) {
    div#cart-progress-container1 {
      gap: 0px;
    }

    .pro-wrap {
      height: 6px;
      margin-top: 10px;
    }

    #cart-progress-bar1 {
      height: 6px;
    }

    span.step-1,
    span.step-2,
    span.step-3 {
      width: 28px;
      height: 28px;
      top: -11px;
      padding: 5px;
    }

    .progress-offer-title {
      font-size: 14px;
    }

    p#progress-messagee1 {
      font-size: 12px;
      letter-spacing: 0;
      margin: 0;
    }
  }
</style>

{% if false %}

  {%- assign target_items = 3 -%}
  {%- assign remaining_items = target_items | minus: cart.item_count -%}
  {%- assign step1_filled = false -%}
  {%- assign step2_filled = false -%}
  {%- assign step3_filled = false -%}
  {%- assign progress_width = 0 -%}
  {%- assign progress_message = '' -%}

  {%- if cart.item_count >= 1 -%}
    {%- assign step1_filled = true -%}
  {%- endif -%}

  {%- if cart.item_count >= 2 -%}
    {%- assign step2_filled = true -%}
  {%- endif -%}

  {%- if cart.item_count >= 3 -%}
    {%- assign step3_filled = true -%}
  {%- endif -%}

  {%- if cart.item_count >= target_items -%}
    {%- assign progress_width = 100 -%}
    {%- assign progress_message = 'Congratulations! Your Buy 2 Get 1 offer is unlocked.' -%}
  {%- elsif cart.item_count == 2 -%}
    {%- assign progress_width = 66 -%}
    {%- assign progress_message = 'Add 1 more item to get 1 free.' -%}
  {%- elsif cart.item_count == 1 -%}
    {%- assign progress_width = 33 -%}
    {%- assign progress_message = 'Add 2 more items to unlock your free item.' -%}
  {%- else -%}
    {%- assign progress_width = 0 -%}
    {%- assign progress_message = 'Add 3 items to activate the Buy 2 Get 1 offer.' -%}
  {%- endif -%}

