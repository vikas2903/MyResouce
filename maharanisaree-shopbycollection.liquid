{% liquid
  assign section_title = section.settings.heading
%}

<section class="ir-royalty-section ir-royalty-section--{{ section.id }}">
  <div class="ir-royalty-shell page-width">
    {% if section_title != blank %}
      {% comment %} <div class="ir-royalty-header">
        <h2 class="ir-royalty-title">{{ section_title }}</h2>
      </div> {% endcomment %}

      <div class="wrap_title  des_title_5 sub_title_size_32 lazyloaded">
		<h3 class="section-title tc pr flex fl_center al_center fs__24 title_5 lazyloaded"><span class="mr__10 ml__10">{{section_title }}</span></h3>
		</div>
    {% endif %}

    <div class="ir-royalty-grid">
      {% for block in section.blocks %}
        {% liquid
          assign block_collection = block.settings.collection
          assign block_title = block.settings.custom_title
          assign block_link = block.settings.link

          if block_title == blank and block_collection != blank
            assign block_title = block_collection.title
          endif

          if block_link == blank and block_collection != blank
            assign block_link = block_collection.url
          endif
        %}

        <a
          class="ir-royalty-card"
          {% if block_link != blank %}
            href="{{ block_link }}"
          {% else %}
            aria-disabled="true"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="ir-royalty-media">
            {% if block.settings.desktop_image != blank %}
              {{
                block.settings.desktop_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  class: 'ir-royalty-image ir-royalty-image--desktop',
                  alt: block_title,
                  widths: '300, 500, 700, 900'
              }}
            {% endif %}

            {% if block.settings.mobile_image != blank %}
              {{
                block.settings.mobile_image
                | image_url: width: 700
                | image_tag:
                  loading: 'lazy',
                  class: 'ir-royalty-image ir-royalty-image--mobile',
                  alt: block_title,
                  widths: '240, 360, 500, 700'
              }}
            {% elsif block.settings.desktop_image != blank %}
              {{
                block.settings.desktop_image
                | image_url: width: 700
                | image_tag:
                  loading: 'lazy',
                  class: 'ir-royalty-image ir-royalty-image--mobile',
                  alt: block_title,
                  widths: '240, 360, 500, 700'
              }}
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .ir-royalty-section--{{ section.id }} {
    padding: 22px 0 34px;
    background: #ffffff;
  }

  .ir-royalty-section--{{ section.id }} .page-width {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 15px;
  }

  .ir-royalty-section--{{ section.id }} .ir-royalty-header {
    margin-bottom: 20px;
    text-align: center;
  }

  .ir-royalty-section--{{ section.id }} .ir-royalty-title {
    margin: 0;
    color: #111111;
    font-size: clamp(28px, 2.7vw, 44px);
    line-height: 1.1;
    font-weight: 500;
    font-family: "Times New Roman", serif;
  }

  .ir-royalty-section--{{ section.id }} .ir-royalty-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }

  .ir-royalty-section--{{ section.id }} .ir-royalty-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ir-royalty-section--{{ section.id }} .ir-royalty-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 0.72;
    border-radius: 10px;
    background: #d8c7bb;
  }

  .ir-royalty-section--{{ section.id }} .ir-royalty-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ir-royalty-section--{{ section.id }} .ir-royalty-image--mobile {
    display: none;
  }

  .ir-royalty-section--{{ section.id }} .ir-royalty-media::after {
    content: none;
  }

  @media screen and (max-width: 749px) {
    .ir-royalty-section--{{ section.id }} {
      padding: 18px 0 26px;
    }

    .ir-royalty-section--{{ section.id }} .page-width {
      padding: 0 12px;
    }

    .ir-royalty-section--{{ section.id }} .ir-royalty-header {
      margin-bottom: 14px;
    }

    .ir-royalty-section--{{ section.id }} .ir-royalty-title {
      font-size: 30px;
    }

    .ir-royalty-section--{{ section.id }} .ir-royalty-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .ir-royalty-section--{{ section.id }} .ir-royalty-media {
      border-radius: 8px;
    }

    .ir-royalty-section--{{ section.id }} .ir-royalty-image--desktop {
      display: none;
    }

    .ir-royalty-section--{{ section.id }} .ir-royalty-image--mobile {
      display: block;
    }

  }
</style>

{% schema %}
{
  "name": " Shop By Collection",
  "settings": [ 
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title",
          "info": "If empty, selected collection title will be used."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "If empty, selected collection URL will be used."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": " Shop By Collection",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
