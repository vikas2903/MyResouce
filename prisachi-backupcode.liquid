    </svg>
  </span>
  1 Lakh+ Happy Customers | 6 Lakh+ Followers
</p>

<div class="ai-sticky-atc-sheet-{{ ai_gen_id }}" data-sheet>
  <div class="ai-sticky-atc-sheet-header-{{ ai_gen_id }}">
    <h3 class="ai-sticky-atc-sheet-title-{{ ai_gen_id }}">{{ block.settings.sheet_title }}</h3>
    <button
      type="button"
      class="ai-sticky-atc-sheet-close-{{ ai_gen_id }}"
      data-close
      aria-label="Close"
    >
      ×
    </button>
  </div>

  <div class="ai-sticky-atc-sheet-content-{{ ai_gen_id }}">
    {% if product.has_only_default_variant %}
      <p style="text-align: center; color: {{ block.settings.sheet_text_color }};">
        This product has no variants to select.
      </p>
    {% else %}
      {% for option in product.options_with_values %}
        <div class="ai-sticky-atc-variant-group-{{ ai_gen_id }}">
          <label class="ai-sticky-atc-variant-label-{{ ai_gen_id }}">
            {{ option.name }}
          </label>
          <div class="ai-sticky-atc-variant-options-{{ ai_gen_id }}" data-option-index="{{ forloop.index0 }}">
            {% for value in option.values %}
              <button
                type="button"
                class="ai-sticky-atc-variant-option-{{ ai_gen_id }}"
                data-option-value="{{ value | escape }}"
                data-option-position="{{ option.position }}"
              >
                {{ value }}
              </button>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    {% endif %}

    <div class="ai-sticky-atc-error-{{ ai_gen_id }}" data-error style="display: none;"></div>
  </div>

  <div class="ai-sticky-atc-sheet-actions-{{ ai_gen_id }}">
    <button
      type="button"
      class="ai-sticky-atc-sheet-btn-{{ ai_gen_id }} ai-sticky-atc-sheet-btn-cart-{{ ai_gen_id }}"
      data-sheet-action="add-to-cart"
      {% if product.has_only_default_variant %}
        disabled
      {% endif %}
    >
      {{ block.settings.add_to_cart_text }}
    </button>

    <div class="shiprocket-headless stkrextra" data-type="product"></div>
    {% comment %}
      <button
        type="button"
        id="buybutton_custom"
        class="button button--primary"
        data-action="buy-now"
        data-sheet-action="buy-now"
      >
        Buy Now
        <span class="sr-powered-by"
          ><img src="https://fastrr-boost-ui.pickrr.com/assets/images/boost_button/powered_by.svg " alt=""
        ></span>
      </button>
    {% endcomment %}
  </div>
</div>

<script>
  (function() {

    const buyNowBtn = document.getElementById('buybutton_custom');

    class StickyAddToCart{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.productData = {{ product | json }};
        this.selectedOptions = {};
        this.currentAction = null;
      }

      connectedCallback() {
        this.overlay = document.querySelector('.ai-sticky-atc-overlay-{{ ai_gen_id }}');
        this.sheet = document.querySelector('.ai-sticky-atc-sheet-{{ ai_gen_id }}');
        this.errorElement = this.sheet.querySelector('[data-error]');

        this.setupEventListeners();
        this.initializeSelectedOptions();
        this.updateVariantAvailability();
        this.handleScroll();
        window.addEventListener('scroll', () => this.handleScroll());
      }

      setupEventListeners() {
        this.querySelectorAll('[data-action]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            this.currentAction = e.target.dataset.action;
            this.openSheet();
          });
        });

        this.overlay.addEventListener('click', () => this.closeSheet());
        this.sheet.querySelector('[data-close]').addEventListener('click', () => this.closeSheet());

        this.sheet.querySelectorAll('.ai-sticky-atc-variant-option-{{ ai_gen_id }}').forEach(option => {
          option.addEventListener('click', (e) => this.handleOptionClick(e));
        });

        this.sheet.querySelectorAll('[data-sheet-action]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const action = e.target.dataset.sheetAction;
            this.handleSheetAction(action);
          });
        });
      }

      initializeSelectedOptions() {
        if (this.productData.has_only_default_variant) {
          return;
        }

        this.productData.options.forEach((option, index) => {
          const firstValue = this.productData.options_with_values[index].values[0];
          this.selectedOptions[option] = firstValue;
        });

        this.updateSelectedUI();
      }

      handleOptionClick(e) {
        const button = e.target;
        if (button.classList.contains('disabled')) return;

        const optionPosition = parseInt(button.dataset.optionPosition);
        const optionName = this.productData.options[optionPosition - 1];
        const optionValue = button.dataset.optionValue;

        this.selectedOptions[optionName] = optionValue;
        this.updateSelectedUI();
        this.updateVariantAvailability();
        this.clearError();
      }

      updateSelectedUI() {
        this.sheet.querySelectorAll('.ai-sticky-atc-variant-option-{{ ai_gen_id }}').forEach(option => {
          const optionPosition = parseInt(option.dataset.optionPosition);
          const optionName = this.productData.options[optionPosition - 1];
          const optionValue = option.dataset.optionValue;

          if (this.selectedOptions[optionName] === optionValue) {
            option.classList.add('selected');
          } else {
            option.classList.remove('selected');
          }
        });
      }

      updateVariantAvailability() {
        const selectedVariant = this.getSelectedVariant();

        this.sheet.querySelectorAll('.ai-sticky-atc-variant-option-{{ ai_gen_id }}').forEach(option => {
          const optionPosition = parseInt(option.dataset.optionPosition);
          const optionName = this.productData.options[optionPosition - 1];
          const optionValue = option.dataset.optionValue;

          const testOptions = { ...this.selectedOptions, [optionName]: optionValue };
          const variant = this.findVariantByOptions(testOptions);

          if (!variant || !variant.available) {
            option.classList.add('disabled');
          } else {
            option.classList.remove('disabled');
          }
        });

        const addToCartBtns = this.sheet.querySelectorAll('[data-sheet-action]');
        addToCartBtns.forEach(btn => {
          if (selectedVariant && selectedVariant.available) {
            btn.disabled = false;
          } else {
            btn.disabled = true;
          }
        });
      }

      getSelectedVariant() {
        return this.findVariantByOptions(this.selectedOptions);
      }

      findVariantByOptions(options) {
        return this.productData.variants.find(variant => {
          return this.productData.options.every((option, index) => {
            return variant.options[index] === options[option];
          });
        });
      }

      async handleSheetAction(action) {
        const variant = this.getSelectedVariant();

        if (!variant) {
          this.showError('Please select all options');
          return;
        }

        if (!variant.available) {
          this.showError('This variant is out of stock');
          return;
        }

        if (action === 'add-to-cart') {
          await this.addToCart(variant.id);
        } else if (action === 'buy-now') {
          await this.buyNow(variant.id);
        }
      }

      async addToCart(variantId) {
        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: 1
            })
          });

          if (response.ok) {
            this.closeSheet();

            setTimeout(() => {
                if (window.CartDrawerPremium?.open) {
                  window.CartDrawerPremium.open();
                }
              }, 800);


          } else {
            this.showError('Failed to add to cart');
          }
        } catch (error) {
          this.showError('An error occurred');
        }
      }

      async buyNow(variantId) {
        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: 1
            })
          });

          if (response.ok) {

         const buyNowBtn = document.getElementById('buybutton_custom');

          } else {
            {% comment %} this.showError('Failed to proceed to checkout'); {% endcomment %}
          }
        } catch (error) {
          this.showError('An error occurred');
        }
      }

      openSheet() {
        this.overlay.classList.add('active');
        this.sheet.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closeSheet() {
        this.overlay.classList.remove('active');
        this.sheet.classList.remove('active');
        document.body.style.overflow = '';
        this.clearError();
      }

      showError(message) {
        this.errorElement.textContent = message;
        this.errorElement.style.display = 'block';
      }

      clearError() {
        this.errorElement.textContent = '';
        this.errorElement.style.display = 'none';
      }

      handleScroll() {
        const scrollPosition = window.scrollY;
        if (scrollPosition > 300) {
          this.classList.remove('hidden');
        } else {
          this.classList.add('hidden');
        }
      }
    }

    customElements.define('sticky-add-to-cart-{{ ai_gen_id }}', StickyAddToCart{{ ai_gen_id }});



  })();
</script>

