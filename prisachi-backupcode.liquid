<div class="ai-sticky-atc-overlay-{{ ai_gen_id }}" data-overlay></div>
<p class="Stickycart_top_info">
  <span>
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M16 11C17.66 11 19 9.66 19 8C19 6.34 17.66 5 16 5C14.34 5 13 6.34 13 8C13 9.66 14.34 11 16 11Z" stroke="#000" stroke-width="1.5"/>
      <path d="M8 11C9.66 11 11 9.66 11 8C11 6.34 9.66 5 8 5C6.34 5 5 6.34 5 8C5 9.66 6.34 11 8 11Z" stroke="#000" stroke-width="1.5"/>
      <path d="M2 19C2 16.79 4.69 15 8 15C11.31 15 14 16.79 14 19" stroke="#000" stroke-width="1.5"/>
