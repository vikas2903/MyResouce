      </span>
      <span class="vs-whatsapp-enquiry__text">Enquire on WhatsApp</span>
    </a>

    <script type="application/json" class="vs-whatsapp-enquiry__variants">
      [
        {% for variant in product.variants %}
          {
            "id": {{ variant.id | json }},
            "title": {{ variant.title | json }},
            "sku": {{ variant.sku | default: product.handle | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>
  </div>

  <style>
    .vs-whatsapp-enquiry {
      width: 100%;
    }

    .vs-whatsapp-enquiry__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      min-height: 52px;
      padding: 14px 20px;
      border-radius: 10px;
      background: #111111;
      color: #ffffff;
      text-decoration: none;
      font-size: 15px;
      font-weight: 600;
      letter-spacing: 0.01em;
      border: 1px solid #111111;
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, color 0.2s ease;
    }

    .vs-whatsapp-enquiry__button:hover {
      background: #1f1f1f;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);
      transform: translateY(-1px);
    }

    .vs-whatsapp-enquiry__icon {
      display: inline-flex;
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .vs-whatsapp-enquiry__icon svg {
      width: 100%;
      height: 100%;
    }

    @media (max-width: 749px) {
      .vs-whatsapp-enquiry__button {
        min-height: 48px;
        padding: 12px 16px;
        font-size: 14px;
      }
    }
  </style>

  <script>
    (function () {
      var container = document.getElementById('{{ enquiry_block_id }}');
      if (!container) return;

      var button = container.querySelector('.vs-whatsapp-enquiry__button');
      var variantsNode = container.querySelector('.vs-whatsapp-enquiry__variants');
      if (!button || !variantsNode) return;

      var number = container.dataset.whatsappNumber;
      var productTitle = container.dataset.productTitle || '';
      var productUrl = container.dataset.productUrl || window.location.href;
      var initialVariantId = String(container.dataset.initialVariantId || '');
      var variants = [];

      try {
        variants = JSON.parse(variantsNode.textContent);
      } catch (error) {
        variants = [];
      }

      var variantMap = {};
      variants.forEach(function (variant) {
        variantMap[String(variant.id)] = variant;
      });

      function buildMessage(variant) {
        var variantTitle = variant && variant.title && variant.title !== 'Default Title' ? variant.title : 'Default';
        var sku = variant && variant.sku ? variant.sku : 'N/A';

        return [
          'Hello Prisachi Team, I would like to enquire about this product.',
          '',
          'Product: ' + productTitle,
          'Variant: ' + variantTitle,
          'SKU: ' + sku,
          'Product URL: ' + productUrl
        ].join('\n');
      }

      function updateButton(variantId) {
        var activeVariant = variantMap[String(variantId)] || variantMap[initialVariantId] || variants[0] || null;
        var message = buildMessage(activeVariant);
        button.href = 'https://wa.me/' + number + '?text=' + encodeURIComponent(message);
      }

      function getSelectedVariantId() {
        var productForm = container.closest('product-info, .product, .product__info-wrapper, section') || document;
        var variantInput = productForm.querySelector('form[action*="/cart/add"] [name="id"]');
        return variantInput && variantInput.value ? String(variantInput.value) : initialVariantId;
      }

      document.addEventListener('change', function (event) {
        var target = event.target;
        if (!target) return;
        if (target.name === 'id') {
          updateButton(target.value);
        }
      });

      document.addEventListener('variant:change', function (event) {
        if (event.detail && event.detail.variant && event.detail.variant.id) {
          updateButton(event.detail.variant.id);
        }
      });

      updateButton(getSelectedVariantId());
    })();
  </script>
{% endif %}
