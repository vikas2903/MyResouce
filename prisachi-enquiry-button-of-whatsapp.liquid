{% if product %}
  {% assign initial_variant = product.selected_or_first_available_variant %}
  {% assign whatsapp_number = '919971146242' %}
  {% assign product_url = shop.url | append: product.url %}
  {% if section.id %}
    {% assign enquiry_block_id = 'vs-whatsapp-enquiry-' | append: section.id %}
  {% else %}
    {% assign enquiry_block_id = 'vs-whatsapp-enquiry-' | append: product.id %}
  {% endif %}

  <div
    id="{{ enquiry_block_id }}"
    class="vs-whatsapp-enquiry"
    data-whatsapp-number="{{ whatsapp_number }}"
    data-product-title="{{ product.title | escape }}"
    data-product-url="{{ product_url | escape }}"
    data-initial-variant-id="{{ initial_variant.id }}"
  >
    <a
      class="vs-whatsapp-enquiry__button"
      href="https://wa.me/{{ whatsapp_number }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Enquire on WhatsApp about {{ product.title | escape }}"
    >
      <span class="vs-whatsapp-enquiry__icon" aria-hidden="true">


   <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="40px" height="40px" viewBox="0 0 48 48" version="1.1">
    
